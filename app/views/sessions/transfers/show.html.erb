<% if @transfer_ready %>
  <%= auto_submit_form_with url: session_transfer_path, method: :put %>
<% else %>
  <section class="panel center txt-align-center flex flex-column gap">
    <h1 class="txt-x-large margin-none">Transfer your session</h1>
    <p>The private code is exchanged in this browser and removed before sign-in.</p>
    <%= render "shared/credential_fragment_exchange", url: session_transfer_intent_path, label: "Transfer code" %>
  </section>
<% end %>
