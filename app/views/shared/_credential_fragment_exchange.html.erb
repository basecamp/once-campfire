<div data-controller="credential-fragment" class="flex flex-column gap">
  <p data-credential-fragment-target="status">Preparing the private link...</p>
  <%= form_with url:, data: { credential_fragment_target: "form" }, class: "flex flex-column gap" do |form| %>
    <%= form.label :token, label, class: "for-screen-reader" %>
    <%= form.password_field :token, name: :token, autocomplete: "off", required: true,
          class: "input", placeholder: label, data: { credential_fragment_target: "token" } %>
    <%= form.submit "Continue", class: "btn btn--reversed center" %>
  <% end %>
</div>
