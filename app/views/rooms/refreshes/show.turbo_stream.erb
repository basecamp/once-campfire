<% if @new_messages.any? %>
  <%= turbo_stream_action_tag :append, target: dom_id(@room, :messages), incomplete: (true if @more_messages),
        template: render(partial: "messages/message", formats: :html, collection: @new_messages, cached: ->(message) { message_fragment_cache_key(message) }) %>
<% end %>

<% @updated_messages.each do |message| %>
  <%= turbo_stream.replace dom_id(message), partial: "messages/message", locals: { message: message } %>
<% end %>
