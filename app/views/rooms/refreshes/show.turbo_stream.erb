<%= turbo_stream.append dom_id(@room, :messages) do %>
  <% message_runs(@new_messages).each do |run| %>
    <% fragment_cached = message_run_fragment_cached?(run) %>
    <%= render partial: "messages/message", collection: run, cached: (->(message) { message_fragment_cache_key(message) } if fragment_cached), locals: { fragment_cached: fragment_cached } %>
  <% end %>
<% end if @new_messages.any? %>

<% @updated_messages.each do |message| %>
  <%= turbo_stream.replace dom_id(message), partial: "messages/message", locals: { message: message } %>
<% end %>
