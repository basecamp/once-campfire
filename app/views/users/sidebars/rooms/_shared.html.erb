<% project_background = local_assigns[:project_background] || room_project_background(room) %>
<%= link_to_room room,
      id: dom_id(room, :list), data: { sorted_list_name: room.name },
      style: [ "--column-gap: 0.5em", ("--room-project-bg: #{project_background}" if project_background) ].compact.join("; "),
      class: [ "align-center gap room btn txt-nowrap", ("room--project" if project_background), "unread": local_assigns[:unread] ] do %>
  <span class="overflow-ellipsis"><%= room.name %></span>
<% end %>
