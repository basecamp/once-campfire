#!/bin/bash
set -euo pipefail

env="${RAILS_ENV:-production}"
db_names=("$env.sqlite3" "${env}_queue.sqlite3")
app_root="${APP_ROOT:-/rails}"

queue_db="$app_root/storage/db/${env}_queue.sqlite3"
queue_snapshot="$app_root/storage/backups/${env}_queue.sqlite3"
paused_volume_marker="$app_root/storage/backups/.once-paused-volume-backup"

# ONCE archives the live SQLite files only after pausing the container when
# pre-backup fails. Preserve each database together with its WAL sidecars.
if [ -f "$paused_volume_marker" ]; then
  rm -f "$app_root/storage/db/$env.sqlite3-shm" "$queue_db-shm"
  rm -f "$paused_volume_marker"
  exit 0
fi

if [ ! -f "$queue_snapshot" ] && [ -f "$queue_db" ]; then
  echo "Queue database snapshot missing; refusing to restore over an existing queue database." >&2
  exit 1
fi

for db_name in "${db_names[@]}"; do
  snapshot="$app_root/storage/backups/$db_name"
  db="$app_root/storage/db/$db_name"

  if [ -f "$snapshot" ]; then
    mkdir -p "$(dirname "$db")"
    cp "$snapshot" "$db"
    rm -f "$db-wal" "$db-shm"
  fi
done
