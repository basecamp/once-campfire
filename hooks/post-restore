#!/bin/bash
set -euo pipefail

for db_name in "${RAILS_ENV:-production}.sqlite3" "${RAILS_ENV:-production}_queue.sqlite3"; do
  snapshot="/rails/storage/backups/$db_name"
  db="/rails/storage/db/$db_name"

  if [ -f "$snapshot" ]; then
    mkdir -p "$(dirname "$db")"
    cp "$snapshot" "$db"
    rm -f "$db-wal" "$db-shm"
  fi
done

cache_db="/rails/storage/db/${RAILS_ENV:-production}_cache.sqlite3"
rm -f "$cache_db" "$cache_db-wal" "$cache_db-shm"
