#!/usr/bin/env ruby

require_relative "../../config/boot"
require "base64"
require "digest"
require "json"
require "pathname"
require "sqlite3"
require File.expand_path("../../lib/campfire_backup/authentication", __dir__)
require File.expand_path("../../lib/campfire_backup/descriptor_tree", __dir__)
require File.expand_path("../../lib/campfire_backup/installation_identity", __dir__)
require File.expand_path("../../lib/campfire_backup/operation_lock", __dir__)
require File.expand_path("../../lib/campfire_backup/recovery_markers", __dir__)
require File.expand_path("../../lib/campfire_backup/redis_validator", __dir__)
require File.expand_path("../../lib/campfire_backup/schema_verifier", __dir__)
load File.expand_path("verify-backup", __dir__) unless defined?(BackupVerifier)

class BackupInstaller
  IMAGE_UID = 1000
  IMAGE_GID = 1000

  class << self
    def install(generation_path:, storage_directory:, expected_installation_fingerprint:,
        expected_environment:, authentication_key: CampfireBackup::Authentication.key_from_env,
        owner_uid: ENV["RESTORE_UID"], owner_gid: ENV["RESTORE_GID"],
        runtime_uid: IMAGE_UID, runtime_gid: IMAGE_GID, fault_after: nil)
      installed = false
      operation_lock = nil
      owned_paths = nil
      destination_tree = nil
      source_tree = nil
      storage_directory = Pathname(storage_directory).expand_path
      generation_path = Pathname(generation_path).realpath
      source_tree = CampfireBackup::DescriptorTree.new(
        generation_path, description: "Backup generation"
      )
      raise "Restore destination cannot be a symbolic link" if storage_directory.symlink?
      operation_lock = CampfireBackup::OperationLock.acquire(
        storage_directory, purpose: "restore", shared: true, create_parent: false
      )
      storage_directory = operation_lock.directory
      destination_tree = CampfireBackup::DescriptorTree.new(
        storage_directory, expected_identity: operation_lock.target_identity,
        description: "Restore destination"
      )
      owned_paths = CampfireBackup::OwnedPaths.new(
        storage_directory, descriptor_tree: destination_tree
      )
      operation_lock.assert_current!
      destination_tree.assert_root_current!
      CampfireBackup::RecoveryMarkers.assert_restore_complete!(
        storage_directory, descriptor_tree: destination_tree
      )
      owner_uid, owner_gid, isolate_runtime = runtime_ownership!(
        owner_uid, owner_gid, runtime_uid, runtime_gid, expected_environment
      )
      existing_entries = storage_entries(storage_directory, operation_lock, destination_tree)
      if existing_entries.any? && !image_skeleton?(storage_directory, destination_tree)
        entries = existing_entries.map { _1.basename.to_s }.sort.join(", ")
        raise "Restore destination must be empty; found #{entries}. " \
          "No files were changed. Remove and recreate this disposable destination, then retry: #{storage_directory}"
      end

      BackupVerifier.verify(
        generation_path:, expected_installation_fingerprint:, expected_environment:,
        authentication_key:, output: false, descriptor_tree: source_tree
      )
      manifest = read_authenticated_manifest!(source_tree, authentication_key)
      operation_lock.assert_current!
      claim_restore_destination!(
        storage_directory, operation_lock, destination_tree, isolate_runtime:
      )
      existing_entries = storage_entries(storage_directory, operation_lock, destination_tree)
      if existing_entries.any? && !image_skeleton?(storage_directory, destination_tree)
        raise "Restore destination changed concurrently before it was claimed"
      end
      operation_lock.assert_current!
      restore_marker = CampfireBackup::RecoveryMarkers.begin_restore!(
        storage_directory, backup_id: manifest.fetch("backup_id"),
        operation_id: operation_lock.operation_id, descriptor_tree: destination_tree
      )
      fault_after&.call("marked")
      operation_lock.assert_current!
      remove_image_skeleton! storage_directory, destination_tree
      existing_entries = storage_entries(storage_directory, operation_lock, destination_tree)
      if existing_entries.any?
        entries = existing_entries.map { _1.basename.to_s }.sort.join(", ")
        raise "Restore destination must be empty; found #{entries}. " \
          "No files were changed. Remove and recreate this disposable destination, then retry: #{storage_directory}"
      end
      fault_after&.call("claimed")
      operation_lock.assert_current!
      install_files source_tree, storage_directory, manifest, owned_paths, operation_lock,
        destination_tree, fault_after: fault_after
      fault_after&.call("installed")
      apply_runtime_ownership! storage_directory, operation_lock, owned_paths, restore_marker,
        owner_uid, owner_gid, destination_tree
      fault_after&.call("owned")
      fault_after&.call("synced")
      operation_lock.assert_current!
      installed_inventory = verify_installed!(
        storage_directory, manifest, expected_installation_fingerprint, destination_tree
      )
      verify_runtime_access!(
        storage_directory, runtime_uid, runtime_gid, expected_inventory: installed_inventory,
        descriptor_tree: destination_tree, isolate_runtime:
      )
      operation_lock.assert_current!
      fault_after&.call("verified")
      assert_storage_inventory_current!(
        storage_directory, installed_inventory, descriptor_tree: destination_tree
      )
      operation_lock.assert_current!
      destination_tree.assert_root_current!

      result = JSON.generate(
        status: "installed", backup_id: manifest.fetch("backup_id"), path: storage_directory.to_s
      )
      commit_restore!(
        storage_directory, operation_lock, destination_tree, restore_marker,
        installed_inventory, owner_uid, owner_gid, isolate_runtime:, fault_after:
      )
      installed = true
      fault_after&.call("committed")

      begin
        puts result
      rescue Errno::EPIPE, IOError
        nil
      end
      true
    ensure
      active_error = $!
      cleanup_errors = []
      if owned_paths && !installed
        begin
          incomplete = owned_paths.cleanup
          if incomplete.any?
            warn "Restore cleanup was incomplete. Remove and recreate this disposable destination before retrying: #{storage_directory}"
          end
        rescue StandardError => error
          cleanup_errors << error
        end
      end
      [ destination_tree, source_tree ].compact.each do |tree|
        begin
          tree.close
        rescue StandardError => error
          cleanup_errors << error
        end
      end
      begin
        operation_lock&.release
      rescue StandardError => error
        cleanup_errors << error
      end
      if cleanup_errors.any?
        cleanup_errors.each { warn "Restore cleanup error: #{_1.message}" }
        raise cleanup_errors.first unless active_error || installed
      end
    end

    private
      def remove_image_skeleton!(storage_directory, descriptor_tree)
        return unless image_skeleton?(storage_directory, descriptor_tree)

        placeholder = storage_directory.join(".keep")
        unless descriptor_tree.entry_missing?(".keep")
          identity = nil
          descriptor_tree.open_regular_file(".keep") do |_file, stat|
            identity = metadata_identity(stat)
          end
          descriptor_tree.remove(".keep", expected_identity: identity, directory: false)
        end
        %w[ db files ].each do |relative|
          next if descriptor_tree.entry_missing?(relative)

          identity = nil
          descriptor_tree.open_directory(relative) do |_directory, stat|
            identity = metadata_identity(stat)
          end
          descriptor_tree.remove(relative, expected_identity: identity, directory: true)
        end
        flush_directory descriptor_tree.root
      end

      def image_skeleton?(storage_directory, descriptor_tree = nil)
        allowed = [
          ".keep", "db", "files", CampfireBackup::OperationLock::SHARED_FILENAME,
          CampfireBackup::RecoveryMarkers::RESTORE_FILENAME
        ]
        children = descriptor_tree ? descriptor_tree.children : storage_directory.children.map { _1.basename.to_s }
        return false unless children.all? { allowed.include?(_1) }

        placeholder = storage_directory.join(".keep")
        if descriptor_tree
          unless descriptor_tree.entry_missing?(".keep")
            valid = false
            descriptor_tree.open_regular_file(".keep") { |_file, stat| valid = stat.size.zero? }
            return false unless valid
          end
          %w[ db files ].all? do |relative|
            descriptor_tree.entry_missing?(relative) ||
              descriptor_tree.open_directory(relative) { descriptor_tree.children(relative).empty? }
          end
        else
          return false if placeholder.exist? && (!placeholder.file? || placeholder.symlink? || !placeholder.size.zero?)
          directories = %w[ db files ].map { storage_directory.join(_1) }.select(&:exist?)
          directories.all? { _1.directory? && !_1.symlink? && _1.children.empty? }
        end
      end

      def install_files(source_tree, storage_directory, manifest, owned_paths, operation_lock,
          descriptor_tree, fault_after: nil)
        manifest.fetch("files").each do |metadata|
          operation_lock.assert_current!
          relative = Pathname(metadata.fetch("path"))
          destination = storage_directory.join(relative)
          create_directory destination.dirname, storage_directory, owned_paths, operation_lock,
            descriptor_tree
          mode = relative.to_s == CampfireBackup::InstallationIdentity::FILENAME ? 0o644 : 0o600
          copy_exclusively(
            source_tree, "payload/#{relative}", metadata, destination, mode, owned_paths,
            descriptor_tree, storage_directory, fault_after: fault_after
          )
        end

        database_metadata = manifest.fetch("database")
        database_directory = storage_directory.join("db")
        create_directory database_directory, storage_directory, owned_paths, operation_lock,
          descriptor_tree
        database_path = database_directory.join(database_metadata.fetch("path"))
        temporary_database = database_directory.join(".#{database_path.basename}.restore")
        copy_exclusively(
          source_tree, database_metadata.fetch("path"), database_metadata, temporary_database,
          0o600, owned_paths, descriptor_tree, storage_directory, fault_after: fault_after
        )
        temporary_relative = temporary_database.relative_path_from(storage_directory).to_s
        database_relative = database_path.relative_path_from(storage_directory).to_s
        temporary_identity = nil
        descriptor_tree.open_regular_file(temporary_relative) do |_file, stat|
          temporary_identity = metadata_identity(stat)
        end
        descriptor_tree.link temporary_relative, database_relative
        descriptor_tree.open_entry(database_relative) do |_file, stat|
          raise "Restored database publication is not a regular file" unless stat.file? && stat.nlink == 2

          owned_paths.record(database_path, stat:)
        end
        descriptor_tree.remove(
          temporary_relative, expected_identity: temporary_identity, directory: false,
          independent: false
        )
        owned_paths.forget temporary_database
        descriptor_tree.open_directory("db") { |directory| flush_directory(directory) }
      end

      def runtime_ownership!(owner_uid, owner_gid, runtime_uid, runtime_gid, environment)
        supplied_uid = !owner_uid.to_s.empty?
        supplied_gid = !owner_gid.to_s.empty?
        unless supplied_uid == supplied_gid
          raise "RESTORE_UID and RESTORE_GID must be provided together"
        end

        if supplied_uid
          owner_uid = Integer(owner_uid.to_s, 10)
          owner_gid = Integer(owner_gid.to_s, 10)
        elsif Process.euid == runtime_uid && Process.egid == runtime_gid
          owner_uid = runtime_uid
          owner_gid = runtime_gid
        else
          raise "RESTORE_UID=#{runtime_uid} and RESTORE_GID=#{runtime_gid} are required for the Campfire image runtime"
        end
        unless owner_uid == runtime_uid && owner_gid == runtime_gid
          raise "Restore ownership must match Campfire image UID #{runtime_uid} and GID #{runtime_gid}"
        end
        if environment.to_s == "production" && !Process.euid.zero?
          raise "Production restore must run as root so the destination can remain inaccessible to the runtime UID"
        end

        [ owner_uid, owner_gid, Process.euid.zero? && Process.euid != runtime_uid ]
      end

      def apply_runtime_ownership!(storage_directory, operation_lock, owned_paths, restore_marker,
          uid, gid, descriptor_tree)
        descriptor_tree.open_directory(".", expected_identity: operation_lock.target_identity) do |root|
          operation_lock.apply_file_ownership! uid: uid, gid: gid
          apply_descriptor_metadata!(
            restore_marker.path, "Restore-in-progress marker",
            expected_identity: restore_marker.identity, expected_type: :file,
            uid: uid, gid: gid, mode: 0o600, descriptor_tree:, root: storage_directory
          )
          owned_paths.each_current do |path, stat, file|
            relative = path.relative_path_from(storage_directory).to_s
            mode = if stat.directory?
              0o700
            elsif relative == CampfireBackup::InstallationIdentity::FILENAME
              0o644
            else
              0o600
            end
            identity = metadata_identity(stat)
            set_descriptor_metadata! file, path, uid: uid, gid: gid, mode: mode
            descriptor_tree.open_entry(
              relative, expected_identity: identity
            ) do |_current, current_stat|
              expected_type = stat.directory? ? current_stat.directory? :
                current_stat.file? && current_stat.nlink == 1
              raise "Restored storage entry changed during ownership handoff: #{path}" unless expected_type
            end
          rescue RuntimeError
            raise "Restored storage entry changed during ownership handoff: #{path}"
          end

          root.fsync
          descriptor_tree.assert_root_current!
        end
      end

      def claim_restore_destination!(storage_directory, operation_lock, descriptor_tree,
          isolate_runtime:)
        descriptor_tree.open_directory(".", expected_identity: operation_lock.target_identity) do |root|
          root.chmod(isolate_runtime ? 0o000 : 0o700)
          root.chown Process.euid, Process.egid
          root.fsync
          stat = root.stat
          expected_mode = isolate_runtime ? 0o000 : 0o700
          unless stat.uid == Process.euid && stat.gid == Process.egid &&
              (stat.mode & 0o777) == expected_mode
            raise "Restore destination could not be isolated from the runtime UID"
          end
          descriptor_tree.assert_root_current!
        rescue SystemCallError => error
          raise "Could not isolate restore destination from the runtime UID: #{error.message}"
        end
      end

      def commit_restore!(storage_directory, operation_lock, descriptor_tree, restore_marker,
          installed_inventory, uid, gid, isolate_runtime:, fault_after: nil)
        committed = false
        root = nil
        begin
          descriptor_tree.open_directory(".", expected_identity: operation_lock.target_identity) do |opened_root|
            root = opened_root
            CampfireBackup::RecoveryMarkers.complete_restore!(
              restore_marker, descriptor_tree:
            )
            fault_after&.call("marker-removed")
            assert_storage_inventory_current!(
              storage_directory, installed_inventory, descriptor_tree:
            )
            operation_lock.assert_current!
            descriptor_tree.assert_root_current!

            opened_root.chmod 0o000 unless isolate_runtime
            opened_root.chown uid, gid
            opened_root.fsync
            locked = opened_root.stat
            unless locked.uid == uid && locked.gid == gid && (locked.mode & 0o777).zero?
              raise "Restore destination ownership commit did not remain inaccessible"
            end

            opened_root.chmod 0o700
            fault_after&.call("root-exposed")
            opened_root.fsync
            published = opened_root.stat
            unless published.uid == uid && published.gid == gid &&
                (published.mode & 0o777) == 0o700
              raise "Restore destination ownership commit failed"
            end
            descriptor_tree.assert_root_current!
          end
          committed = true
        ensure
          unless committed || !root
            begin
              root.chmod 0o000
              root.fsync
            rescue StandardError => lockdown_error
              warn "Failed restore could not be relocked: #{lockdown_error.message}"
            end
          end
        end
        true
      end

      def apply_descriptor_metadata!(path, description, expected_identity:, expected_type:, uid:, gid:, mode:,
          descriptor_tree: nil, root: nil)
        if descriptor_tree
          relative = Pathname(path).relative_path_from(Pathname(root)).to_s
          descriptor_tree.open_entry(relative, expected_identity:) do |file, stat|
            expected_kind = expected_type == :directory ? stat.directory? :
              stat.file? && stat.nlink == 1
            raise "#{description} changed during ownership handoff: #{path}" unless expected_kind

            set_descriptor_metadata! file, path, uid:, gid:, mode:
          end
          descriptor_tree.open_entry(relative, expected_identity:) do |_file, stat|
            expected_kind = expected_type == :directory ? stat.directory? :
              stat.file? && stat.nlink == 1
            raise "#{description} changed during ownership handoff: #{path}" unless expected_kind
          end
          return
        end

        with_pinned_metadata_descriptor(
          path, description, expected_identity:, expected_type:
        ) do |file|
          set_descriptor_metadata! file, path, uid: uid, gid: gid, mode: mode
        end
      end

      def set_descriptor_metadata!(file, path, uid:, gid:, mode:)
        file.chown uid, gid
        file.chmod mode
        file.fsync
        stat = file.stat
        unless stat.uid == uid && stat.gid == gid && (stat.mode & 0o777) == mode
          raise "Restored storage descriptor metadata does not match its ownership handoff: #{path}"
        end
      rescue SystemCallError => error
        raise "Could not apply restored storage ownership through its descriptor: #{path}: #{error.message}"
      end

      def with_pinned_metadata_descriptor(path, description, expected_identity:, expected_type:)
        raise "No-follow descriptor support is required for restore ownership" unless defined?(File::NOFOLLOW)

        path = Pathname(path)
        flags = File::RDONLY | File::NOFOLLOW
        flags |= File::NONBLOCK if defined?(File::NONBLOCK)
        flags |= File::DIRECTORY if expected_type == :directory && defined?(File::DIRECTORY)
        File.open(path, flags) do |file|
          assert_metadata_descriptor_current!(
            file, path, description, expected_identity:, expected_type:
          )
          result = yield file
          assert_metadata_descriptor_current!(
            file, path, description, expected_identity:, expected_type:
          )
          result
        end
      rescue Errno::ENOENT, Errno::ELOOP, Errno::ENOTDIR, Errno::ENXIO, Errno::ENODEV
        raise "#{description} changed during ownership handoff: #{path}"
      end

      def assert_metadata_descriptor_current!(file, path, description, expected_identity:, expected_type:)
        opened = file.stat
        current = path.lstat
        expected_kind = expected_type == :directory ? opened.directory? && current.directory? :
          opened.file? && current.file? && opened.nlink == 1 && current.nlink == 1
        unless expected_kind && !current.symlink? &&
            metadata_identity(opened) == expected_identity && metadata_identity(current) == expected_identity
          raise "#{description} changed during ownership handoff: #{path}"
        end
        opened
      rescue Errno::ENOENT, Errno::ELOOP, Errno::ENOTDIR
        raise "#{description} changed during ownership handoff: #{path}"
      end

      def verify_runtime_access!(storage_directory, uid, gid, expected_inventory:, descriptor_tree: nil,
          isolate_runtime: false)
        root_stat = descriptor_tree ? descriptor_tree.pinned_root_stat : storage_directory.lstat
        expected_root_uid = isolate_runtime ? Process.euid : uid
        expected_root_gid = isolate_runtime ? Process.egid : gid
        expected_root_mode = isolate_runtime ? 0o000 : 0o700
        unless root_stat.directory? && (descriptor_tree || !storage_directory.symlink?) &&
            root_stat.uid == expected_root_uid && root_stat.gid == expected_root_gid &&
            (root_stat.mode & 0o777) == expected_root_mode
          raise "Restored storage ownership does not match the Campfire image runtime"
        end

        inventory = assert_storage_inventory_current!(
          storage_directory, expected_inventory, descriptor_tree:
        )
        inventory.each_key do |relative|
          stat = if descriptor_tree
            descriptor_tree.open_entry(relative) { |_file, opened| opened }
          else
            storage_directory.join(relative).lstat
          end
          unless stat.uid == uid && stat.gid == gid
            raise "Restored storage ownership does not match the Campfire image runtime"
          end
          owner_mode = (stat.mode >> 6) & 0o7
          required = stat.directory? ? 0o7 : 0o6
          unless (owner_mode & required) == required
            raise "Restored storage is not accessible to the Campfire image runtime"
          end
        end
        assert_storage_inventory_current!(storage_directory, inventory, descriptor_tree:)
      end

      def create_directory(path, root, owned_paths, operation_lock, descriptor_tree)
        return if path == root
        operation_lock.assert_current!
        relative = path.relative_path_from(root).to_s
        if owned_paths.owned?(path)
          descriptor_tree.open_directory(relative) { nil }
          return
        end

        create_directory path.dirname, root, owned_paths, operation_lock, descriptor_tree
        descriptor_tree.mkdir(relative, mode: 0o700) do |directory, stat|
          owned_paths.record(path, stat:)
          directory.chmod 0o700
        end
      rescue Errno::EEXIST
        raise "Restore destination changed concurrently"
      rescue RuntimeError => error
        raise if error.message == "Restore destination changed concurrently"

        raise "Restore destination changed concurrently: #{error.message}"
      end

      def copy_exclusively(source_tree, source_relative, metadata, destination, mode, owned_paths,
          descriptor_tree, root, fault_after: nil)
        relative = destination.relative_path_from(root).to_s
        source_tree.open_regular_file(source_relative) do |source, source_stat|
          unless source_stat.size == metadata.fetch("bytes")
            raise "Backup source size does not match its authenticated manifest: #{source_relative}"
          end
          descriptor_tree.create_file(relative, mode:) do |file, stat|
            owned_paths.record(destination, stat:)
            copy_authenticated_source!(source, file, metadata, source_relative)
            fault_after&.call("source-copied:#{source_relative}")
            verify_authenticated_source!(source, metadata, source_relative)
            file.chmod mode
            file.flush
            file.fsync
          end
        end
      end

      def copy_authenticated_source!(source, destination, metadata, description)
        expected_bytes = metadata.fetch("bytes")
        source.rewind
        digest = Digest::SHA256.new
        remaining = expected_bytes
        while remaining.positive?
          chunk = source.read([ remaining, 1024 * 1024 ].min)
          if chunk.nil? || chunk.empty?
            raise "Backup source was truncated while it was copied: #{description}"
          end
          write_all destination, chunk
          digest << chunk
          remaining -= chunk.bytesize
        end
        raise "Backup source grew while it was copied: #{description}" if source.read(1)
        destination.flush
        unless destination.stat.size == expected_bytes &&
            digest.hexdigest == metadata.fetch("sha256")
          raise "Backup source does not match its authenticated manifest: #{description}"
        end
      end

      def verify_authenticated_source!(source, metadata, description)
        source.rewind
        digest = Digest::SHA256.new
        remaining = metadata.fetch("bytes")
        while remaining.positive?
          chunk = source.read([ remaining, 1024 * 1024 ].min)
          if chunk.nil? || chunk.empty?
            raise "Backup source changed while it was revalidated: #{description}"
          end
          digest << chunk
          remaining -= chunk.bytesize
        end
        if source.read(1) || digest.hexdigest != metadata.fetch("sha256")
          raise "Backup source changed while it was revalidated: #{description}"
        end
      ensure
        source.rewind if source && !source.closed?
      end

      def write_all(destination, contents)
        offset = 0
        while offset < contents.bytesize
          written = destination.write(contents.byteslice(offset, contents.bytesize - offset))
          raise "Could not copy authenticated backup bytes" unless written&.positive?

          offset += written
        end
      end

      def verify_installed!(storage_directory, manifest, expected_installation_fingerprint,
          descriptor_tree = nil)
        expected_inventory = expected_storage_inventory(manifest)
        before = storage_inventory(storage_directory, descriptor_tree:)
        unless inventory_types(before) == expected_inventory
          raise "Restored storage contains unexpected or missing entries"
        end

        database_metadata = manifest.fetch("database")
        database_path = storage_directory.join("db", database_metadata.fetch("path"))
        database_relative = database_path.relative_path_from(storage_directory).to_s
        verify_metadata! database_path, database_metadata,
          expected_identity: before.fetch(database_relative).fetch(:identity), descriptor_tree:,
          root: storage_directory
        manifest.fetch("files").each do |metadata|
          path = storage_directory.join(metadata.fetch("path"))
          verify_metadata! path, metadata,
            expected_identity: before.fetch(metadata.fetch("path")).fetch(:identity), descriptor_tree:,
            root: storage_directory
        end

        CampfireBackup::RedisValidator.validate!(
          storage_directory,
          require_aof: manifest.fetch("schema_version").to_i >= CampfireBackup::UpgradeRecoveryGuard::GATED_MIGRATION
        )
        manifest.fetch("files").each do |metadata|
          path = storage_directory.join(metadata.fetch("path"))
          verify_metadata! path, metadata,
            expected_identity: before.fetch(metadata.fetch("path")).fetch(:identity), descriptor_tree:,
            root: storage_directory
        end
        verify_database!(
          database_path, storage_directory, manifest, expected_installation_fingerprint,
          expected_inventory: before, descriptor_tree:
        )
        after = storage_inventory(storage_directory, descriptor_tree:)
        unless after == before && inventory_types(after) == expected_inventory
          raise "Restored storage changed during final validation"
        end
        after
      end

      def verify_database!(database_path, storage_directory, manifest, expected_installation_fingerprint,
          expected_inventory:, descriptor_tree: nil)
        database_relative = database_path.relative_path_from(storage_directory).to_s
        with_pinned_regular_file(
          database_path, "Restored database",
          expected_identity: expected_inventory.fetch(database_relative).fetch(:identity),
          descriptor_tree:, root: storage_directory
        ) do |database_file, database_stat|
          descriptor_path = open_descriptor_path(database_file)
          database = SQLite3::Database.new(
            "file:#{descriptor_path}?immutable=1", uri: true, readonly: true
          )
          descriptor = CampfireBackup::UpgradeRecoveryGuard.sqlite_main_file_descriptor!(database)
          unless descriptor
            raise "Native SQLite main-file descriptor verification is required for restore validation"
          end
          opened_by_sqlite = IO.for_fd(descriptor, autoclose: false).stat
          unless metadata_identity(opened_by_sqlite) == metadata_identity(database_stat)
            raise "SQLite opened a different restored database descriptor"
          end
          CampfireBackup::UpgradeRecoveryGuard.assert_sqlite_main_file_current! database
          database.results_as_hash = true
          unless database.get_first_value("PRAGMA integrity_check") == "ok"
            raise "Restored database failed integrity_check"
          end
          if database.execute("PRAGMA foreign_key_check").any?
            raise "Restored database failed foreign_key_check"
          end
          schema_version = database.get_first_value("SELECT MAX(version) FROM schema_migrations").to_i
          unless schema_version == manifest.fetch("schema_version")
            raise "Restored database schema does not match"
          end
          CampfireBackup::SchemaVerifier.verify!(descriptor_path, schema_version:)
          CampfireBackup::UpgradeRecoveryGuard.assert_sqlite_main_file_current! database

          marker = read_installation_marker!(
            storage_directory, expected_inventory:, descriptor_tree:
          )
          fingerprint = CampfireBackup::InstallationIdentity.fingerprint(marker)
          unless fingerprint == expected_installation_fingerprint
            raise "Restored installation fingerprint does not match"
          end
          if database.execute("PRAGMA table_info(accounts)").any? { _1.fetch("name") == "installation_identifier" }
            identifier = database.get_first_value("SELECT installation_identifier FROM accounts")
            unless identifier == marker
              raise "Restored installation marker does not match its database"
            end
          end
          verify_blob_files(
            database, storage_directory, expected_inventory:, descriptor_tree:
          )
        ensure
          database&.close
        end
      end

      def verify_blob_files(database, storage_directory, expected_inventory:, descriptor_tree: nil)
        database.execute("SELECT key, byte_size, checksum FROM active_storage_blobs").each do |blob|
          path = storage_directory.join("files", blob.fetch("key")[0, 2], blob.fetch("key")[2, 2], blob.fetch("key"))
          relative = path.relative_path_from(storage_directory).to_s
          with_pinned_regular_file(
            path, "Restored uploaded file #{blob.fetch('key')}",
            expected_identity: expected_inventory.fetch(relative).fetch(:identity),
            descriptor_tree:, root: storage_directory
          ) do |file, stat|
            unless stat.size == blob.fetch("byte_size")
              raise "Restore is missing uploaded file #{blob.fetch('key')}"
            end
            checksum = Base64.strict_encode64(digest_io(file, Digest::MD5.new).digest)
            unless checksum == blob.fetch("checksum")
              raise "Restored uploaded-file checksum does not match the database"
            end
          end
        end
      end

      def verify_metadata!(path, metadata, expected_identity:, descriptor_tree: nil, root: nil)
        with_pinned_regular_file(
          path, "Restored file", expected_identity:, descriptor_tree:, root:
        ) do |file, stat|
          unless stat.size == metadata.fetch("bytes") &&
              digest_io(file, Digest::SHA256.new).hexdigest == metadata.fetch("sha256")
            raise "Restored file does not match the authenticated manifest: #{path}"
          end
        end
      end

      def storage_files(storage_directory)
        storage_inventory(storage_directory).filter_map do |relative, metadata|
          relative if metadata.fetch(:type) == :file
        end.sort
      end

      def expected_storage_inventory(manifest)
        database = manifest.fetch("database")
        file_paths = manifest.fetch("files").map { safe_relative_path(_1.fetch("path")) }
        file_paths << safe_relative_path("db/#{database.fetch('path')}")
        unless file_paths.uniq.size == file_paths.size
          raise "Authenticated restore inventory contains duplicate files"
        end
        directories = file_paths.flat_map do |path|
          parts = Pathname(path).each_filename.to_a
          (1...parts.length).map { parts.first(_1).join("/") }
        end.uniq
        directories.to_h { [ _1, :directory ] }.merge(file_paths.to_h { [ _1, :file ] }).sort.to_h
      end

      def safe_relative_path(value)
        path = Pathname(value).cleanpath
        if path.absolute? || path.to_s == "." || path.to_s.start_with?("../")
          raise "Authenticated restore inventory contains an unsafe path"
        end
        path.to_s
      end

      def storage_inventory(storage_directory, descriptor_tree: nil)
        inventory = {}
        collect_directory_inventory(
          storage_directory, storage_directory, inventory, descriptor_tree:
        )
        inventory.delete CampfireBackup::OperationLock::SHARED_FILENAME
        inventory.delete CampfireBackup::RecoveryMarkers::RESTORE_FILENAME
        inventory.sort.to_h
      end

      def collect_directory_inventory(directory, root, inventory, descriptor_tree: nil,
          relative_directory: ".")
        if descriptor_tree
          descriptor_tree.open_directory(relative_directory) do
            descriptor_tree.children(relative_directory).sort.each do |name|
              if name.in?([ ".", ".." ]) || name.include?(File::SEPARATOR)
                raise "Restored storage contains an unsafe entry name"
              end

              relative = relative_directory == "." ? name : "#{relative_directory}/#{name}"
              path = root.join(relative)
              descriptor_tree.open_entry(relative) do |_file, stat|
                if stat.directory?
                  inventory[relative] = inventory_metadata(stat, :directory)
                  collect_directory_inventory path, root, inventory, descriptor_tree:,
                    relative_directory: relative
                elsif stat.file? && stat.nlink == 1
                  inventory[relative] = inventory_metadata(stat, :file)
                else
                  raise "Restored storage contains a link or special file: #{path}"
                end
              end
            end
          end
          return
        end

        with_pinned_directory(directory) do |opened_directory|
          children = directory_children(opened_directory)
          children.sort.each do |name|
            raise "Restored storage contains an unsafe entry name" if name.in?([ ".", ".." ]) || name.include?(File::SEPARATOR)

            path = directory.join(name)
            stat = path.lstat
            relative = path.relative_path_from(root).to_s
            if stat.directory? && !stat.symlink?
              inventory[relative] = inventory_metadata(stat, :directory)
              collect_directory_inventory path, root, inventory
            elsif stat.file? && !stat.symlink? && stat.nlink == 1
              inventory[relative] = inventory_metadata(stat, :file)
            else
              raise "Restored storage contains a link or special file: #{path}"
            end
          rescue Errno::ENOENT, Errno::ELOOP
            raise "Restored storage changed during final validation"
          end
        end
      end

      def with_pinned_directory(path)
        flags = File::RDONLY
        flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
        File.open(path, flags) do |directory|
          opened = directory.stat
          current = path.lstat
          unless opened.directory? && current.directory? && !current.symlink? &&
              file_identity(opened) == file_identity(current)
            raise "Restored storage directory changed during final validation"
          end
          yield directory
          after = directory.stat
          current = path.lstat
          unless file_identity(opened) == file_identity(after) &&
              file_identity(after) == file_identity(current)
            raise "Restored storage directory changed during final validation"
          end
        end
      rescue Errno::ENOENT, Errno::ELOOP, Errno::ENOTDIR
        raise "Restored storage directory changed during final validation"
      end

      def directory_children(file)
        descriptor = file.dup
        descriptor.autoclose = false
        directory = Dir.for_fd(descriptor.fileno)
        directory.children
      ensure
        directory&.close
      end

      def inventory_metadata(stat, type)
        {
          type:, identity: file_identity(stat), mode: stat.mode, uid: stat.uid, gid: stat.gid,
          bytes: type == :file ? stat.size : nil,
          modified_at: [ stat.mtime.to_i, stat.mtime.nsec ],
          changed_at: [ stat.ctime.to_i, stat.ctime.nsec ]
        }.freeze
      end

      def inventory_types(inventory)
        inventory.transform_values { _1.fetch(:type) }
      end

      def assert_storage_inventory_current!(storage_directory, expected, descriptor_tree: nil)
        current = storage_inventory(storage_directory, descriptor_tree:)
        unless current == expected
          raise "Restored storage changed during final validation"
        end
        current
      end

      def with_pinned_regular_file(path, description, expected_identity: nil,
          descriptor_tree: nil, root: nil)
        if descriptor_tree
          relative = Pathname(path).relative_path_from(Pathname(root)).to_s
          return descriptor_tree.open_regular_file(relative, expected_identity:) do |file, stat|
            yield file, stat
          end
        end

        initial = path.lstat
        unless initial.file? && !initial.symlink? && initial.nlink == 1
          raise "#{description} is not an independent regular file: #{path}"
        end
        flags = File::RDONLY | File::BINARY
        flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
        flags |= File::NONBLOCK if defined?(File::NONBLOCK)
        File.open(path, flags) do |file|
          opened = file.stat
          current = path.lstat
          unless opened.file? && opened.nlink == 1 &&
              file_identity(opened) == file_identity(current) &&
              (!expected_identity || file_identity(opened) == expected_identity)
            raise "#{description} changed during final validation: #{path}"
          end
          result = yield file, opened
          after = file.stat
          current = path.lstat
          unless file_identity(opened) == file_identity(after) &&
              file_identity(after) == file_identity(current) && opened.size == after.size
            raise "#{description} changed during final validation: #{path}"
          end
          result
        end
      rescue Errno::ENOENT, Errno::ELOOP, Errno::ENXIO, Errno::ENODEV
        raise "#{description} is not an independent regular file: #{path}"
      end

      def file_identity(stat)
        [ stat.dev, stat.ino, stat.ftype, stat.nlink ]
      end

      def metadata_identity(stat)
        [ stat.dev, stat.ino, stat.ftype ]
      end

      def digest_io(file, digest)
        position = file.pos
        file.rewind
        while (chunk = file.read(1024 * 1024))
          digest << chunk
        end
        digest
      ensure
        file.seek position, IO::SEEK_SET if defined?(position) && position
      end

      def read_authenticated_manifest!(source_tree, authentication_key)
        source = source_tree.open_regular_file("manifest.json") do |file, stat|
          unless stat.size.between?(1, BackupVerifier::MAX_MANIFEST_BYTES)
            raise "Backup manifest exceeds its safe size limit"
          end

          contents = +"".b
          while contents.bytesize < stat.size
            chunk = file.read([ stat.size - contents.bytesize, 1024 * 1024 ].min)
            raise "Backup manifest was truncated while it was read" if chunk.nil? || chunk.empty?

            contents << chunk
          end
          raise "Backup manifest grew while it was read" if file.read(1)

          contents
        end
        CampfireBackup::Authentication.verify_manifest!(
          JSON.parse(source), key: authentication_key
        )
      end

      def open_descriptor_path(file)
        paths = [ "/proc/self/fd/#{file.fileno}", "/dev/fd/#{file.fileno}" ]
        paths.find { File.exist?(_1) } || raise("Open file descriptors cannot be addressed safely")
      end

      def read_installation_marker!(storage_directory, expected_inventory:, descriptor_tree: nil)
        path = storage_directory.join(CampfireBackup::InstallationIdentity::FILENAME)
        relative = path.relative_path_from(storage_directory).to_s
        with_pinned_regular_file(
          path, "Installation identity marker",
          expected_identity: expected_inventory.fetch(relative).fetch(:identity),
          descriptor_tree:, root: storage_directory
        ) do |file|
          file.rewind
          file.read.strip.tap { CampfireBackup::InstallationIdentity.validate!(_1) }
        end
      end

      def storage_entries(storage_directory, operation_lock, descriptor_tree = nil)
        entries = if descriptor_tree
          descriptor_tree.children.map { storage_directory.join(_1) }
        else
          storage_directory.children
        end
        entries.reject do |path|
          path == operation_lock.shared_path ||
            path == storage_directory.join(CampfireBackup::RecoveryMarkers::RESTORE_FILENAME)
        end
      end

      def flush_directory(path)
        path.respond_to?(:fsync) ? path.fsync : File.open(path, &:fsync)
      end
  end
end

if $PROGRAM_NAME == __FILE__
  BackupInstaller.install(
    generation_path: ARGV.fetch(0),
    storage_directory: ARGV.fetch(1),
    expected_installation_fingerprint: ENV.fetch("EXPECTED_INSTALLATION_FINGERPRINT"),
    expected_environment: ENV.fetch("EXPECTED_ENVIRONMENT", "production")
  )
end
