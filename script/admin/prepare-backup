#!/usr/bin/env ruby
# Invoke only while all web and queue writers are quiesced: the primary and
# Solid Queue databases are snapshotted separately and are not cross-DB atomic.
require File.expand_path("../../config/environment", File.dirname(__FILE__))

class Backup
  class << self
    def create
      database_configs.each { |config| backup_database(config) }
    end

    private
      def backup_database(config)
        source_path = Rails.root.join(config.fetch("database"))
        raise "Database does not exist: #{source_path}" unless source_path.file?

        source = SQLite3::Database.new(source_path.to_s)
        dest = SQLite3::Database.new(backup_filename(config))
        backup = SQLite3::Backup.new(dest, "main", source, "main")

        backup.step(-1)
      ensure
        backup&.finish
        dest&.close
        source&.close
      end

      def database_configs
        Rails.application.config.database_configuration.fetch(Rails.env).values_at("primary", "queue").compact
      end

      def backup_filename(config)
        Rails.root.join("storage", "backups").tap(&:mkpath).join(File.basename(config.fetch("database")))
      end
  end
end

Backup.create
