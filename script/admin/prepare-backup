#!/usr/bin/env ruby
require File.expand_path("../../config/environment", File.dirname(__FILE__))

class Backup
  class << self
    def create
      snapshot SolidQueue::Record
      snapshot ApplicationRecord
    end

    private
      def snapshot(model)
        dest = SQLite3::Database.new(backup_filename(model))
        backup = SQLite3::Backup.new(dest, "main", model.connection.raw_connection, "main")

        backup.step(-1)
        backup.finish
        dest.close
      end

      def backup_filename(model)
        Rails.root.join("storage", "backups").tap(&:mkpath).join(File.basename(model.connection_db_config.database))
      end
  end
end

Backup.create
