#!/usr/bin/env ruby

require "json"
require "yaml"

class ProcessMonitor
  SIGNALS = %w[ INT TERM CLD ]

  # The other processes use these, so they stop only once the others have exited
  SERVICES = %w[ redis ]

  def initialize(procfile)
    @procs = process_list(procfile)
    @services, @apps = @procs.partition { |process| SERVICES.include?(process.name) }
    handle_signals

    @procs.each &:start
    @apps.each &:wait

    @services.each &:terminate
    @services.each &:wait
  end

  private
    def process_list(procfile)
      config = YAML.load_file(procfile)
      config.map { |name, cmd| MonitoredProcess.new(name, cmd) }
    end

    def handle_signals
      SIGNALS.each do |signal|
        Signal.trap(signal) { stop }
      end
    end

    # Only once: a second TERM tells resque-pool to stop waiting for its workers
    def stop
      unless @stopping
        @stopping = true
        @apps.each &:terminate
      end
    end
end

class MonitoredProcess
  attr_reader :name

  def initialize(name, cmd)
    @name, @cmd = name, cmd
  end

  # In a process group of its own, so a Ctrl-C in a terminal reaches only bin/boot, which stops everything in order
  def start
    @pid = Process.spawn(@cmd, pgroup: true)
  end

  def wait
    Process.wait @pid
  rescue Errno::ECHILD
    nil
  end

  def terminate
    Process.kill "TERM", @pid
  rescue Errno::ESRCH
    nil
  end
end

ProcessMonitor.new("Procfile")
