#!/usr/bin/env ruby

require "json"
require "yaml"

class ProcessMonitor
  SIGNALS = %w[ INT TERM ]

  def initialize(procfile)
    @procs = process_list(procfile)
    handle_signals

    @procs.each &:start
    wait_for_procs
  end

  private
    def process_list(procfile)
      config = YAML.load_file(procfile)
      config.map { |name, cmd| MonitoredProcess.new(name, cmd) }
    end

    def handle_signals
      SIGNALS.each do |signal|
        Signal.trap(signal) do
          @procs.each &:terminate
        end
      end

      # A SIGCHLD ignored by whatever started this one would have the kernel reap the children, unseen by the wait
      Signal.trap("CLD", "SYSTEM_DEFAULT")
    end

    # In a container this is PID 1, which also adopts orphans. Waiting for any child reaps them
    # too, and only the exit of one of the processes stops the others.
    def wait_for_procs
      running = @procs.map(&:pid)

      until running.empty?
        @procs.each &:terminate if running.delete(Process.wait)
      end
    end
end

class MonitoredProcess
  attr_reader :pid

  def initialize(name, cmd)
    @name, @cmd = name, cmd
  end

  def start
    @pid = Process.spawn(@cmd)
  end

  def terminate
    Process.kill "TERM", @pid
  rescue Errno::ESRCH
    nil
  end
end

ProcessMonitor.new("Procfile")
