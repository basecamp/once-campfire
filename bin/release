if existing_release && !reconciling
  release_lock.assert_held!
  run! "gh", "release", "edit", TAG, "--repo", REPOSITORY, "--title", TAG,
    "--notes-file", notes_file, "--prerelease=false"
elsif !existing_release
  release_lock.assert_held!
  run! "gh", "release", "create", TAG, "--repo", REPOSITORY, "--draft", "--verify-tag",
    "--title", TAG, "--notes-file", notes_file
