rollback_prepared_promotion = reconcile_action == "rollback" && journal["channels"]
if rollback_prepared_promotion
  workflow_run = journal.fetch("workflow_run")
  unless workflow_run.is_a?(Hash) &&
      workflow_run.keys.sort == %w[ operation_nonce run_attempt run_id ] &&
      workflow_run["operation_nonce"].to_s.match?(/\A[0-9a-f]{64}\z/) &&
      workflow_run["run_id"].to_s.match?(/\A[1-9][0-9]*\z/) &&
      workflow_run["run_attempt"].to_s.match?(/\A[1-9][0-9]*\z/)
    raise ReleaseStateError, "Authenticated rollback workflow identity is invalid"
  end
  retained_identity = authenticated_retained_workflow_identity!(journal)
  if retained_identity && retained_identity != workflow_run
    raise ReleaseStateError, "Retained evidence differs from the rollback workflow identity"
  end
  workflow_run_id = workflow_run.fetch("run_id")
  workflow_run_attempt = workflow_run.fetch("run_attempt")
  operation_nonce = workflow_run.fetch("operation_nonce")
  artifacts = journal.fetch("artifacts")
  ghcr_digest = artifacts.fetch("ghcr_digest")
  once_digest = artifacts.fetch("once_digest")
  unless [ ghcr_digest, once_digest ].all? { _1.to_s.match?(/\Asha256:[0-9a-f]{64}\z/) } &&
      artifacts.fetch("export_sha256") == Digest::SHA256.file(versioned_export).hexdigest &&
      artifacts.fetch("checksum_sha256") == Digest::SHA256.file(versioned_checksum).hexdigest &&
      artifacts.fetch("notes_sha256") == Digest::SHA256.file(notes_file).hexdigest
    raise ReleaseStateError, "Authenticated rollback artifact contract is invalid"
  end
  release_assets = [ versioned_export, versioned_checksum ]
  static_export = "tmp/campfire.zip"
  static_checksum = "#{static_export}.sha256"
  FileUtils.cp versioned_export, static_export
  File.write static_checksum, "#{Digest::SHA256.file(static_export).hexdigest}  campfire.zip\n"
  static_targets = journal.fetch("channels").values.filter_map do |channel|
    channel.fetch("target") if channel.fetch("kind") == "static"
  end.uniq
  unless static_targets.one?
    raise ReleaseStateError, "Authenticated rollback static target is invalid"
  end
  static_target = static_targets.sole
  static_phase = journal.dig("phases", "static_staging", "data")
  unless static_phase.is_a?(Hash) && static_phase["target"] == static_target &&
      static_phase["archive_sha256"] == Digest::SHA256.file(static_export).hexdigest &&
      static_phase["checksum_sha256"] == Digest::SHA256.file(static_checksum).hexdigest
    raise ReleaseStateError, "Authenticated rollback static evidence is invalid"
  end
  publication_preflight = ->(**) {
    raise ReleaseStateError, "Rollback cannot invoke the forward publication preflight"
  }
else
run! "git", "fetch", RELEASE_REMOTE, "main", "--tags"
abort "Release aborted: verification changed the working tree." unless capture!("git", "status", "--porcelain", "--untracked-files=all").empty?
