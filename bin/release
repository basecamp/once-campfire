STABLE_VERSION = /\A(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/
class ReleaseMutationError < StandardError; end
class ReleaseStateError < StandardError; end
class ReleaseLiveLockLost < ReleaseStateError; end
class ReleaseMutationUnsettled < ReleaseStateError; end

require_relative "../lib/release_object_lock_anchors"

def capture!(*command, allow_failure: false)
  stdout, stderr, status = Open3.capture3(*command)
  abort "Command failed: #{command.shelljoin}\n#{stderr}#{stdout}" unless status.success? || allow_failure
  return nil unless status.success?

  stdout.strip
end

def run!(*command, env: {})
  abort "Command failed: #{command.shelljoin}" unless system(env, *command)
end

def mutate!(*command, env: {}, runner:)
  status = runner.call(*command, env:)
  raise ReleaseMutationError, "Command failed: #{command.shelljoin}" unless status.success?
end

def fault_after_external_mutation!(step)
  return unless ENV["RELEASE_FAULT_AFTER_STEP"] == step

  warn "Injected release interruption after #{step}"
  Process.exit! 86
end

class ReleaseJournal
  ALGORITHM = "HMAC-SHA256"
  KEY_ENVIRONMENT_VARIABLE = "RELEASE_JOURNAL_AUTHENTICATION_KEY"
  MINIMUM_KEY_BYTES = 32
  HISTORY_FORMAT_VERSION = 1
  HISTORY_PREFIX = "journal-history-"
  GENESIS_DIGEST = "0" * 64
  DIGEST_PATTERN = /\A[0-9a-f]{64}\z/
  LEGACY_MOVING_CHANNEL_FORMAT_VERSION = 5

  class << self
    def key_from_env(env = ENV)
      encoded = env.delete(KEY_ENVIRONMENT_VARIABLE).to_s
      abort "Release aborted: #{KEY_ENVIRONMENT_VARIABLE} is required." if encoded.empty?

      Base64.strict_decode64(encoded).tap do |key|
        if key.bytesize < MINIMUM_KEY_BYTES
          abort "Release aborted: #{KEY_ENVIRONMENT_VARIABLE} must contain at least 32 random bytes."
        end
      end
    rescue ArgumentError
      abort "Release aborted: #{KEY_ENVIRONMENT_VARIABLE} must be strict Base64."
    end

    def envelope(journal, key:)
      {
        "journal" => journal,
        "authentication" => {
          "algorithm" => ALGORITHM,
          "mac" => OpenSSL::HMAC.hexdigest("SHA256", key, canonical_json(journal))
        }
      }
    end

    def serialize(journal, key:)
      JSON.pretty_generate(envelope(journal, key:)) << "\n"
    end

    def build_history(journal, operation_id:, prior_digest:, publisher_id:, key:)
      revision = journal.fetch("journal_revision")
      unless operation_id.match?(/\A[0-9a-f]{64}\z/) && revision.is_a?(Integer) && revision >= 0 &&
          prior_digest.match?(DIGEST_PATTERN) && publisher_id.match?(/\A[0-9a-f]{32}\z/) &&
          journal.fetch("lock_id") == operation_id
        raise ReleaseStateError, "Release journal history metadata is invalid"
      end

      history_base = {
        "format_version" => HISTORY_FORMAT_VERSION,
        "operation_id" => operation_id,
        "revision" => revision,
        "prior_digest" => prior_digest,
        "publisher_id" => publisher_id
      }
      current_digest = Digest::SHA256.hexdigest(canonical_json(
        "history" => history_base, "journal" => journal
      ))
      history = history_base.merge("current_digest" => current_digest)
      payload = { "history" => history, "journal" => journal }
      source = JSON.pretty_generate(payload.merge(
        "authentication" => {
          "algorithm" => ALGORITHM,
          "mac" => OpenSSL::HMAC.hexdigest("SHA256", key, canonical_json(payload))
        }
      )) << "\n"
      {
        source:,
        name: history_filename(
          operation_id:, revision:, prior_digest:, current_digest:
        ),
        operation_id:,
        revision:,
        prior_digest:,
        current_digest:,
        publisher_id:
      }
    rescue KeyError, NoMethodError
      raise ReleaseStateError, "Release journal history metadata is invalid"
    end

    def verify_history!(source, key:, filename: nil)
      envelope = source.is_a?(String) ? JSON.parse(source) : source
      unless envelope.is_a?(Hash) && envelope.keys.sort == %w[ authentication history journal ]
        raise ReleaseStateError, "Release journal history envelope is invalid"
      end
      history = envelope.fetch("history")
      journal = envelope.fetch("journal")
      authentication = envelope.fetch("authentication")
      unless history.is_a?(Hash) &&
          history.keys.sort == %w[ current_digest format_version operation_id prior_digest publisher_id revision ] &&
          authentication.is_a?(Hash) && authentication.keys.sort == %w[ algorithm mac ] &&
          history.fetch("format_version") == HISTORY_FORMAT_VERSION &&
          history.fetch("operation_id").match?(/\A[0-9a-f]{64}\z/) &&
          history.fetch("revision").is_a?(Integer) && history.fetch("revision") >= 0 &&
          history.fetch("prior_digest").match?(DIGEST_PATTERN) &&
          history.fetch("current_digest").match?(DIGEST_PATTERN) &&
          history.fetch("publisher_id").match?(/\A[0-9a-f]{32}\z/) &&
          journal.is_a?(Hash) && journal.fetch("lock_id") == history.fetch("operation_id") &&
          journal.fetch("journal_revision") == history.fetch("revision") &&
          authentication.fetch("algorithm") == ALGORITHM
        raise ReleaseStateError, "Release journal history metadata is invalid"
      end

      history_base = history.except("current_digest")
      expected_digest = Digest::SHA256.hexdigest(canonical_json(
        "history" => history_base, "journal" => journal
      ))
      unless secure_compare(history.fetch("current_digest"), expected_digest)
        raise ReleaseStateError, "Release journal history digest is invalid"
      end
      payload = { "history" => history, "journal" => journal }
      expected_mac = OpenSSL::HMAC.hexdigest("SHA256", key, canonical_json(payload))
      unless secure_compare(authentication.fetch("mac"), expected_mac)
        raise ReleaseStateError, "Release journal history authentication failed"
      end

      expected_name = history_filename(
        operation_id: history.fetch("operation_id"), revision: history.fetch("revision"),
        prior_digest: history.fetch("prior_digest"), current_digest: history.fetch("current_digest")
      )
      if filename && filename != expected_name
        raise ReleaseStateError, "Release journal history filename does not match its authenticated entry"
      end
      {
        journal:,
        source: source.is_a?(String) ? source : JSON.pretty_generate(envelope) << "\n",
        name: expected_name,
        operation_id: history.fetch("operation_id"),
        revision: history.fetch("revision"),
        prior_digest: history.fetch("prior_digest"),
        current_digest: history.fetch("current_digest"),
        publisher_id: history.fetch("publisher_id")
      }
    rescue ReleaseStateError
      raise
    rescue JSON::ParserError, KeyError, NoMethodError => error
      raise ReleaseStateError, "Release journal history is invalid: #{error.message}"
    end

    def history_filename(operation_id:, revision:, prior_digest:, current_digest:)
      unless operation_id.match?(/\A[0-9a-f]{64}\z/) && revision.is_a?(Integer) && revision >= 0 &&
          prior_digest.match?(DIGEST_PATTERN) && current_digest.match?(DIGEST_PATTERN)
        raise ReleaseStateError, "Release journal history filename metadata is invalid"
      end
      "#{HISTORY_PREFIX}#{operation_id}-#{format('%020d', revision)}-#{prior_digest}-#{current_digest}.json"
    end

    def verify!(source, key:)
      envelope = source.is_a?(String) ? JSON.parse(source) : source
      journal = envelope.fetch("journal")
      authentication = envelope.fetch("authentication")
      raise ReleaseStateError, "Release journal authentication algorithm is invalid" unless authentication.fetch("algorithm") == ALGORITHM

      expected = OpenSSL::HMAC.hexdigest("SHA256", key, canonical_json(journal))
      unless secure_compare(authentication.fetch("mac"), expected)
        raise ReleaseStateError, "Release journal authentication failed"
      end
      journal
    rescue JSON::ParserError, KeyError, NoMethodError => error
      raise ReleaseStateError, "Release journal is invalid: #{error.message}"
    end

    def staging_token(kind, attributes, key:)
      payload = [ kind, *attributes ].join("\0")
      OpenSSL::HMAC.hexdigest("SHA256", key, payload)[0, 32]
    end

    def validate_contract!(journal, contract)
      raise ReleaseStateError, "Release journal does not match this release" unless contains_contract?(journal, contract)
    end

    def validate_format!(journal)
      version = journal["format_version"] if journal.is_a?(Hash)
      return true if version == RELEASE_JOURNAL_FORMAT_VERSION

      if version == LEGACY_MOVING_CHANNEL_FORMAT_VERSION
        raise ReleaseStateError,
          "Release journal format 5 predates generation-bound moving-channel state; " \
            "automatic migration is unsafe. Preserve the journal and use audited format-5 " \
            "recovery tooling before retrying"
      end
      raise ReleaseStateError, "Unsupported release journal format #{version.inspect}"
    end

    private
      def contains_contract?(actual, expected)
        case expected
        when Hash
          actual.is_a?(Hash) && expected.all? { |key, value| actual.key?(key) && contains_contract?(actual.fetch(key), value) }
        when Array
          actual == expected
        else
          actual == expected
        end
      end

      def canonical_json(value)
        JSON.generate(canonicalize(value))
      end

      def canonicalize(value)
        case value
        when Hash
          value.to_h { |key, item| [ key.to_s, canonicalize(item) ] }.sort.to_h
        when Array
          value.map { canonicalize(_1) }
        else
          value
        end
      end

      def secure_compare(left, right)
        left = left.to_s
        right = right.to_s
        return false unless left.bytesize == right.bytesize

        result = 0
        left.bytes.zip(right.bytes) { |a, b| result |= a ^ b }
        result.zero?
      end
  end
end

class ReleaseAtomicPublisher
  HISTORY_BOUNDARIES = %w[
    stage_created stream_complete size_verified digest_verified stage_synced
    publication_checked commit_publication_checked history_linked history_synced
    stage_removed directory_synced canonical_verified
  ].freeze
  DIRECTORY_BOUNDARIES = %w[
    directory_created owner_written owner_verified owner_synced stream_complete journal_created size_verified
    digest_verified artifacts_verified journal_synced history_linked history_synced journal_stage_removed
    staging_directory_synced publication_checked
    commit_publication_checked renamed parent_synced canonical_verified
  ].freeze

  def initialize(capture:, rename_noreplace: nil)
    @capture = capture
    @rename_noreplace = rename_noreplace || ->(source, destination) {
      atomic_no_replace_rename_command(source, destination)
    }
  end

  def publish_history_file!(canonical:, staging:, source:, lock_guard: "true",
      publication_guard: "true", fault_after: nil, stream: source)
    expected_bytes = source.bytesize
    expected_sha256 = Digest::SHA256.hexdigest(source)
    directory = File.dirname(canonical)
    command = <<~SH.gsub("\n", " ")
      set -eu;
      fault_after=#{Shellwords.escape(fault_after.to_s)};
      boundary() { test "$fault_after" != "$1" || exit 86; };
      #{lock_guard};
      #{publication_guard};
      test ! -e #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      test ! -e #{Shellwords.escape(staging)}; test ! -L #{Shellwords.escape(staging)};
      set -C; exec 9>#{Shellwords.escape(staging)}; set +C;
      boundary stage_created;
      cat >&9;
      boundary stream_complete;
      exec 9>&-;
      test "$(wc -c < #{Shellwords.escape(staging)} | tr -d ' ')" = #{expected_bytes};
      boundary size_verified;
      test "$(sha256sum #{Shellwords.escape(staging)} | cut -d' ' -f1)" = #{Shellwords.escape(expected_sha256)};
      boundary digest_verified;
      test -f #{Shellwords.escape(staging)}; test ! -L #{Shellwords.escape(staging)};
      test "$(stat -c %h #{Shellwords.escape(staging)})" -eq 1;
      sync -d #{Shellwords.escape(staging)};
      boundary stage_synced;
      #{publication_guard};
      test ! -e #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      boundary publication_checked;
      #{publication_guard};
      boundary commit_publication_checked;
      ln -T #{Shellwords.escape(staging)} #{Shellwords.escape(canonical)};
      boundary history_linked;
      test -f #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      test #{Shellwords.escape(staging)} -ef #{Shellwords.escape(canonical)};
      test "$(stat -c %h #{Shellwords.escape(canonical)})" -eq 2;
      test "$(wc -c < #{Shellwords.escape(canonical)} | tr -d ' ')" = #{expected_bytes};
      test "$(sha256sum #{Shellwords.escape(canonical)} | cut -d' ' -f1)" = #{Shellwords.escape(expected_sha256)};
      sync -d #{Shellwords.escape(canonical)};
      boundary history_synced;
      rm #{Shellwords.escape(staging)};
      boundary stage_removed;
      test "$(stat -c %h #{Shellwords.escape(canonical)})" -eq 1;
      sync -f #{Shellwords.escape(directory)};
      boundary directory_synced;
      test -f #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      test "$(stat -c %h #{Shellwords.escape(canonical)})" -eq 1;
      test "$(wc -c < #{Shellwords.escape(canonical)} | tr -d ' ')" = #{expected_bytes};
      test "$(sha256sum #{Shellwords.escape(canonical)} | cut -d' ' -f1)" = #{Shellwords.escape(expected_sha256)};
      boundary canonical_verified;
    SH
    execute! command, stream
    expected_sha256
  end

  def publish_directory!(canonical:, staging:, owner_id:, journal_name:, journal_stage_name:,
      journal_source:, artifacts: {}, expected_artifacts: nil, lock_guard: "true",
      publication_guard: "true", fault_after: nil, stream: nil)
    expected_bytes = journal_source.bytesize
    expected_sha256 = Digest::SHA256.hexdigest(journal_source)
    owner_source = "#{owner_id}\n"
    owner_bytes = owner_source.bytesize
    owner_sha256 = Digest::SHA256.hexdigest(owner_source)
    owner = File.join(staging, ReleaseLock::OWNER_FILENAME)
    journal_stage = File.join(staging, journal_stage_name)
    journal = File.join(staging, journal_name)
    canonical_owner = File.join(canonical, ReleaseLock::OWNER_FILENAME)
    canonical_journal = File.join(canonical, journal_name)
    parent = File.dirname(canonical)
    artifact_metadata = artifacts.to_h do |name, path|
      stat = File.lstat(path)
      unless File.basename(name) == name && stat.file? && !stat.symlink? && stat.nlink == 1
        raise ReleaseStateError, "Phase-zero artifact source is invalid"
      end
      expected = expected_artifacts&.fetch(name, nil)
      metadata = {
        path:, bytes: expected&.fetch(:bytes, nil) || stat.size,
        digest: expected&.fetch(:digest, nil) || Digest::SHA256.file(path).hexdigest
      }
      unless stat.size == metadata.fetch(:bytes) &&
          Digest::SHA256.file(path).hexdigest == metadata.fetch(:digest)
        raise ReleaseStateError, "Phase-zero artifact source changed before publication"
      end
      [ name, metadata ]
    end
    if expected_artifacts && expected_artifacts.keys.sort != artifact_metadata.keys.sort
      raise ReleaseStateError, "Phase-zero artifact publication contract is incomplete"
    end
    allowed_entries = [ journal_stage_name, *artifact_metadata.keys ].map do |name|
      "! -name #{Shellwords.escape(name)}"
    end.join(" ")
    artifact_checks = artifact_metadata.map do |name, metadata|
      path = File.join(staging, name)
      "test -f #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
        "test \"$(stat -c %h #{Shellwords.escape(path)})\" -eq 1; " \
        "test \"$(wc -c < #{Shellwords.escape(path)} | tr -d ' ')\" = #{metadata.fetch(:bytes)}; " \
        "test \"$(sha256sum #{Shellwords.escape(path)} | cut -d' ' -f1)\" = #{Shellwords.escape(metadata.fetch(:digest))}; " \
        "sync -d #{Shellwords.escape(path)}"
    end.join("; ")
    canonical_artifact_checks = artifact_metadata.map do |name, metadata|
      path = File.join(canonical, name)
      "test -f #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
        "test \"$(stat -c %h #{Shellwords.escape(path)})\" -eq 1; " \
        "test \"$(wc -c < #{Shellwords.escape(path)} | tr -d ' ')\" = #{metadata.fetch(:bytes)}; " \
        "test \"$(sha256sum #{Shellwords.escape(path)} | cut -d' ' -f1)\" = #{Shellwords.escape(metadata.fetch(:digest))}"
    end.join("; ")
    rename = @rename_noreplace.call(staging, canonical)
    command = <<~SH.gsub("\n", " ")
      set -eu; umask 077;
      fault_after=#{Shellwords.escape(fault_after.to_s)};
      boundary() { test "$fault_after" != "$1" || exit 86; };
      #{lock_guard};
      #{publication_guard};
      test ! -e #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      test ! -e #{Shellwords.escape(staging)}; test ! -L #{Shellwords.escape(staging)};
      mkdir #{Shellwords.escape(staging)};
      boundary directory_created;
      set -C; printf '%s\\n' #{Shellwords.escape(owner_id)} > #{Shellwords.escape(owner)}; set +C;
      boundary owner_written;
      test -f #{Shellwords.escape(owner)}; test ! -L #{Shellwords.escape(owner)};
      test "$(stat -c %h #{Shellwords.escape(owner)})" -eq 1;
      test "$(wc -c < #{Shellwords.escape(owner)} | tr -d ' ')" = #{owner_bytes};
      test "$(sha256sum #{Shellwords.escape(owner)} | cut -d' ' -f1)" = #{Shellwords.escape(owner_sha256)};
      boundary owner_verified;
      sync -d #{Shellwords.escape(owner)};
      boundary owner_synced;
      tar --extract --file=- --directory=#{Shellwords.escape(staging)} --keep-old-files --no-same-owner --no-same-permissions;
      boundary stream_complete;
      test -z "$(find #{Shellwords.escape(staging)} -mindepth 1 -maxdepth 1 ! -name #{Shellwords.escape(ReleaseLock::OWNER_FILENAME)} #{allowed_entries} -print -quit)";
      test "$(find #{Shellwords.escape(staging)} -mindepth 1 -maxdepth 1 -print | wc -l)" -eq #{artifact_metadata.length + 2};
      test -f #{Shellwords.escape(journal_stage)}; test ! -L #{Shellwords.escape(journal_stage)};
      test "$(stat -c %h #{Shellwords.escape(journal_stage)})" -eq 1;
      boundary journal_created;
      test "$(wc -c < #{Shellwords.escape(journal_stage)} | tr -d ' ')" = #{expected_bytes};
      boundary size_verified;
      test "$(sha256sum #{Shellwords.escape(journal_stage)} | cut -d' ' -f1)" = #{Shellwords.escape(expected_sha256)};
      boundary digest_verified;
      #{artifact_checks.empty? ? ":" : artifact_checks};
      boundary artifacts_verified;
      sync -d #{Shellwords.escape(journal_stage)};
      boundary journal_synced;
      ln -T #{Shellwords.escape(journal_stage)} #{Shellwords.escape(journal)};
      boundary history_linked;
      test #{Shellwords.escape(journal_stage)} -ef #{Shellwords.escape(journal)};
      test "$(stat -c %h #{Shellwords.escape(journal)})" -eq 2;
      sync -d #{Shellwords.escape(journal)};
      boundary history_synced;
      rm #{Shellwords.escape(journal_stage)};
      boundary journal_stage_removed;
      test "$(stat -c %h #{Shellwords.escape(journal)})" -eq 1;
      sync -f #{Shellwords.escape(staging)};
      boundary staging_directory_synced;
      test ! -e #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      boundary publication_checked;
      #{publication_guard};
      test ! -e #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      boundary commit_publication_checked;
      #{rename};
      boundary renamed;
      sync -f #{Shellwords.escape(parent)};
      boundary parent_synced;
      test -d #{Shellwords.escape(canonical)}; test ! -L #{Shellwords.escape(canonical)};
      test "$(cat #{Shellwords.escape(canonical_owner)})" = #{Shellwords.escape(owner_id)};
      test "$(stat -c %h #{Shellwords.escape(canonical_owner)})" -eq 1;
      test "$(wc -c < #{Shellwords.escape(canonical_owner)} | tr -d ' ')" = #{owner_bytes};
      test "$(sha256sum #{Shellwords.escape(canonical_owner)} | cut -d' ' -f1)" = #{Shellwords.escape(owner_sha256)};
      test -f #{Shellwords.escape(canonical_journal)}; test ! -L #{Shellwords.escape(canonical_journal)};
      test "$(stat -c %h #{Shellwords.escape(canonical_journal)})" -eq 1;
      test "$(wc -c < #{Shellwords.escape(canonical_journal)} | tr -d ' ')" = #{expected_bytes};
      test "$(sha256sum #{Shellwords.escape(canonical_journal)} | cut -d' ' -f1)" = #{Shellwords.escape(expected_sha256)};
      #{canonical_artifact_checks.empty? ? ":" : canonical_artifact_checks};
      test "$(find #{Shellwords.escape(canonical)} -mindepth 1 -maxdepth 1 -print | wc -l)" -eq #{artifact_metadata.length + 2};
      boundary canonical_verified;
    SH
    if stream
      execute! command, stream
    else
      with_directory_stream(journal_stage_name, journal_source, artifact_metadata) do |input|
        execute! command, input
      end
    end
    expected_sha256
  end

  private
    def with_directory_stream(journal_stage_name, journal_source, artifacts)
      Dir.mktmpdir("campfire-phase-zero") do |directory|
        File.open(
          File.join(directory, journal_stage_name), File::WRONLY | File::CREAT | File::EXCL, 0o600
        ) { _1.write journal_source }
        artifacts.each do |name, metadata|
          destination = File.join(directory, name)
          begin
            File.link metadata.fetch(:path), destination
          rescue Errno::EXDEV
            FileUtils.cp metadata.fetch(:path), destination
          end
        end
        Tempfile.create([ "campfire-phase-zero", ".tar" ]) do |stream|
          stream.close
          _stdout, stderr, status = Open3.capture3(
            "tar", "-cf", stream.path, "-C", directory, *Dir.children(directory).sort
          )
          raise ReleaseStateError, "Could not construct phase-zero artifact stream: #{stderr}" unless status.success?

          File.open(stream.path, "rb") { yield _1 }
        end
      end
    end

    def execute!(command, stream)
      stdout, stderr, status = @capture.call(command, stream)
      return stdout if status.success?

      raise ReleaseStateError, "Atomic release-state publication failed: #{stderr}#{stdout}"
    end
end

class ReleaseInvocationLock
  LOCK_PATH = File.join(EXPORT_DEPLOY_LOCATION, ".campfire-release.live.lock")
  OWNER_PATH = File.join(EXPORT_DEPLOY_LOCATION, ".campfire-release.live.owner")
  STATE_LOCK_PATH = File.join(EXPORT_DEPLOY_LOCATION, ".campfire-release.state.lock")
  ACQUISITION_TIMEOUT = 15
  MONITOR_INTERVAL = 0.05
  MUTATION_EXIT_TIMEOUT = 0.25
  MUTATION_TERMINATION_TIMEOUT = 1
  MUTATION_KILL_TIMEOUT = 5
  MUTATION_IO_TIMEOUT = 5

  class MutationChild
    attr_reader :pid, :status

    def initialize(pid, poll:, exit_timeout:, termination_timeout:, kill_timeout:,
        monitor_interval: MONITOR_INTERVAL,
        clock: -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) },
        sleeper: ->(duration) { sleep duration })
      @pid = pid
      @poll = poll
      @exit_timeout = exit_timeout
      @termination_timeout = termination_timeout
      @kill_timeout = kill_timeout
      @monitor_interval = monitor_interval
      @clock = clock
      @sleeper = sleeper
    end

    def poll
      @status ||= @poll.call
    end

    def settle_after_exit!
      unless wait_until_stopped(@exit_timeout)
        terminate!
        raise ReleaseStateError, "Mutation process group outlived its direct child"
      end

      @settled = true
      status
    end

    def terminate!
      signal_group "TERM"
      unless wait_until_stopped(@termination_timeout)
        signal_group "KILL"
        unless wait_until_stopped(@kill_timeout)
          raise ReleaseStateError, "Mutation process group did not terminate after SIGKILL"
        end
      end

      @settled = true
      status
    end

    def settled?
      @settled
    end

    private
      def wait_until_stopped(timeout)
        deadline = @clock.call + timeout
        loop do
          poll
          return true if status && !process_group_alive?
          now = @clock.call
          return false if now >= deadline

          @sleeper.call [ @monitor_interval, deadline - now ].min
        end
      end

      def process_group_alive?
        Process.kill 0, -pid
        true
      rescue Errno::ESRCH
        false
      rescue Errno::EPERM
        true
      end

      def signal_group(signal)
        Process.kill signal, -pid
      rescue Errno::ESRCH
        begin
          Process.kill signal, pid unless poll
        rescue Errno::ESRCH
          nil
        end
      end
  end

  attr_reader :invocation_id

  def self.acquire(invocation_id: SecureRandom.hex(16), command: nil, popen3: Open3.method(:popen3),
      mutation_popen3: Open3.method(:popen3), mutation_exit_timeout: MUTATION_EXIT_TIMEOUT,
      mutation_termination_timeout: MUTATION_TERMINATION_TIMEOUT,
      mutation_kill_timeout: MUTATION_KILL_TIMEOUT, mutation_io_timeout: MUTATION_IO_TIMEOUT)
    unless invocation_id.match?(/\A[0-9a-f]{32}\z/)
      raise ReleaseStateError, "Release invocation identity is invalid"
    end
    command ||= [
      "ssh", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
      ReleaseLock.remote, holder_command(invocation_id)
    ]
    new(
      invocation_id, command, popen3, mutation_popen3:, mutation_exit_timeout:,
      mutation_termination_timeout:, mutation_kill_timeout:, mutation_io_timeout:
    ).tap(&:acquire!)
  end

  def self.lock_pin_guard(path, fd)
    "test -f #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(path)})\" -eq 1; " \
      "test \"$(stat -Lc '%d:%i' /proc/$$/fd/#{fd})\" = \"$(stat -Lc '%d:%i' #{Shellwords.escape(path)})\"; " \
      "test \"$(stat -Lc %h /proc/$$/fd/#{fd})\" -eq 1"
  end

  def self.state_lock_command(fd = 8)
    path = Shellwords.escape(STATE_LOCK_PATH)
    parent = Shellwords.escape(EXPORT_DEPLOY_LOCATION)
    "umask 077; " \
      "if test ! -e #{path} && test ! -L #{path}; then (set -C; : > #{path}) 2>/dev/null || true; fi; " \
      "test -f #{path}; test ! -L #{path}; test \"$(stat -c %h #{path})\" -eq 1; " \
      "sync -d #{path}; sync -f #{parent}; exec #{fd}<>#{path}; flock -x #{fd}; " \
      "#{lock_pin_guard(STATE_LOCK_PATH, fd)}"
  end

  def self.holder_command(invocation_id)
    unless invocation_id.match?(/\A[0-9a-f]{32}\z/)
      raise ReleaseStateError, "Release invocation identity is invalid"
    end
    temporary = "#{OWNER_PATH}.#{invocation_id}.tmp"
    <<~SH.gsub("\n", " ")
      set -eu; umask 077;
      if test -e #{Shellwords.escape(LOCK_PATH)} || test -L #{Shellwords.escape(LOCK_PATH)}; then
        test -f #{Shellwords.escape(LOCK_PATH)}; test ! -L #{Shellwords.escape(LOCK_PATH)};
        test "$(stat -c %h #{Shellwords.escape(LOCK_PATH)})" -eq 1;
      else
        set -C; : > #{Shellwords.escape(LOCK_PATH)}; set +C;
        sync -d #{Shellwords.escape(LOCK_PATH)}; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)};
      fi;
      exec 9<>#{Shellwords.escape(LOCK_PATH)};
      if ! flock -n 9; then printf 'BUSY\\n'; exit 75; fi;
      #{lock_pin_guard(LOCK_PATH, 9)};
      #{state_lock_command(8)};
      live_lock_identity=$(stat -Lc '%d:%i' /proc/$$/fd/9);
      state_lock_identity=$(stat -Lc '%d:%i' /proc/$$/fd/8);
      owner_value=#{Shellwords.escape(invocation_id)}" $live_lock_identity $state_lock_identity";
      cleanup() {
        flock -x 8;
        #{lock_pin_guard(STATE_LOCK_PATH, 8)};
        #{lock_pin_guard(LOCK_PATH, 9)};
        if test -e #{Shellwords.escape(temporary)} || test -L #{Shellwords.escape(temporary)}; then
          test -f #{Shellwords.escape(temporary)}; test ! -L #{Shellwords.escape(temporary)};
          rm #{Shellwords.escape(temporary)};
        fi;
        if test -e #{Shellwords.escape(OWNER_PATH)} || test -L #{Shellwords.escape(OWNER_PATH)}; then
          if test -f #{Shellwords.escape(OWNER_PATH)} && test ! -L #{Shellwords.escape(OWNER_PATH)} &&
              test "$(cat #{Shellwords.escape(OWNER_PATH)})" = "$owner_value"; then
            rm #{Shellwords.escape(OWNER_PATH)};
            sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)};
          fi;
        fi;
        flock -u 8;
      };
      trap cleanup EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM;
      if test -e #{Shellwords.escape(OWNER_PATH)} || test -L #{Shellwords.escape(OWNER_PATH)}; then
        test -f #{Shellwords.escape(OWNER_PATH)}; test ! -L #{Shellwords.escape(OWNER_PATH)};
        rm #{Shellwords.escape(OWNER_PATH)};
      fi;
      test ! -e #{Shellwords.escape(temporary)}; test ! -L #{Shellwords.escape(temporary)};
      set -C; printf '%s %s %s\\n' #{Shellwords.escape(invocation_id)} "$live_lock_identity" "$state_lock_identity" > #{Shellwords.escape(temporary)}; set +C;
      test "$(cat #{Shellwords.escape(temporary)})" = "$owner_value";
      sync -d #{Shellwords.escape(temporary)};
      mv -T #{Shellwords.escape(temporary)} #{Shellwords.escape(OWNER_PATH)};
      sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)};
      test -f #{Shellwords.escape(OWNER_PATH)}; test ! -L #{Shellwords.escape(OWNER_PATH)};
      test "$(stat -c %h #{Shellwords.escape(OWNER_PATH)})" -eq 1;
      test "$(cat #{Shellwords.escape(OWNER_PATH)})" = "$owner_value";
      flock -u 8;
      printf 'READY %s\\n' #{Shellwords.escape(invocation_id)};
      cat >/dev/null;
    SH
  end

  def initialize(invocation_id, command, popen3, mutation_popen3: Open3.method(:popen3),
      mutation_exit_timeout: MUTATION_EXIT_TIMEOUT,
      mutation_termination_timeout: MUTATION_TERMINATION_TIMEOUT,
      mutation_kill_timeout: MUTATION_KILL_TIMEOUT, mutation_io_timeout: MUTATION_IO_TIMEOUT)
    @invocation_id = invocation_id
    @command = command
    @popen3 = popen3
    @mutation_popen3 = mutation_popen3
    @mutation_exit_timeout = mutation_exit_timeout
    @mutation_termination_timeout = mutation_termination_timeout
    @mutation_kill_timeout = mutation_kill_timeout
    @mutation_io_timeout = mutation_io_timeout
    @mutation_mutex = Mutex.new
    @active_mutations = {}
    @releasing = false
  end

  def acquire!
    @stdin, @stdout, @stderr, @wait_thread = @popen3.call(*@command)
    readable = IO.select([ @stdout ], nil, nil, ACQUISITION_TIMEOUT)
    response = @stdout.gets&.strip if readable
    return self if response == "READY #{invocation_id}" && @wait_thread.alive?

    close_stdin
    details = finish_failed_holder
    if response == "BUSY"
      raise ReleaseStateError, "Another release invocation holds the remote live-owner lock"
    end
    raise ReleaseStateError, "Could not acquire remote release live-owner lock: #{details}"
  end

  def assert_held!
    unless held?
      raise ReleaseLiveLockLost, "Remote release live-owner lock was lost"
    end
    true
  end

  def held?
    @wait_thread&.alive?
  end

  def run_mutation!(*command, env: {})
    assert_held!
    child = nil
    begin
      Thread.handle_interrupt(Exception => :never) do
        child = launch_mutation do
          pid = Process.spawn(env, *command, pgroup: true)
          mutation_child(pid) do
            begin
              Process.waitpid2(pid, Process::WNOHANG)&.last
            rescue Errno::EINTR
              nil
            rescue Errno::ECHILD
              raise ReleaseStateError, "Mutation child was reaped outside its lifecycle monitor"
            end
          end
        end
      end

      loop do
        if child.poll
          status = child.settle_after_exit!
          assert_held!
          return status
        end
        unless held?
          raise ReleaseLiveLockLost,
            "Remote release live-owner lock was lost while an external mutation was running"
        end
        sleep MONITOR_INTERVAL
      end
    ensure
      settle_mutation_child child
    end
  end

  def capture_mutation!(*command, stdin_data: nil)
    assert_held!
    child = nil
    io_threads = []
    stdin = stdout = stderr = nil
    begin
      Thread.handle_interrupt(Exception => :never) do
        child = launch_mutation do
          stdin, stdout, stderr, waiter = @mutation_popen3.call(*command, pgroup: true)
          mutation_child(waiter.pid) do
            waiter.join(0) ? waiter.value : nil
          end
        end
      end

      stdout_reader = capture_io_thread { stdout.read }
      io_threads << stdout_reader
      stderr_reader = capture_io_thread { stderr.read }
      io_threads << stderr_reader
      stdin_writer = capture_io_thread do
        if stdin_data.respond_to?(:read)
          IO.copy_stream stdin_data, stdin
        elsif stdin_data
          stdin.write stdin_data
        end
      ensure
        begin
          stdin.close unless stdin.closed?
        rescue IOError
          nil
        end
      end
      io_threads << stdin_writer

      loop do
        assert_io_threads! io_threads
        break if child.poll

        unless held?
          raise ReleaseLiveLockLost,
            "Remote release live-owner lock was lost while release state was being published"
        end
        sleep MONITOR_INTERVAL
      end

      status = child.settle_after_exit!
      wait_for_io_thread! stdin_writer, "stdin writer"
      stdout_result = wait_for_io_thread!(stdout_reader, "stdout reader")
      stderr_result = wait_for_io_thread!(stderr_reader, "stderr reader")
      assert_held!
      [ stdout_result, stderr_result, status ]
    ensure
      cleanup_error = nil
      begin
        settle_mutation_child child
      rescue Exception => error
        cleanup_error = error
      end
      Thread.handle_interrupt(Exception => :never) do
        io_threads.each { _1.kill if _1.alive? }
        io_threads.each(&:join)
        close_stream stdin
        close_stream stdout
        close_stream stderr
      end
      raise cleanup_error if cleanup_error
    end
  end

  def release
    return true unless @wait_thread

    begin_release!
    close_stdin
    status = Timeout.timeout(ACQUISITION_TIMEOUT) { @wait_thread.value }
    details = @stderr.read
    raise ReleaseStateError, "Remote release live-owner cleanup failed: #{details}" unless status.success?

    @stdout.close unless @stdout.closed?
    @stderr.close unless @stderr.closed?
    @wait_thread = nil
    true
  rescue Timeout::Error
    raise ReleaseStateError, "Timed out releasing remote release live-owner lock"
  end

  private
    def mutation_child(pid, &poll)
      MutationChild.new(
        pid, poll:, exit_timeout: @mutation_exit_timeout,
        termination_timeout: @mutation_termination_timeout,
        kill_timeout: @mutation_kill_timeout
      )
    end

    def launch_mutation
      @mutation_mutex.synchronize do
        if @releasing
          raise ReleaseStateError, "Cannot launch an external mutation while releasing the live-owner lock"
        end

        child = yield
        @active_mutations[child.pid] = child
        child
      end
    end

    def settle_mutation_child(child)
      return unless child

      Thread.handle_interrupt(Exception => :never) do
        child.terminate! unless child.settled?
        @mutation_mutex.synchronize { @active_mutations.delete child.pid }
      end
    end

    def begin_release!
      @mutation_mutex.synchronize do
        active = @active_mutations.keys
        unless active.empty?
          raise ReleaseStateError,
            "Cannot release the remote live-owner lock while mutation process groups remain active: #{active.join(', ')}"
        end
        @releasing = true
      end
    end

    def capture_io_thread(&operation)
      Thread.new do
        Thread.current.report_on_exception = false
        begin
          { value: operation.call }
        rescue Exception => error
          { error: }
        end
      end
    end

    def assert_io_threads!(threads)
      threads.each do |thread|
        next if thread.alive?

        result = thread.value
        raise result.fetch(:error) if result[:error]
      end
    end

    def wait_for_io_thread!(thread, description)
      unless thread.join(@mutation_io_timeout)
        thread.kill
        thread.join
        raise ReleaseStateError, "Mutation #{description} did not terminate"
      end

      result = thread.value
      raise result.fetch(:error) if result[:error]

      result.fetch(:value)
    end

    def close_stream(stream)
      stream&.close unless stream&.closed?
    rescue IOError
      nil
    end

    def close_stdin
      @stdin&.close unless @stdin&.closed?
    end

    def finish_failed_holder
      Timeout.timeout(ACQUISITION_TIMEOUT) { @wait_thread.value }
      @stderr.read
    rescue Timeout::Error
      "holder did not terminate"
    ensure
      @stdout&.close unless @stdout&.closed?
      @stderr&.close unless @stderr&.closed?
    end
end

ReleaseChannel = Data.define(:key, :previous, :target, :read, :write)

class ReleaseMutationFence
  TOKEN_PATTERN = /\A[0-9a-f]{32}\z/

  class Runner
    def initialize(lock, started)
      @lock = lock
      @started = started
    end

    def call(*command, env: {})
      @started.call
      @lock.run_mutation!(*command, env:)
    end

    def capture(*command, stdin_data: nil)
      @started.call
      @lock.capture_mutation!(*command, stdin_data:)
    end
  end

  def self.validate_marker!(marker)
    unless marker.is_a?(Hash) && marker.keys.sort == %w[ kind started_at target token ] &&
        marker.fetch("token").match?(TOKEN_PATTERN) && marker.fetch("kind").is_a?(String) &&
        !marker.fetch("kind").empty? && marker.fetch("started_at").is_a?(String)
      raise ReleaseStateError, "Authenticated in-flight mutation state is invalid"
    end
    if marker.fetch("kind") == "moving_channel"
      target = marker.fetch("target")
      unless target.is_a?(Hash) && target.keys.sort == %w[ channel generation value ] &&
          target.fetch("channel").is_a?(String) && !target.fetch("channel").empty? &&
          target.fetch("generation").to_s.match?(MOVING_CHANNEL_GENERATION_PATTERN)
        raise ReleaseStateError, "Authenticated moving-channel generation is invalid"
      end
    end
    marker
  rescue KeyError, NoMethodError
    raise ReleaseStateError, "Authenticated in-flight mutation state is invalid"
  end

  def self.ensure_settled!(journal)
    return true unless journal["mutation_in_flight"]

    marker = validate_marker! journal.fetch("mutation_in_flight")
    raise ReleaseStateError,
      "External mutation #{marker.fetch('kind')} remains unresolved; explicitly confirm settled token #{marker.fetch('token')}"
  end

  def initialize(lock:, journal:)
    @lock = lock
    @journal = journal
  end

  def run!(kind:, target:)
    self.class.ensure_settled! @journal
    marker = {
      "token" => SecureRandom.hex(16), "kind" => kind, "target" => target,
      "started_at" => Time.now.utc.iso8601
    }
    @journal["mutation_in_flight"] = marker
    @journal["updated_at"] = Time.now.utc.iso8601
    @lock.write_journal @journal

    mutation_started = false
    runner = Runner.new(@lock, -> { mutation_started = true })
    result = yield runner
    @lock.assert_held!
    clear! marker.fetch("token"), settled: mutation_started
    result
  rescue ReleaseLiveLockLost => error
    raise ReleaseLiveLockLost,
      "#{error.message}; authenticated mutation #{marker.fetch('kind')} remains unresolved with token #{marker.fetch('token')}"
  rescue StandardError => error
    if marker && mutation_started
      raise ReleaseMutationUnsettled,
        "External mutation did not reach verified settlement (#{error.message}); " \
          "authenticated token #{marker.fetch('token')} remains unresolved"
    end
    begin
      clear! marker.fetch("token"), settled: false if marker
    rescue StandardError => settlement_error
      raise ReleaseStateError,
        "External mutation stopped, but its authenticated in-flight state could not be settled: #{settlement_error.message}"
    end
    raise error
  end

  private
    def clear!(token, settled:)
      marker = self.class.validate_marker! @journal.fetch("mutation_in_flight")
      raise ReleaseStateError, "In-flight mutation token changed" unless marker.fetch("token") == token

      if settled
        @journal["settled_mutations"] ||= []
        @journal["settled_mutations"] << marker.merge("settled_at" => Time.now.utc.iso8601)
      end
      @journal.delete "mutation_in_flight"
      @journal["updated_at"] = Time.now.utc.iso8601
      @lock.write_journal @journal
      true
    rescue KeyError
      raise ReleaseStateError, "In-flight mutation state disappeared before settlement"
    end
end

def settle_release_mutation!(lock:, journal:, reconciling:, token:)
  marker = journal["mutation_in_flight"]
  if marker.nil?
    raise ReleaseStateError, "No in-flight mutation matches the supplied settled token" unless token.to_s.empty?
    return false
  end

  marker = ReleaseMutationFence.validate_marker! marker
  unless reconciling && token.to_s.match?(ReleaseMutationFence::TOKEN_PATTERN) &&
      token.to_s == marker.fetch("token")
    raise ReleaseStateError,
      "Explicit reconciliation must confirm settled mutation token #{marker.fetch('token')} before probing channels"
  end

  lock.assert_held!
  journal["settled_mutations"] ||= []
  journal["settled_mutations"] << marker.merge("settled_at" => Time.now.utc.iso8601)
  journal.delete "mutation_in_flight"
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  true
end

class ImmutableAliasConvergence
  def initialize(references:, staging_reference:, target_digest:, read:, stage:, verify:, sign:, publish:,
      fault_after: ->(_boundary, _reference) { })
    @references = references
    @staging_reference = staging_reference
    @target_digest = target_digest
    @read = read
    @stage = stage
    @verify = verify
    @sign = sign
    @publish = publish
    @fault_after = fault_after
  end

  def converge!(allow_create:)
    states = @references.to_h { [ _1, @read.call(_1) ] }
    conflicting = states.find { |_, digest| digest && digest != @target_digest }
    if conflicting
      raise ReleaseStateError, "Immutable alias #{conflicting.first} points at #{conflicting.last}, expected #{@target_digest}"
    end

    missing = states.select { |_, digest| digest.nil? }.keys
    if missing.any?
      raise ReleaseStateError, "Completed immutable aliases are missing: #{missing.join(', ')}" unless allow_create

      staging_digest = @read.call(@staging_reference)
      if staging_digest && staging_digest != @target_digest
        raise ReleaseStateError, "Immutable staging reference changed outside this release"
      end
      unless staging_digest
        @stage.call @staging_reference, @target_digest
        @fault_after.call "stage", @staging_reference
      end
      unless @read.call(@staging_reference) == @target_digest
        raise ReleaseStateError, "Immutable staging reference did not resolve to the protected digest"
      end
      @verify.call(@target_digest)
      @sign.call(@target_digest)
      @fault_after.call "signature", @target_digest

      missing.each do |reference|
        current = @read.call(reference)
        if current && current != @target_digest
          raise ReleaseStateError, "Refusing to overwrite immutable alias #{reference}"
        end
        unless current
          @publish.call reference, @target_digest
          @fault_after.call "alias", reference
        end
        unless @read.call(reference) == @target_digest
          raise ReleaseStateError, "Immutable alias #{reference} did not resolve to the signed digest"
        end
      end
    end

    unless @references.all? { @read.call(_1) == @target_digest }
      raise ReleaseStateError, "Immutable aliases did not converge to the protected digest"
    end
    @target_digest
  end
end

def converge_evidence_bound_aliases!(convergence, fault_after:)
  fault_after.call "evidence"
  convergence.converge!(allow_create: true)
end

def record_immutable_alias_evidence!(lock:, journal:, registry:, references:, digest:, source_evidence_sha256:)
  unless registry.match?(/\A[a-z0-9.-]+\z/) && digest.match?(/\Asha256:[0-9a-f]{64}\z/) &&
      source_evidence_sha256.match?(/\A[0-9a-f]{64}\z/) &&
      references.uniq.length == references.length && references.all? { _1.start_with?("#{registry}/") }
    raise ReleaseStateError, "Immutable registry alias evidence is invalid"
  end

  probe = registry_immutability_probe_evidence!(journal, registry)
  unless probe.fetch("seed_digest") == digest
    raise ReleaseStateError, "Immutable registry alias digest differs from its live probe for #{registry}"
  end
  contract = {
    "format_version" => 1,
    "registry" => registry,
    "source_digest" => digest,
    "source_evidence_sha256" => source_evidence_sha256,
    "aliases" => references.sort.to_h { [ _1, digest ] },
    "registry_policy_evidence_sha256" => Digest::SHA256.hexdigest(
      ReleaseObjectLockAnchors.canonical_json(probe)
    )
  }
  unless probe.fetch("policy_references") == references.sort
    raise ReleaseStateError, "Immutable registry policy proof does not cover every exact alias for #{registry}"
  end
  journal["immutable_alias_evidence"] ||= {}
  if existing = journal["immutable_alias_evidence"][registry]
    unless existing.except("recorded_at") == contract && existing.fetch("recorded_at").is_a?(String)
      raise ReleaseStateError, "Authenticated immutable alias evidence changed for #{registry}"
    end
    return existing
  end

  entry = contract.merge("recorded_at" => Time.now.utc.iso8601)
  journal["immutable_alias_evidence"][registry] = entry
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  entry
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Authenticated immutable alias evidence is invalid for #{registry}"
end

def verify_immutable_alias_evidence!(journal:, registry:, reference:, digest:)
  entry = journal.dig("immutable_alias_evidence", registry)
  probe = registry_immutability_probe_evidence!(journal, registry)
  unless entry.is_a?(Hash) && entry.fetch("format_version") == 1 &&
      entry.fetch("registry") == registry && entry.fetch("source_digest") == digest &&
      probe.fetch("seed_digest") == digest &&
      entry.fetch("source_evidence_sha256").match?(/\A[0-9a-f]{64}\z/) &&
      entry.fetch("registry_policy_evidence_sha256") == Digest::SHA256.hexdigest(
        ReleaseObjectLockAnchors.canonical_json(probe)
      ) &&
      entry.dig("aliases", reference) == digest
    raise ReleaseStateError, "Authenticated immutable alias target is missing or changed for #{reference}"
  end
  true
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Authenticated immutable alias target is invalid for #{reference}"
end

def registry_immutability_probe_evidence!(journal, registry)
  entry = journal.dig("registry_immutability_probes", registry)
  expected_keys = %w[
    conflict_digest control_overwrite_observed_digest control_reference control_seed_observed_digest
    format_version media_type policy_observed_digests policy_references prepared_at registry
    rejections repository seed_digest status verified_at
  ]
  unless entry.is_a?(Hash) && entry.keys.sort == expected_keys && entry.fetch("format_version") == 2 &&
      entry.fetch("status") == "verified" && entry.fetch("registry") == registry &&
      entry.fetch("repository").start_with?("#{registry}/") &&
      entry.fetch("control_reference").start_with?("#{entry.fetch('repository')}:release-mutability-control-") &&
      entry.fetch("seed_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      entry.fetch("conflict_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      entry.fetch("conflict_digest") != entry.fetch("seed_digest") &&
      entry.fetch("media_type").match?(/\Aapplication\/vnd\.(?:oci\.image\.index\.v1\+json|docker\.distribution\.manifest\.list\.v2\+json)\z/) &&
      entry.fetch("control_seed_observed_digest") == entry.fetch("seed_digest") &&
      entry.fetch("control_overwrite_observed_digest") == entry.fetch("conflict_digest") &&
      entry.fetch("policy_references").is_a?(Array) && entry.fetch("policy_references").any? &&
      entry.fetch("policy_references") == entry.fetch("policy_references").sort.uniq &&
      entry.fetch("policy_references").all? { _1.start_with?("#{entry.fetch('repository')}:") } &&
      entry.fetch("policy_observed_digests") == entry.fetch("policy_references").to_h {
        [ _1, entry.fetch("seed_digest") ]
      } && entry.fetch("rejections").keys.sort == entry.fetch("policy_references") &&
      entry.fetch("prepared_at").is_a?(String) && entry.fetch("verified_at").is_a?(String)
    raise ReleaseStateError, "Live immutable-tag probe evidence is missing or invalid for #{registry}"
  end
  entry.fetch("rejections").each_value do |rejection|
    unless rejection.is_a?(Hash) && rejection.keys.sort == %w[ classification exit_status output_sha256 ] &&
        rejection.fetch("classification") == "server_immutable_tag_rejection" &&
        rejection.fetch("exit_status").is_a?(Integer) && rejection.fetch("exit_status").positive? &&
        rejection.fetch("output_sha256").match?(/\A[0-9a-f]{64}\z/)
      raise ReleaseStateError, "Live immutable-tag rejection evidence is invalid for #{registry}"
    end
  end
  entry
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Live immutable-tag probe evidence is missing or invalid for #{registry}"
end

def registry_immutable_tag_rejection?(stdout, stderr, status)
  return false unless status.exited? && !status.success? && status.exitstatus&.positive?

  output = "#{stdout}\n#{stderr}"
  return false if output.empty? || output.match?(
    /unauthori[sz]ed|authentication required|insufficient.scope|requested access.*denied|\btimeout\b|timed out|connection|network|no such host|tls|certificate|unsupported|not implemented|unknown command|manifest unknown/i
  )

  output.match?(/\b(?:denied|forbidden|conflict|invalid)\b/i) &&
    output.match?(/immutable|cannot (?:overwrite|replace|update).*(?:tag|manifest)|(?:tag|manifest).*already exists/i)
end

def prove_registry_tag_immutability!(lock:, journal:, registry:, repository:, seed_digest:,
    conflict_digest:, seed_source:, conflict_source:, policy_references:, read:, media_type:,
    fault_prefix:)
  unless registry.match?(/\A[a-z0-9.-]+\z/) && repository.start_with?("#{registry}/") &&
      seed_digest.match?(/\Asha256:[0-9a-f]{64}\z/) &&
      conflict_digest.match?(/\Asha256:[0-9a-f]{64}\z/) && seed_digest != conflict_digest &&
      journal.fetch("lock_id").match?(/\A[0-9a-f]{64}\z/) && policy_references.is_a?(Array) &&
      policy_references.any? && policy_references.sort.uniq == policy_references.sort &&
      policy_references.all? { _1.start_with?("#{repository}:") }
    raise ReleaseStateError, "Immutable-tag probe contract is invalid for #{registry}"
  end
  unless read.call(seed_source) == seed_digest && read.call(conflict_source) == conflict_digest
    raise ReleaseStateError, "Immutable-tag probe sources are not the verified digests for #{registry}"
  end
  seed_media_type = media_type.call(seed_source)
  conflict_media_type = media_type.call(conflict_source)
  unless seed_media_type == conflict_media_type &&
      seed_media_type&.match?(/\Aapplication\/vnd\.(?:oci\.image\.index\.v1\+json|docker\.distribution\.manifest\.list\.v2\+json)\z/)
    raise ReleaseStateError, "Immutable-tag probe sources do not use the same supported index media type for #{registry}"
  end

  control_reference = "#{repository}:release-mutability-control-#{journal.fetch('lock_id')}"
  contract = {
    "format_version" => 2, "status" => "prepared", "registry" => registry,
    "repository" => repository, "control_reference" => control_reference,
    "policy_references" => policy_references.sort, "media_type" => seed_media_type,
    "seed_digest" => seed_digest, "conflict_digest" => conflict_digest
  }
  journal["registry_immutability_probes"] ||= {}
  if existing = journal["registry_immutability_probes"][registry]
    immutable = existing.slice(*contract.keys)
    unless immutable == contract || immutable == contract.merge("status" => "verified")
      raise ReleaseStateError, "Authenticated immutable-tag probe contract changed for #{registry}"
    end
    if existing["status"] == "verified"
      evidence = registry_immutability_probe_evidence!(journal, registry)
      unless read.call(control_reference) == conflict_digest &&
          policy_references.all? { read.call(_1) == seed_digest }
        raise ReleaseStateError, "Verified immutable-tag policy evidence changed for #{registry}"
      end
      return evidence
    end
  else
    journal["registry_immutability_probes"][registry] = contract.merge(
      "prepared_at" => Time.now.utc.iso8601
    )
    journal["updated_at"] = Time.now.utc.iso8601
    lock.write_journal journal
  end

  fence = ReleaseMutationFence.new(lock:, journal:)
  control_digest = read.call(control_reference)
  unless [ nil, seed_digest, conflict_digest ].include?(control_digest)
    raise ReleaseStateError, "Registry mutability control changed outside this release for #{registry}"
  end
  unless control_digest
    fence.run!(
      kind: "registry_mutability_control_seed",
      target: { "reference" => control_reference, "digest" => seed_digest }
    ) do |runner|
      mutate!(
        "docker", "buildx", "imagetools", "create", "--tag", control_reference,
        seed_source, runner:
      )
      fault_after_external_mutation! "#{fault_prefix}_control_seed"
      unless read.call(control_reference) == seed_digest
        raise ReleaseStateError, "Registry mutability control seed did not settle for #{registry}"
      end
    end
    control_digest = seed_digest
  end
  if control_digest == seed_digest
    fence.run!(
      kind: "registry_mutability_control_overwrite",
      target: { "reference" => control_reference, "digest" => conflict_digest }
    ) do |runner|
      mutate!(
        "docker", "buildx", "imagetools", "create", "--tag", control_reference,
        conflict_source, runner:
      )
      fault_after_external_mutation! "#{fault_prefix}_control_overwrite"
      unless read.call(control_reference) == conflict_digest
        raise ReleaseStateError, "Authenticated registry mutability control write did not settle for #{registry}"
      end
    end
  end
  unless read.call(control_reference) == conflict_digest
    raise ReleaseStateError, "Registry mutability control does not prove authenticated write authority for #{registry}"
  end

  rejections = {}
  policy_references.sort.each do |reference|
    current = read.call(reference)
    if current && current != seed_digest
      raise ReleaseStateError, "Immutable alias #{reference} was claimed by a conflicting digest before proof"
    end
    unless current
      fence.run!(
        kind: "immutable_alias_seed", target: { "reference" => reference, "digest" => seed_digest }
      ) do |runner|
        mutate!(
          "docker", "buildx", "imagetools", "create", "--tag", reference,
          seed_source, runner:
        )
        fault_after_external_mutation! "#{fault_prefix}_seed"
        unless read.call(reference) == seed_digest
          raise ReleaseStateError, "Immutable alias seed did not settle for #{reference}"
        end
      end
    end

    fence.run!(
      kind: "registry_immutability_probe_conflict",
      target: { "reference" => reference, "digest" => conflict_digest }
    ) do |runner|
      stdout, stderr, status = runner.capture(
        "docker", "buildx", "imagetools", "create", "--tag", reference,
        conflict_source
      )
      fault_after_external_mutation! "#{fault_prefix}_conflict"
      unless registry_immutable_tag_rejection?(stdout, stderr, status)
        raise ReleaseStateError,
          "Registry #{registry} did not return a specific server-side immutable-tag rejection for #{reference}"
      end
      unless read.call(reference) == seed_digest && read.call(reference) == seed_digest
        raise ReleaseStateError, "Registry #{registry} did not preserve immutable alias #{reference}"
      end
      rejections[reference] = {
        "classification" => "server_immutable_tag_rejection",
        "exit_status" => status.exitstatus,
        "output_sha256" => Digest::SHA256.hexdigest("#{stdout}\0#{stderr}")
      }
    end
  end

  entry = journal.fetch("registry_immutability_probes").fetch(registry)
  entry.merge!(
    "status" => "verified", "control_seed_observed_digest" => seed_digest,
    "control_overwrite_observed_digest" => conflict_digest,
    "policy_observed_digests" => policy_references.sort.to_h { [ _1, seed_digest ] },
    "rejections" => rejections,
    "verified_at" => Time.now.utc.iso8601
  )
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  registry_immutability_probe_evidence!(journal, registry)
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Immutable-tag probe state is invalid for #{registry}"
end

def create_registry_alias_with_policy!(reference:, digest:, read:)
  # Docker exposes no portable conditional tag PUT, so the registry must reject overwrites.
  current = read.call(reference)
  if current && current != digest
    raise ReleaseStateError, "Registry policy exposed conflicting immutable alias #{reference}=#{current}"
  end
  return digest if current == digest

  unless read.call(reference) == current
    raise ReleaseStateError, "Registry alias #{reference} changed during compare-before-write"
  end

  yield
  actual = read.call(reference)
  unless actual == digest && read.call(reference) == digest
    raise ReleaseMutationUnsettled,
      "Registry alias #{reference} did not settle at #{digest}; observed #{actual.inspect}"
  end
  digest
end

class MovingChannelPromotion
  OUTCOMES = RELEASE_RECONCILE_ACTIONS

  attr_reader :journal

  def initialize(lock:, journal:, channels:, fault_after: ->(_step) { })
    @lock = lock
    @journal = journal
    @channels = channels
    @fault_after = fault_after
  end

  def converge!(outcome)
    raise ReleaseStateError, "Unknown release convergence outcome #{outcome}" unless OUTCOMES.include?(outcome)
    if outcome == "complete" && %w[ rolled_back abandoned ].include?(journal["status"])
      raise ReleaseStateError, "Rollback invalidated authority to complete this release operation"
    end
    ReleaseMutationFence.ensure_settled! journal
    if @channels.any? { _1.previous == _1.target }
      raise ReleaseStateError, "A moving channel target was already present when its previous value was captured"
    end
    ensure_rollback_is_possible! if outcome == "rollback"
    generation = record_outcome! outcome

    ordered_channels(outcome).each do |channel|
      ensure_rollback_is_possible! if outcome == "rollback"
      desired = outcome == "complete" ? channel.target : channel.previous
      current = channel.read.call
      allowed = [ channel.previous, channel.target ].compact
      unless allowed.include?(current)
        raise ReleaseStateError, "#{channel.key} changed outside this release: #{current.inspect}"
      end
      if outcome == "complete" && current == channel.target &&
          !authenticated_moving_channel_target?(
            journal, channel: channel.key, value: channel.target, generation:
          )
        raise ReleaseStateError,
          "#{channel.key} reached its target without an authenticated mutation in this convergence generation"
      end

      if current != desired
        unless channel.read.call == current
          raise ReleaseStateError, "#{channel.key} changed during compare-before-write"
        end
        ReleaseMutationFence.new(lock: @lock, journal:).run!(
          kind: "moving_channel",
          target: { "channel" => channel.key, "value" => desired, "generation" => generation }
        ) do |runner|
          channel.write.call desired, runner
          @fault_after.call channel.key
          unless channel.read.call == desired && channel.read.call == desired
            raise ReleaseStateError, "#{channel.key} did not converge to #{desired}"
          end
        end
      elsif channel.read.call != desired || channel.read.call != desired
        raise ReleaseStateError, "#{channel.key} did not remain at #{desired}"
      end
      record_step! channel, desired, outcome, generation
    end

    verify!(outcome)
    journal["status"] = outcome == "complete" ? "completed" : "rolled_back"
    if outcome == "complete"
      journal["completion_authority"] = {
        "generation" => generation, "granted_at" => Time.now.utc.iso8601
      }
    else
      journal.delete "completion_authority"
    end
    journal["updated_at"] = Time.now.utc.iso8601
    @lock.write_journal journal
    true
  end

  def rollback_possible?
    @channels.all? { _1.previous } && @channels.none? do |channel|
      channel.key == "github_public" && channel.read.call == channel.target
    end
  end

  def verify!(outcome)
    @channels.each do |channel|
      expected = outcome == "complete" ? channel.target : channel.previous
      actual = channel.read.call
      raise ReleaseStateError, "Release channels disagree: #{channel.key}=#{actual.inspect}, expected #{expected.inspect}" unless actual == expected
    end
  end

  private
    def ensure_rollback_is_possible!
      raise ReleaseStateError, "All-old rollback is unavailable after publication or without a recorded previous channel" unless rollback_possible?
    end

    def ordered_channels(outcome)
      return @channels if outcome == "complete"

      public_channel, other_channels = @channels.reverse.partition { _1.key == "github_public" }
      public_channel + other_channels
    end

    def record_outcome!(outcome)
      now = Time.now.utc.iso8601
      generation = journal["convergence_generation"]
      if journal["outcome"] != outcome || !generation.to_s.match?(MOVING_CHANNEL_GENERATION_PATTERN)
        journal["completed_steps"] = {}
        generation = SecureRandom.hex(16)
        journal["convergence_generation"] = generation
      end
      if outcome == "rollback"
        journal.delete "completion_authority"
        journal["completion_authority_invalidated_at"] ||= now
      end
      journal["outcome"] = outcome
      journal["status"] = "converging"
      journal["updated_at"] = now
      @lock.write_journal journal
      generation
    end

    def record_step!(channel, value, outcome, generation)
      journal["completed_steps"] ||= {}
      journal["completed_steps"][channel.key] = {
        "outcome" => outcome,
        "value" => value,
        "generation" => generation,
        "verified_at" => Time.now.utc.iso8601
      }
      journal["updated_at"] = Time.now.utc.iso8601
      @lock.write_journal journal
    end
end

def authenticated_moving_channel_target?(journal, channel:, value:, generation: nil)
  generation ||= journal["convergence_generation"]
  return false unless generation.to_s.match?(MOVING_CHANNEL_GENERATION_PATTERN)

  target = { "channel" => channel, "value" => value, "generation" => generation }
  marker = journal["mutation_in_flight"]
  return true if marker.is_a?(Hash) && marker["target"] == target

  settled = journal.fetch("settled_mutations", [])
  unless settled.is_a?(Array)
    raise ReleaseStateError, "Authenticated moving-channel settlement inventory is invalid"
  end
  return true if settled.any? { _1.is_a?(Hash) && _1["target"] == target }

  completed = journal.dig("completed_steps", channel)
  completed.is_a?(Hash) && completed["outcome"] == "complete" &&
    completed["value"] == value && completed["generation"] == generation
end

def capture_moving_channel_previous!(journal:, channel:, current:, target:)
  if current == target && !authenticated_moving_channel_target?(
      journal, channel:, value: target
    )
    raise ReleaseStateError,
      "#{channel} already matched its target before an authenticated previous value was captured"
  end
  current
end

def git_ancestor?(ancestor, descendant)
  _stdout, _stderr, status = Open3.capture3(
    "git", "merge-base", "--is-ancestor", ancestor, descendant
  )
  status.success?
rescue SystemCallError
  false
end

def release_main_state(remote:, sha:, reconciling:)
  remote_main_sha = capture!("git", "rev-parse", "#{remote}/main")
  release_sha_ancestor_of_main = sha == remote_main_sha
  if reconciling && !release_sha_ancestor_of_main
    release_sha_ancestor_of_main = git_ancestor?(sha, remote_main_sha)
  end
  { remote_main_sha:, release_sha_ancestor_of_main: }
end

def validate_release_main_position!(sha:, remote_main_sha:, reconciling:,
    release_sha_ancestor_of_main:)
  if reconciling
    unless release_sha_ancestor_of_main
      raise ReleaseStateError,
        "Explicit reconciliation requires the authenticated release SHA to remain an ancestor of current main"
    end
  elsif sha != remote_main_sha
    raise ReleaseStateError, "A new release must start from current main"
  end
  true
end

def validate_release_entry!(reconciling:, resuming:, reconcile_sha:, git_sha:,
    existing_tag_sha:, release_public:, remote_main_sha:, release_sha_ancestor_of_main:)
  if reconciling && resuming
    raise ReleaseStateError, "RELEASE_RECONCILE_SHA and RELEASE_RESUME_SHA are mutually exclusive"
  end
  if resuming
    raise ReleaseStateError,
      "RELEASE_RESUME_SHA cannot authorize fresh history for an existing public tag; use explicit reconciliation"
  end
  if reconciling && reconcile_sha != git_sha
    raise ReleaseStateError, "RELEASE_RECONCILE_SHA must equal HEAD"
  end
  validate_release_main_position!(
    sha: git_sha, remote_main_sha:, reconciling:, release_sha_ancestor_of_main:
  )
  if existing_tag_sha && existing_tag_sha != git_sha
    raise ReleaseStateError, "Existing signed release tag does not point at HEAD"
  end
  if release_public && !reconciling
    raise ReleaseStateError, "An already-public release may be inspected only through explicit reconciliation"
  end
  if existing_tag_sha && !reconciling
    raise ReleaseStateError, "An existing signed tag requires explicit reconciliation with surviving authenticated history"
  end
  true
end

def validate_durable_release_entry!(state:, expected_release:, reconciling:, settled_mutation_token:,
    expected_anchor_set: nil, acquired: false)
  return true unless state

  ReleaseJournal.validate_format! state[:journal]
  settled_mutation_token = settled_mutation_token.to_s
  unless expected_release.all? { |key, value| state.dig(:journal, "release", key) == value }
    raise ReleaseStateError, "Another release owns the durable operation journal"
  end
  if expected_anchor_set && state.dig(:journal, "anchor_set") != expected_anchor_set
    raise ReleaseStateError, "Durable release state belongs to a different protected anchor set"
  end
  unless reconciling || acquired
    raise ReleaseStateError, "Durable release state already exists; use RELEASE_RECONCILE_SHA"
  end

  if marker = state.dig(:journal, "mutation_in_flight")
    marker = ReleaseMutationFence.validate_marker! marker
    unless settled_mutation_token == marker.fetch("token")
      raise ReleaseStateError,
        "Explicit reconciliation must confirm settled mutation token #{marker.fetch('token')} before continuing"
    end
  elsif !settled_mutation_token.empty?
    raise ReleaseStateError, "No in-flight mutation matches the supplied settled token"
  end
  true
end

def authenticated_release_notes(journal)
  notes = journal.fetch("release_notes")
  expected = journal.dig("phase_zero_artifacts", "notes_sha256")
  unless notes.is_a?(String) && !notes.strip.empty? && Digest::SHA256.hexdigest(notes) == expected
    raise ReleaseStateError, "Authenticated release notes do not match their phase-zero digest"
  end
  notes
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Authenticated phase-zero release notes are missing"
end

def workflow_dispatch_required!(reconciling:, candidates:, phase_previously_started: false,
    release_public: false)
  if reconciling && candidates.empty? && (phase_previously_started || release_public)
    raise ReleaseStateError,
      "Reconciliation found no original image workflow and will not dispatch a conflicting same-SHA build"
  end
  candidates.empty?
end

def parse_release_reconcile_action!(env: ENV, reconciling:)
  action = env["RELEASE_RECONCILE_ACTION"].to_s
  if reconciling
    unless RELEASE_RECONCILE_ACTIONS.include?(action)
      raise ReleaseStateError,
        "RELEASE_RECONCILE_ACTION must be explicitly set to complete or rollback"
    end
    action
  elsif action.empty?
    nil
  else
    raise ReleaseStateError, "RELEASE_RECONCILE_ACTION requires RELEASE_RECONCILE_SHA"
  end
end

def authenticate_reconcile_action!(lock:, journal:, action:, fault_after: ->(_boundary) { })
  return unless action

  scope = journal["channels"] ? "promotion" : "pre_promotion"
  existing = journal["reconcile_action"]
  if existing
    unless existing.is_a?(Hash) && existing.keys.sort == %w[ action authenticated_at generation scope ] &&
        RELEASE_RECONCILE_ACTIONS.include?(existing["action"]) &&
        %w[ pre_promotion promotion ].include?(existing["scope"]) &&
        existing["generation"].to_s.match?(MOVING_CHANNEL_GENERATION_PATTERN) &&
        existing["authenticated_at"].is_a?(String)
      raise ReleaseStateError, "Authenticated reconciliation action is invalid"
    end
    return existing if existing["action"] == action
    if existing["action"] == "rollback" || %w[ rolled_back abandoned ].include?(journal["status"])
      raise ReleaseStateError, "Authenticated rollback cannot be replaced by completion authority"
    end
  end

  request = {
    "action" => action,
    "scope" => scope,
    "generation" => SecureRandom.hex(16),
    "authenticated_at" => Time.now.utc.iso8601
  }
  journal["reconcile_action"] = request
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  fault_after.call "reconcile_action_authenticated"
  request
end

def abandon_pre_promotion_reconciliation!(lock:, journal:, action:,
    fault_after: ->(_boundary) { })
  return false unless action == "rollback"
  return false if journal["channels"]
  if release_phase_started?(journal, "promotion_prepared") ||
      release_phase_started?(journal, "promotion") ||
      release_phase_started?(journal, "publication")
    raise ReleaseStateError,
      "Promotion phase state exists without an authenticated moving-channel contract"
  end

  request = journal["reconcile_action"]
  unless request.is_a?(Hash) && request["action"] == "rollback" &&
      request["generation"].to_s.match?(MOVING_CHANNEL_GENERATION_PATTERN)
    raise ReleaseStateError, "Pre-promotion abandonment requires an authenticated rollback action"
  end
  if journal["status"] == "abandoned"
    phase = journal.dig("phases", "abandonment")
    unless phase.is_a?(Hash) && phase["status"] == "completed" &&
        phase.dig("data", "action_generation") == request["generation"]
      raise ReleaseStateError, "Authenticated pre-promotion abandonment state is invalid"
    end
    return true
  end
  if ReleaseLock::TERMINAL_STATUSES.include?(journal["status"])
    raise ReleaseStateError, "A terminal release operation cannot be reclassified as abandoned"
  end

  data = {
    "action" => "rollback", "scope" => "pre_promotion",
    "action_generation" => request["generation"]
  }
  unless release_phase_started?(journal, "abandonment")
    start_release_phase! lock, journal, "abandonment", data
  end
  unless journal.dig("phases", "abandonment", "data") == data
    raise ReleaseStateError, "Authenticated pre-promotion abandonment contract changed"
  end
  fault_after.call "pre_promotion_abandon_started"

  started_at = journal.dig("phases", "abandonment", "started_at")
  now = Time.now.utc.iso8601
  journal["phases"]["abandonment"] = {
    "status" => "completed", "data" => data, "started_at" => started_at,
    "completed_at" => now
  }
  journal["phase"] = "abandonment"
  journal["outcome"] = "rollback"
  journal["status"] = "abandoned"
  journal["completed_steps"] = {}
  journal.delete "completion_authority"
  journal["completion_authority_invalidated_at"] ||= now
  journal["updated_at"] = now
  lock.write_journal journal
  fault_after.call "pre_promotion_abandoned"
  true
end

def release_phase_started?(journal, name)
  %w[ started completed ].include?(journal.dig("phases", name, "status"))
end

def release_phase_completed?(journal, name)
  journal.dig("phases", name, "status") == "completed"
end

def start_release_phase!(lock, journal, name, data = {})
  return journal.dig("phases", name, "data") || {} if release_phase_started?(journal, name)

  journal["phases"] ||= {}
  journal["phases"][name] = {
    "status" => "started", "data" => data, "started_at" => Time.now.utc.iso8601
  }
  journal["phase"] = name
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  data
end

def complete_release_phase!(lock, journal, name, data = {})
  journal["phases"] ||= {}
  started_at = journal.dig("phases", name, "started_at") || Time.now.utc.iso8601
  journal["phases"][name] = {
    "status" => "completed", "data" => data,
    "started_at" => started_at, "completed_at" => Time.now.utc.iso8601
  }
  journal["phase"] = name
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  data
end

def release_promotion_contract(release:, anchor_set:, workflow_run:, artifacts:, channels:)
  unless release.is_a?(Hash) && release.keys.sort == %w[ repository sha tag version ] &&
      workflow_run.is_a?(Hash) && workflow_run.keys.sort == %w[ operation_nonce run_attempt run_id ] &&
      workflow_run.fetch("operation_nonce").match?(/\A[0-9a-f]{64}\z/) &&
      workflow_run.fetch("run_id").match?(/\A[1-9][0-9]*\z/) &&
      workflow_run.fetch("run_attempt").match?(/\A[1-9][0-9]*\z/) &&
      anchor_set.is_a?(Hash) && anchor_set.fetch("sha256").match?(/\A[0-9a-f]{64}\z/) &&
      artifacts.is_a?(Hash) && channels.is_a?(Hash)
    raise ReleaseStateError, "Release promotion contract is invalid"
  end
  {
    "format_version" => RELEASE_JOURNAL_FORMAT_VERSION,
    "release" => JSON.parse(JSON.generate(release)),
    "anchor_set" => JSON.parse(JSON.generate(anchor_set)),
    "workflow_run" => JSON.parse(JSON.generate(workflow_run)),
    "artifacts" => JSON.parse(JSON.generate(artifacts)),
    "channels" => JSON.parse(JSON.generate(channels))
  }
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Release promotion contract is invalid"
end

def image_digest(reference)
  stdout, stderr, status = Open3.capture3(
    "docker", "buildx", "imagetools", "inspect", reference, "--format", "{{.Manifest.Digest}}"
  )
  return stdout.strip if status.success?
  return if [ stdout, stderr ].join.match?(/manifest unknown|manifest_unknown|no such manifest/i)

  abort "Release aborted: could not inspect #{reference}.\n#{stderr}#{stdout}"
end

def image_media_type(reference)
  manifest = JSON.parse(capture!("docker", "buildx", "imagetools", "inspect", reference, "--raw"))
  media_type = manifest.fetch("mediaType")
  unless media_type.is_a?(String) && media_type.start_with?("application/vnd.")
    raise ReleaseStateError, "Registry manifest media type is invalid for #{reference}"
  end
  media_type
rescue JSON::ParserError, KeyError
  raise ReleaseStateError, "Registry manifest media type is missing for #{reference}"
end

def canonical_github_repository(url)
  url = url.to_s.strip
  return EXPECTED_REPOSITORY if url.match?(%r{\Agit@github\.com:basecamp/once-campfire(?:\.git)?\z}i)

  uri = URI.parse(url)
  return unless uri.query.nil? && uri.fragment.nil? && uri.host&.casecmp?("github.com")

  valid_transport = case uri.scheme
  when "https"
    uri.userinfo.nil? && uri.port == 443
  when "ssh"
    uri.user == "git" && uri.password.nil? && [ nil, 22 ].include?(uri.port)
  else
    false
  end
  return unless valid_transport

  repository = uri.path.delete_prefix("/").delete_suffix(".git")
  EXPECTED_REPOSITORY if repository.casecmp?(EXPECTED_REPOSITORY) &&
    uri.path.match?(%r{\A/basecamp/once-campfire(?:\.git)?\z}i)
rescue URI::InvalidURIError
  nil
end

def github_repository(remote)
  url_groups = [
    capture!("git", "remote", "get-url", "--all", remote),
    capture!("git", "remote", "get-url", "--push", "--all", remote)
  ].map { _1.lines.map(&:strip).reject(&:empty?) }
  urls = url_groups.flatten.uniq
  repositories = urls.map { canonical_github_repository(_1) }
  unless url_groups.all?(&:any?) && repositories.all? { _1 == EXPECTED_REPOSITORY }
    abort "Release aborted: every fetch and push URL for #{remote} must be the canonical #{EXPECTED_REPOSITORY} GitHub repository."
  end

  EXPECTED_REPOSITORY
end

def generated_release_notes!(repository:, tag:, target_commitish:)
  version = tag.delete_prefix("v")
  unless repository == EXPECTED_REPOSITORY && tag == "v#{version}" &&
      version.match?(STABLE_VERSION) && target_commitish.match?(/\A[0-9a-f]{40}\z/)
    raise ReleaseStateError, "Generated release notes identity is invalid"
  end

  response = capture!(
    "gh", "api", "--method", "POST", "repos/#{repository}/releases/generate-notes",
    "--raw-field", "tag_name=#{tag}", "--raw-field", "target_commitish=#{target_commitish}"
  )
  payload = JSON.parse(response)
  body = payload["body"] if payload.is_a?(Hash)
  unless body.is_a?(String) && !body.strip.empty?
    raise ReleaseStateError, "GitHub returned empty generated release notes"
  end
  body
rescue JSON::ParserError
  raise ReleaseStateError, "GitHub returned invalid generated release notes"
end

def remote_tag_sha(remote, tag)
  output = capture!("git", "ls-remote", "--tags", remote, "refs/tags/#{tag}", "refs/tags/#{tag}^{}")
  lines = output.lines.map(&:split)
  dereferenced = lines.find { _1.fetch(1).end_with?("^{}") }
  (dereferenced || lines.first)&.first
end

def verify_platforms!(reference)
  manifest = JSON.parse(capture!("docker", "buildx", "imagetools", "inspect", reference, "--raw"))
  platforms = manifest.fetch("manifests").reject do |entry|
    entry.fetch("annotations", {})["vnd.docker.reference.type"] == "attestation-manifest"
  end.map do |entry|
    platform = entry.fetch("platform")
    "#{platform.fetch('os')}/#{platform.fetch('architecture')}"
  end.uniq.sort
  abort "Release aborted: unexpected image platforms #{platforms.join(', ')}." unless platforms == %w[ linux/amd64 linux/arm64 ]
end

def workflow_dispatch_title(tag:, sha:, operation_nonce:)
  version = tag.delete_prefix("v")
  unless tag == "v#{version}" && version.match?(STABLE_VERSION) &&
      sha.match?(/\A[0-9a-f]{40}\z/) && operation_nonce.match?(/\A[0-9a-f]{64}\z/)
    raise ReleaseStateError, "Workflow dispatch identity is invalid"
  end
  "Campfire release #{tag} #{sha} #{operation_nonce}"
end

def wait_for_workflow!(repository:, event:, sha:, branch:, release_tag:, operation_nonce:,
    excluded_ids: [], allow_rerun: true)
  deadline = Time.now + 600
  run = nil
  expected_title = workflow_dispatch_title(tag: release_tag, sha:, operation_nonce:)
  until run || Time.now >= deadline
    runs = JSON.parse(capture!(
      "gh", "run", "list", "--repo", repository, "--workflow", "publish-image.yml",
      "--event", event, "--branch", branch, "--limit", "100",
      "--json", "attempt,conclusion,databaseId,displayTitle,event,headBranch,headSha,status"
    ))
    matches = runs.select do |candidate|
      candidate.fetch("headSha") == sha && candidate.fetch("headBranch") == branch &&
        candidate.fetch("event") == event && candidate.fetch("displayTitle") == expected_title &&
        !excluded_ids.include?(candidate.fetch("databaseId"))
    end
    if matches.length > 1
      abort "Release aborted: operation nonce matched more than one image workflow run."
    end
    run = matches.first if matches.one?
    sleep 5 unless run
  end
  abort "Release aborted: timed out waiting for the #{event} image workflow." unless run

  rerun_after_attempt = nil
  if run.fetch("status") == "completed"
    unless run.fetch("conclusion") == "success"
      unless allow_rerun
        abort "Release aborted: original image workflow #{run.fetch('databaseId')} did not succeed; reconciliation will not rebuild it."
      end
      rerun_after_attempt = Integer(run.fetch("attempt"))
      run!("gh", "run", "rerun", run.fetch("databaseId").to_s, "--repo", repository)
    end
  end

  deadline = Time.now + 3600
  loop do
    state = JSON.parse(capture!(
      "gh", "run", "view", run.fetch("databaseId").to_s, "--repo", repository,
      "--json", "attempt,status,conclusion"
    ))
    if rerun_after_attempt && Integer(state.fetch("attempt")) <= rerun_after_attempt
      abort "Release aborted: timed out waiting for workflow rerun #{run.fetch('databaseId')}." if Time.now >= deadline
      sleep 10
      next
    end
    break if state.fetch("status") == "completed" && state.fetch("conclusion") == "success"
    if state.fetch("status") == "completed"
      abort "Release aborted: image workflow #{run.fetch('databaseId')} failed after retry."
    end
    abort "Release aborted: timed out waiting for image workflow #{run.fetch('databaseId')}." if Time.now >= deadline
    sleep 10
  end
  run.fetch("databaseId")
end

def workflow_ids(repository, event, sha, branch, release_tag:, operation_nonce:)
  expected_title = workflow_dispatch_title(tag: release_tag, sha:, operation_nonce:)
  JSON.parse(capture!(
    "gh", "run", "list", "--repo", repository, "--workflow", "publish-image.yml",
    "--event", event, "--branch", branch, "--limit", "100",
    "--json", "databaseId,displayTitle,event,headBranch,headSha"
  )).filter_map do |candidate|
    candidate.fetch("databaseId") if candidate.fetch("headSha") == sha &&
      candidate.fetch("headBranch") == branch && candidate.fetch("event") == event &&
      candidate.fetch("displayTitle") == expected_title
  end
end

def validated_workflow_run!(repository:, run_id:, sha:, release_tag:, operation_nonce:, attempt: nil)
  workflow = JSON.parse(capture!(
    "gh", "run", "view", run_id.to_s, "--repo", repository,
    "--json", "attempt,conclusion,databaseId,displayTitle,event,headBranch,headSha,status,workflowName"
  ))
  expected = {
    "databaseId" => Integer(run_id), "headBranch" => "main", "headSha" => sha,
    "event" => "workflow_dispatch", "status" => "completed", "conclusion" => "success",
    "workflowName" => PUBLISH_WORKFLOW_NAME,
    "displayTitle" => workflow_dispatch_title(tag: release_tag, sha:, operation_nonce:)
  }
  unless expected.all? { |key, value| workflow.fetch(key) == value }
    abort "Release aborted: reconciliation workflow does not match the interrupted release."
  end
  actual_attempt = workflow.fetch("attempt")
  unless actual_attempt.is_a?(Integer) && actual_attempt.positive?
    abort "Release aborted: workflow run attempt is invalid."
  end
  if attempt && actual_attempt != Integer(attempt)
    abort "Release aborted: workflow run attempt changed; refusing latest-attempt evidence."
  end
  workflow
rescue KeyError, ArgumentError
  abort "Release aborted: workflow run metadata is invalid."
end

def authenticated_retained_workflow_identity!(journal)
  if journal["workflow_evidence"] && journal["workflow_evidence_pending"]
    raise ReleaseStateError, "Workflow evidence cannot be pending and retained simultaneously"
  end
  contract = journal["workflow_evidence"] || journal["workflow_evidence_pending"]
  return unless contract

  unless contract.is_a?(Hash) &&
      contract.keys.sort == %w[ files format_version operation_nonce run_attempt run_id ] &&
      contract["format_version"] == ReleaseObjectLockAnchors::EVIDENCE_FORMAT_VERSION &&
      contract["operation_nonce"].to_s.match?(/\A[0-9a-f]{64}\z/) &&
      contract["run_id"].to_s.match?(/\A[1-9][0-9]*\z/) &&
      contract["run_attempt"].to_s.match?(/\A[1-9][0-9]*\z/) &&
      contract["files"].is_a?(Hash) && contract["files"].any?
    raise ReleaseStateError, "Authenticated retained workflow identity is invalid"
  end
  identity = contract.slice("run_id", "run_attempt", "operation_nonce")
  phase_identity = journal.dig("phases", "workflow", "data")&.slice(
    "run_id", "run_attempt", "operation_nonce"
  )
  if phase_identity && phase_identity.values.any? && phase_identity != identity
    raise ReleaseStateError,
      "Retained workflow identity differs from the authenticated workflow phase"
  end
  if journal["workflow_run"] && journal["workflow_run"] != identity
    raise ReleaseStateError,
      "Retained workflow identity differs from the authenticated promotion contract"
  end
  identity
end

def atomic_no_replace_rename_command(source, destination)
  program = <<~RUBY
    source, destination = ARGV
    begin
      address = Fiddle::Handle::DEFAULT["renameat2"]
    rescue Fiddle::DLError
      warn "renameat2(RENAME_NOREPLACE) is unavailable"
      exit 70
    end
    renameat2 = Fiddle::Function.new(
      address,
      [ Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP, Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP, Fiddle::TYPE_INT ],
      Fiddle::TYPE_INT
    )
    exit 0 if renameat2.call(-100, source, -100, destination, 1).zero?

    error = Fiddle.last_error
    warn SystemCallError.new("renameat2(RENAME_NOREPLACE)", error).message
    exit 1
  RUBY
  loader = "eval(Base64.strict_decode64(ARGV.shift), TOPLEVEL_BINDING, '(renameat2)')"
  [
    "ruby", "-rfiddle", "-rbase64", "-e", loader, "--",
    Base64.strict_encode64(program), source, destination
  ].shelljoin
end

def stream_file_to_remote!(local_path, host, command)
  stdin, stdout, stderr, wait_thread = Open3.popen3(
    "ssh", "#{EXPORT_REMOTE_USER}@#{host}", command
  )
  stdout_reader = Thread.new { stdout.read }
  stderr_reader = Thread.new { stderr.read }
  File.open(local_path, "rb") { IO.copy_stream(_1, stdin) }
  stdin.close
  status = wait_thread.value
  output = stdout_reader.value
  error = stderr_reader.value
  abort "Release aborted: remote staging upload failed for #{host}.\n#{error}#{output}" unless status.success?
  output.strip
ensure
  stdin&.close unless stdin&.closed?
  stdout&.close unless stdout&.closed?
  stderr&.close unless stderr&.closed?
end

def upload_remote_temporary!(local_path, host, prefix)
  expected_digest = Digest::SHA256.file(local_path).hexdigest
  expected_bytes = File.size(local_path)
  temporary = "#{prefix}.#{SecureRandom.hex(16)}.tmp"
  command = "set -eu; umask 077; " \
    "test ! -e #{Shellwords.escape(temporary)}; test ! -L #{Shellwords.escape(temporary)}; " \
    "set -C; exec 9>#{Shellwords.escape(temporary)}; set +C; cat >&9; exec 9>&-; " \
    "test -f #{Shellwords.escape(temporary)}; test ! -L #{Shellwords.escape(temporary)}; " \
    "test \"$(stat -c %h #{Shellwords.escape(temporary)})\" -eq 1; " \
    "test \"$(wc -c < #{Shellwords.escape(temporary)} | tr -d ' ')\" = #{expected_bytes}; " \
    "test \"$(sha256sum #{Shellwords.escape(temporary)} | cut -d' ' -f1)\" = #{Shellwords.escape(expected_digest)}; " \
    "sync -d #{Shellwords.escape(temporary)}; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
    "sha256sum #{Shellwords.escape(temporary)}"
  output = stream_file_to_remote! local_path, host, command
  unless output.split.first == expected_digest
    abort "Release aborted: remote staging upload #{host}:#{temporary} failed verification."
  end
  [ temporary, expected_digest ]
end

def upload_immutable(local_path, remote_name, revision)
  expected_digest = Digest::SHA256.file(local_path).hexdigest
  EXPORT_DEPLOY_HOSTS.each do |host|
    destination = File.join(EXPORT_DEPLOY_LOCATION, remote_name)
    temporary = File.join(EXPORT_DEPLOY_LOCATION, ".#{remote_name}.#{revision}.tmp")
    temporary_prefix = temporary.delete_suffix(".tmp")
    inspection = capture!(
      "ssh", "#{EXPORT_REMOTE_USER}@#{host}",
      "set -eu; if test ! -e #{Shellwords.escape(destination)} && test ! -L #{Shellwords.escape(destination)}; then echo ABSENT; " \
        "elif test -f #{Shellwords.escape(destination)} && test ! -L #{Shellwords.escape(destination)}; then " \
        "links=$(stat -c %h #{Shellwords.escape(destination)}); " \
        "if test \"$links\" -eq 2; then prefix=#{Shellwords.escape(temporary_prefix)}; candidate=; count=0; " \
        "for entry in \"$prefix\".*.tmp; do if test -e \"$entry\" || test -L \"$entry\"; then " \
        "test -f \"$entry\"; test ! -L \"$entry\"; suffix=${entry#\"$prefix\".}; " \
        "token=${suffix%.tmp}; test \"${#token}\" -eq 32; " \
        "test -z \"$(printf '%s' \"$token\" | tr -d '0-9a-f')\"; " \
        "if test \"$entry\" -ef #{Shellwords.escape(destination)}; then candidate=$entry; count=$((count + 1)); fi; fi; done; " \
        "test \"$count\" -eq 1; test \"$candidate\" -ef #{Shellwords.escape(destination)}; " \
        "test \"$(stat -c %h \"$candidate\")\" -eq 2; " \
        "test \"$(sha256sum \"$candidate\" | cut -d' ' -f1)\" = #{Shellwords.escape(expected_digest)}; " \
        "rm -- \"$candidate\"; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; fi; " \
        "test \"$(stat -c %h #{Shellwords.escape(destination)})\" -eq 1; " \
        "test \"$(stat -c %u #{Shellwords.escape(destination)})\" = \"$(id -u)\"; " \
        "chgrp \"$(id -g)\" #{Shellwords.escape(destination)}; chmod 0444 #{Shellwords.escape(destination)}; " \
        "test \"$(stat -c %g #{Shellwords.escape(destination)})\" = \"$(id -g)\"; " \
        "test \"$(stat -c %a #{Shellwords.escape(destination)})\" = 444; " \
        "sync -d #{Shellwords.escape(destination)}; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
        "sha256sum #{Shellwords.escape(destination)}; " \
        "else echo 'Existing export is not a regular file' >&2; exit 1; fi"
    )
    unless inspection == "ABSENT"
      existing_digest = inspection.split.first
      abort "Release aborted: invalid checksum response for #{host}:#{destination}." unless existing_digest&.match?(/\A[0-9a-f]{64}\z/)
      abort "Release aborted: immutable export #{host}:#{destination} differs." unless existing_digest == expected_digest
      next
    end

    temporary, = upload_remote_temporary! local_path, host, temporary_prefix
    output = capture! "ssh", "#{EXPORT_REMOTE_USER}@#{host}",
      "set -eu; test ! -e #{Shellwords.escape(destination)}; test ! -L #{Shellwords.escape(destination)}; " \
      "test -f #{Shellwords.escape(temporary)}; test ! -L #{Shellwords.escape(temporary)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(temporary)})\" -eq 1; " \
      "test \"$(sha256sum #{Shellwords.escape(temporary)} | cut -d' ' -f1)\" = #{Shellwords.escape(expected_digest)}; " \
      "if ln -T #{Shellwords.escape(temporary)} #{Shellwords.escape(destination)}; then " \
      "test #{Shellwords.escape(temporary)} -ef #{Shellwords.escape(destination)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(destination)})\" -eq 2; " \
      "sync -d #{Shellwords.escape(destination)}; rm #{Shellwords.escape(temporary)}; " \
      "else test -f #{Shellwords.escape(destination)}; test ! -L #{Shellwords.escape(destination)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(destination)})\" -eq 1; " \
      "test \"$(sha256sum #{Shellwords.escape(destination)} | cut -d' ' -f1)\" = #{Shellwords.escape(expected_digest)}; " \
      "rm #{Shellwords.escape(temporary)}; fi; " \
      "test -f #{Shellwords.escape(destination)}; test ! -L #{Shellwords.escape(destination)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(destination)})\" -eq 1; " \
      "test \"$(stat -c %u #{Shellwords.escape(destination)})\" = \"$(id -u)\"; " \
      "chgrp \"$(id -g)\" #{Shellwords.escape(destination)}; chmod 0444 #{Shellwords.escape(destination)}; " \
      "test \"$(stat -c %g #{Shellwords.escape(destination)})\" = \"$(id -g)\"; " \
      "test \"$(stat -c %a #{Shellwords.escape(destination)})\" = 444; " \
      "sync -d #{Shellwords.escape(destination)}; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
      "sha256sum #{Shellwords.escape(destination)}"
    unless output.split.first == expected_digest
      abort "Release aborted: immutable export #{host}:#{destination} failed post-write verification."
    end
  end
end

def stage_static_release!(archive_path, checksum_path, version, revision)
  target_name = "campfire-#{version}"
  EXPORT_DEPLOY_HOSTS.each do |host|
    archive_prefix = File.join(EXPORT_DEPLOY_LOCATION, ".campfire.zip.#{revision}")
    checksum_prefix = File.join(EXPORT_DEPLOY_LOCATION, ".campfire.zip.sha256.#{revision}")
    archive_temporary, archive_digest = upload_remote_temporary! archive_path, host, archive_prefix
    checksum_temporary, checksum_digest = upload_remote_temporary! checksum_path, host, checksum_prefix
    staging_name = ".#{target_name}.#{revision}.#{SecureRandom.hex(16)}.tmp"
    staging_path = File.join(EXPORT_DEPLOY_LOCATION, staging_name)
    target_path = File.join(EXPORT_DEPLOY_LOCATION, target_name)
    staged_archive = File.join(staging_path, "campfire.zip")
    staged_checksum = File.join(staging_path, "campfire.zip.sha256")
    target_archive = File.join(target_path, "campfire.zip")
    target_checksum = File.join(target_path, "campfire.zip.sha256")
    rename = atomic_no_replace_rename_command(staging_path, target_path)
    command = <<~SH.gsub("\n", " ")
      set -eu; umask 077;
      cd #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)};
      test -f #{Shellwords.escape(archive_temporary)}; test ! -L #{Shellwords.escape(archive_temporary)};
      test "$(stat -c %h #{Shellwords.escape(archive_temporary)})" -eq 1;
      test "$(sha256sum #{Shellwords.escape(archive_temporary)} | cut -d' ' -f1)" = #{Shellwords.escape(archive_digest)};
      test -f #{Shellwords.escape(checksum_temporary)}; test ! -L #{Shellwords.escape(checksum_temporary)};
      test "$(stat -c %h #{Shellwords.escape(checksum_temporary)})" -eq 1;
      test "$(sha256sum #{Shellwords.escape(checksum_temporary)} | cut -d' ' -f1)" = #{Shellwords.escape(checksum_digest)};
      deploy_uid=$(id -u); deploy_gid=$(id -g);
      test -L campfire.zip; test "$(readlink campfire.zip)" = "campfire-current/campfire.zip";
      test -L campfire.zip.sha256; test "$(readlink campfire.zip.sha256)" = "campfire-current/campfire.zip.sha256";
      test -L campfire-current;
      current_target=$(readlink campfire-current);
      printf '%s\n' "$current_target" | grep -Eq '^campfire-(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$';
      test -d "$current_target"; test ! -L "$current_target";
      test -z "$(find "$current_target" -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)";
      test "$(find "$current_target" -mindepth 1 -maxdepth 1 -print | wc -l)" -eq 2;
      test -f "$current_target/campfire.zip"; test ! -L "$current_target/campfire.zip";
      test -f "$current_target/campfire.zip.sha256"; test ! -L "$current_target/campfire.zip.sha256";
      test "$(stat -c %h "$current_target/campfire.zip")" -eq 1;
      test "$(stat -c %h "$current_target/campfire.zip.sha256")" -eq 1;
      test "$(stat -c %u "$current_target")" = "$deploy_uid";
      test "$(stat -c %u "$current_target/campfire.zip")" = "$deploy_uid";
      test "$(stat -c %u "$current_target/campfire.zip.sha256")" = "$deploy_uid";
      chgrp "$deploy_gid" "$current_target" "$current_target/campfire.zip" "$current_target/campfire.zip.sha256";
      chmod 0444 "$current_target/campfire.zip" "$current_target/campfire.zip.sha256";
      chmod 0555 "$current_target";
      test "$(stat -c %a "$current_target")" = 555;
      test "$(stat -c %a "$current_target/campfire.zip")" = 444;
      test "$(stat -c %a "$current_target/campfire.zip.sha256")" = 444;
      test "$(stat -c %g "$current_target")" = "$deploy_gid";
      test "$(stat -c %g "$current_target/campfire.zip")" = "$deploy_gid";
      test "$(stat -c %g "$current_target/campfire.zip.sha256")" = "$deploy_gid";
      test campfire.zip -ef "$current_target/campfire.zip";
      test campfire.zip.sha256 -ef "$current_target/campfire.zip.sha256";
      current_archive_digest=$(sha256sum "$current_target/campfire.zip" | cut -d' ' -f1);
      test "$(wc -c < "$current_target/campfire.zip.sha256" | tr -d ' ')" = 79;
      test "$(cat "$current_target/campfire.zip.sha256")" = "$current_archive_digest  campfire.zip";
      sha256sum --check campfire.zip.sha256;
      if test -e #{Shellwords.escape(target_path)} || test -L #{Shellwords.escape(target_path)}; then
        test -d #{Shellwords.escape(target_path)}; test ! -L #{Shellwords.escape(target_path)};
        test -z "$(find #{Shellwords.escape(target_path)} -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)";
        test "$(find #{Shellwords.escape(target_path)} -mindepth 1 -maxdepth 1 -print | wc -l)" -eq 2;
        test -f #{Shellwords.escape(target_archive)}; test ! -L #{Shellwords.escape(target_archive)};
        test "$(stat -c %h #{Shellwords.escape(target_archive)})" -eq 1;
        test -f #{Shellwords.escape(target_checksum)}; test ! -L #{Shellwords.escape(target_checksum)};
        test "$(stat -c %h #{Shellwords.escape(target_checksum)})" -eq 1;
        test "$(sha256sum #{Shellwords.escape(target_archive)} | cut -d' ' -f1)" = #{Shellwords.escape(Digest::SHA256.file(archive_path).hexdigest)};
        test "$(sha256sum #{Shellwords.escape(target_checksum)} | cut -d' ' -f1)" = #{Shellwords.escape(Digest::SHA256.file(checksum_path).hexdigest)};
        rm #{Shellwords.escape(archive_temporary)} #{Shellwords.escape(checksum_temporary)};
      else
        test ! -e #{Shellwords.escape(staging_path)}; test ! -L #{Shellwords.escape(staging_path)};
        mkdir #{Shellwords.escape(staging_path)};
        ln -T #{Shellwords.escape(archive_temporary)} #{Shellwords.escape(staged_archive)};
        test #{Shellwords.escape(archive_temporary)} -ef #{Shellwords.escape(staged_archive)};
        test "$(stat -c %h #{Shellwords.escape(staged_archive)})" -eq 2;
        sync -d #{Shellwords.escape(staged_archive)}; rm #{Shellwords.escape(archive_temporary)};
        test "$(stat -c %h #{Shellwords.escape(staged_archive)})" -eq 1;
        ln -T #{Shellwords.escape(checksum_temporary)} #{Shellwords.escape(staged_checksum)};
        test #{Shellwords.escape(checksum_temporary)} -ef #{Shellwords.escape(staged_checksum)};
        test "$(stat -c %h #{Shellwords.escape(staged_checksum)})" -eq 2;
        sync -d #{Shellwords.escape(staged_checksum)}; rm #{Shellwords.escape(checksum_temporary)};
        test "$(stat -c %h #{Shellwords.escape(staged_checksum)})" -eq 1;
        test "$(find #{Shellwords.escape(staging_path)} -mindepth 1 -maxdepth 1 -print | wc -l)" -eq 2;
        (cd #{Shellwords.escape(staging_path)} && sha256sum --check campfire.zip.sha256);
        sync -f #{Shellwords.escape(staging_path)};
        #{rename};
      fi;
      test -d #{Shellwords.escape(target_path)}; test ! -L #{Shellwords.escape(target_path)};
      test "$(find #{Shellwords.escape(target_path)} -mindepth 1 -maxdepth 1 -print | wc -l)" -eq 2;
      test -f #{Shellwords.escape(target_archive)}; test ! -L #{Shellwords.escape(target_archive)};
      test "$(stat -c %h #{Shellwords.escape(target_archive)})" -eq 1;
      test -f #{Shellwords.escape(target_checksum)}; test ! -L #{Shellwords.escape(target_checksum)};
      test "$(stat -c %h #{Shellwords.escape(target_checksum)})" -eq 1;
      test "$(sha256sum #{Shellwords.escape(target_archive)} | cut -d' ' -f1)" = #{Shellwords.escape(archive_digest)};
      test "$(sha256sum #{Shellwords.escape(target_checksum)} | cut -d' ' -f1)" = #{Shellwords.escape(checksum_digest)};
      test "$(stat -c %u #{Shellwords.escape(target_path)})" = "$deploy_uid";
      test "$(stat -c %u #{Shellwords.escape(target_archive)})" = "$deploy_uid";
      test "$(stat -c %u #{Shellwords.escape(target_checksum)})" = "$deploy_uid";
      chgrp "$deploy_gid" #{Shellwords.escape(target_path)} #{Shellwords.escape(target_archive)} #{Shellwords.escape(target_checksum)};
      chmod 0444 #{Shellwords.escape(target_archive)} #{Shellwords.escape(target_checksum)};
      chmod 0555 #{Shellwords.escape(target_path)};
      test "$(stat -c %a #{Shellwords.escape(target_path)})" = 555;
      test "$(stat -c %a #{Shellwords.escape(target_archive)})" = 444;
      test "$(stat -c %a #{Shellwords.escape(target_checksum)})" = 444;
      test "$(stat -c %g #{Shellwords.escape(target_path)})" = "$deploy_gid";
      test "$(stat -c %g #{Shellwords.escape(target_archive)})" = "$deploy_gid";
      test "$(stat -c %g #{Shellwords.escape(target_checksum)})" = "$deploy_gid";
      sync -d #{Shellwords.escape(target_archive)} #{Shellwords.escape(target_checksum)};
      sync -f #{Shellwords.escape(target_path)};
      sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)};
      (cd #{Shellwords.escape(target_path)} && sha256sum --check campfire.zip.sha256);
      test "$(wc -c < #{Shellwords.escape(target_checksum)} | tr -d ' ')" = 79;
      test "$(cat #{Shellwords.escape(target_checksum)})" = "#{archive_digest}  campfire.zip";
      if test "$(readlink campfire-current)" = #{Shellwords.escape(target_name)}; then
        test campfire.zip -ef #{Shellwords.escape(target_archive)};
        test campfire.zip.sha256 -ef #{Shellwords.escape(target_checksum)};
        test "$(sha256sum campfire.zip | cut -d' ' -f1)" = #{Shellwords.escape(archive_digest)};
        test "$(sha256sum campfire.zip.sha256 | cut -d' ' -f1)" = #{Shellwords.escape(checksum_digest)};
        sha256sum --check campfire.zip.sha256;
      fi;
    SH
    run! "ssh", "#{EXPORT_REMOTE_USER}@#{host}", command
  end
  target_name
end

def static_release_target(host)
  target = capture!(
    "ssh", "#{EXPORT_REMOTE_USER}@#{host}",
    "set -eu; cd #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
      "test -L campfire-current; test -L campfire.zip; " \
      "test \"$(readlink campfire.zip)\" = campfire-current/campfire.zip; " \
      "test -L campfire.zip.sha256; " \
      "test \"$(readlink campfire.zip.sha256)\" = campfire-current/campfire.zip.sha256; " \
      "target=$(readlink campfire-current); " \
      "printf '%s\\n' \"$target\" | grep -Eq '^campfire-(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$'; " \
      "test -d \"$target\"; test ! -L \"$target\"; " \
      "test -z \"$(find \"$target\" -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)\"; " \
      "test \"$(find \"$target\" -mindepth 1 -maxdepth 1 -print | wc -l)\" -eq 2; " \
      "test -f \"$target/campfire.zip\"; test ! -L \"$target/campfire.zip\"; " \
      "test -f \"$target/campfire.zip.sha256\"; test ! -L \"$target/campfire.zip.sha256\"; " \
      "test campfire.zip -ef \"$target/campfire.zip\"; " \
      "test campfire.zip.sha256 -ef \"$target/campfire.zip.sha256\"; " \
      "digest=$(sha256sum campfire.zip | cut -d' ' -f1); " \
      "test \"$(wc -c < campfire.zip.sha256 | tr -d ' ')\" = 79; " \
      "test \"$(cat campfire.zip.sha256)\" = \"$digest  campfire.zip\"; " \
      "sha256sum --check campfire.zip.sha256 >/dev/null; printf '%s\\n' \"$target\""
  )
  unless target.match?(/\Acampfire-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/)
    abort "Release aborted: invalid static pointer on #{host}: #{target.inspect}."
  end

  target
end

def static_release_file_digests(host, target_name)
  unless target_name.match?(/\Acampfire-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/)
    abort "Release aborted: invalid static release target #{target_name.inspect}."
  end

  target = File.join(EXPORT_DEPLOY_LOCATION, target_name)
  archive = File.join(target, "campfire.zip")
  checksum = File.join(target, "campfire.zip.sha256")
  output = capture!(
    "ssh", "#{EXPORT_REMOTE_USER}@#{host}",
    "set -eu; cd #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
      "test \"$(readlink campfire-current)\" = #{Shellwords.escape(target_name)}; " \
      "test -L campfire.zip; test \"$(readlink campfire.zip)\" = campfire-current/campfire.zip; " \
      "test -L campfire.zip.sha256; test \"$(readlink campfire.zip.sha256)\" = campfire-current/campfire.zip.sha256; " \
      "test -d #{Shellwords.escape(target)}; test ! -L #{Shellwords.escape(target)}; " \
      "test -z \"$(find #{Shellwords.escape(target)} -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)\"; " \
      "test \"$(find #{Shellwords.escape(target)} -mindepth 1 -maxdepth 1 -print | wc -l)\" -eq 2; " \
      "test -f #{Shellwords.escape(archive)}; test ! -L #{Shellwords.escape(archive)}; " \
      "test -f #{Shellwords.escape(checksum)}; test ! -L #{Shellwords.escape(checksum)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(archive)})\" -eq 1; " \
      "test \"$(stat -c %h #{Shellwords.escape(checksum)})\" -eq 1; " \
      "test \"$(stat -c %a #{Shellwords.escape(target)})\" = 555; " \
      "test \"$(stat -c %a #{Shellwords.escape(archive)})\" = 444; " \
      "test \"$(stat -c %a #{Shellwords.escape(checksum)})\" = 444; " \
      "test \"$(stat -c %u #{Shellwords.escape(target)})\" = \"$(id -u)\"; " \
      "test \"$(stat -c %u #{Shellwords.escape(archive)})\" = \"$(id -u)\"; " \
      "test \"$(stat -c %u #{Shellwords.escape(checksum)})\" = \"$(id -u)\"; " \
      "test \"$(stat -c %g #{Shellwords.escape(target)})\" = \"$(id -g)\"; " \
      "test \"$(stat -c %g #{Shellwords.escape(archive)})\" = \"$(id -g)\"; " \
      "test \"$(stat -c %g #{Shellwords.escape(checksum)})\" = \"$(id -g)\"; " \
      "test campfire.zip -ef #{Shellwords.escape(archive)}; " \
      "test campfire.zip.sha256 -ef #{Shellwords.escape(checksum)}; " \
      "test \"$(wc -c < #{Shellwords.escape(checksum)} | tr -d ' ')\" = 79; " \
      "test \"$(cat #{Shellwords.escape(checksum)})\" = \"$(sha256sum #{Shellwords.escape(archive)} | cut -d' ' -f1)  campfire.zip\"; " \
      "sha256sum --check campfire.zip.sha256 >/dev/null; " \
      "sha256sum #{Shellwords.escape(archive)} #{Shellwords.escape(checksum)}"
  )
  values = output.lines.map { _1.split.first }
  unless values.length == 2 && values.all? { _1.match?(/\A[0-9a-f]{64}\z/) }
    abort "Release aborted: invalid static artifact digest response from #{host}."
  end
  { "archive_sha256" => values.fetch(0), "checksum_sha256" => values.fetch(1) }
end

def verify_static_release_files!(host, target_name, archive_digest:, checksum_digest:)
  unless target_name.match?(/\Acampfire-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/)
    abort "Release aborted: invalid static release target #{target_name.inspect}."
  end

  target = File.join(EXPORT_DEPLOY_LOCATION, target_name)
  archive = File.join(target, "campfire.zip")
  checksum = File.join(target, "campfire.zip.sha256")
  command = "set -eu; cd #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
    "test -L campfire.zip; test \"$(readlink campfire.zip)\" = campfire-current/campfire.zip; " \
    "test -L campfire.zip.sha256; test \"$(readlink campfire.zip.sha256)\" = campfire-current/campfire.zip.sha256; " \
    "test -L campfire-current; " \
    "test -d #{Shellwords.escape(target)}; test ! -L #{Shellwords.escape(target)}; " \
    "test -z \"$(find #{Shellwords.escape(target)} -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)\"; " \
    "test \"$(find #{Shellwords.escape(target)} -mindepth 1 -maxdepth 1 -print | wc -l)\" -eq 2; " \
    "test -f #{Shellwords.escape(archive)}; test ! -L #{Shellwords.escape(archive)}; " \
    "test -f #{Shellwords.escape(checksum)}; test ! -L #{Shellwords.escape(checksum)}; " \
    "test \"$(stat -c %h #{Shellwords.escape(archive)})\" -eq 1; " \
    "test \"$(stat -c %h #{Shellwords.escape(checksum)})\" -eq 1; " \
    "test \"$(stat -c %a #{Shellwords.escape(target)})\" = 555; " \
    "test \"$(stat -c %a #{Shellwords.escape(archive)})\" = 444; " \
    "test \"$(stat -c %a #{Shellwords.escape(checksum)})\" = 444; " \
    "test \"$(stat -c %u #{Shellwords.escape(target)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %u #{Shellwords.escape(archive)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %u #{Shellwords.escape(checksum)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(target)})\" = \"$(id -g)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(archive)})\" = \"$(id -g)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(checksum)})\" = \"$(id -g)\"; " \
    "test \"$(sha256sum #{Shellwords.escape(archive)} | cut -d' ' -f1)\" = #{Shellwords.escape(archive_digest)}; " \
    "test \"$(sha256sum #{Shellwords.escape(checksum)} | cut -d' ' -f1)\" = #{Shellwords.escape(checksum_digest)}; " \
    "test \"$(wc -c < #{Shellwords.escape(checksum)} | tr -d ' ')\" = 79; " \
    "test \"$(cat #{Shellwords.escape(checksum)})\" = \"#{archive_digest}  campfire.zip\"; " \
    "(cd #{Shellwords.escape(target)} && sha256sum --check campfire.zip.sha256); " \
    "if test \"$(readlink campfire-current)\" = #{Shellwords.escape(target_name)}; then " \
    "test campfire.zip -ef #{Shellwords.escape(archive)}; " \
    "test campfire.zip.sha256 -ef #{Shellwords.escape(checksum)}; " \
    "test \"$(sha256sum campfire.zip | cut -d' ' -f1)\" = #{Shellwords.escape(archive_digest)}; " \
    "test \"$(sha256sum campfire.zip.sha256 | cut -d' ' -f1)\" = #{Shellwords.escape(checksum_digest)}; " \
    "sha256sum --check campfire.zip.sha256; fi"
  capture! "ssh", "#{EXPORT_REMOTE_USER}@#{host}", command
  true
end

def set_static_release_target!(host, target_name, revision, expected:, archive_digest:,
    checksum_digest:, runner:)
  unless target_name.match?(/\Acampfire-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/)
    raise ReleaseStateError, "Invalid static release target #{target_name.inspect}"
  end
  unless expected.match?(/\Acampfire-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z/)
    raise ReleaseStateError, "Invalid expected static release target #{expected.inspect}"
  end
  unless archive_digest.match?(/\A[0-9a-f]{64}\z/) && checksum_digest.match?(/\A[0-9a-f]{64}\z/)
    raise ReleaseStateError, "Invalid static release artifact digest"
  end

  temporary = ".campfire-current.#{revision}.tmp"
  pointer_lock = ".campfire-current.release.lock"
  target_archive = File.join(target_name, "campfire.zip")
  target_checksum = File.join(target_name, "campfire.zip.sha256")
  command = "set -eu; umask 077; cd #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
    "if test ! -e #{Shellwords.escape(pointer_lock)} && test ! -L #{Shellwords.escape(pointer_lock)}; then " \
    "(set -C; : > #{Shellwords.escape(pointer_lock)}) 2>/dev/null || true; fi; " \
    "test -f #{Shellwords.escape(pointer_lock)}; test ! -L #{Shellwords.escape(pointer_lock)}; " \
    "test \"$(stat -c %h #{Shellwords.escape(pointer_lock)})\" -eq 1; " \
    "exec 9<>#{Shellwords.escape(pointer_lock)}; flock -x 9; " \
    "test \"$(stat -Lc '%d:%i' /proc/$$/fd/9)\" = \"$(stat -Lc '%d:%i' #{Shellwords.escape(pointer_lock)})\"; " \
    "test -L campfire.zip; test \"$(readlink campfire.zip)\" = campfire-current/campfire.zip; " \
    "test -L campfire.zip.sha256; test \"$(readlink campfire.zip.sha256)\" = campfire-current/campfire.zip.sha256; " \
    "test \"$(readlink campfire-current)\" = #{Shellwords.escape(expected)}; " \
    "if test -e #{Shellwords.escape(temporary)} || test -L #{Shellwords.escape(temporary)}; then " \
    "test -L #{Shellwords.escape(temporary)}; rm #{Shellwords.escape(temporary)}; fi; " \
    "test -d #{Shellwords.escape(target_name)}; test ! -L #{Shellwords.escape(target_name)}; " \
    "test -z \"$(find #{Shellwords.escape(target_name)} -mindepth 1 -maxdepth 1 ! -name campfire.zip ! -name campfire.zip.sha256 -print -quit)\"; " \
    "test \"$(find #{Shellwords.escape(target_name)} -mindepth 1 -maxdepth 1 -print | wc -l)\" -eq 2; " \
    "test -f #{Shellwords.escape(target_archive)}; test ! -L #{Shellwords.escape(target_archive)}; " \
    "test -f #{Shellwords.escape(target_checksum)}; test ! -L #{Shellwords.escape(target_checksum)}; " \
    "test \"$(stat -c %h #{Shellwords.escape(target_archive)})\" -eq 1; " \
    "test \"$(stat -c %h #{Shellwords.escape(target_checksum)})\" -eq 1; " \
    "test \"$(stat -c %a #{Shellwords.escape(target_name)})\" = 555; " \
    "test \"$(stat -c %a #{Shellwords.escape(target_archive)})\" = 444; " \
    "test \"$(stat -c %a #{Shellwords.escape(target_checksum)})\" = 444; " \
    "test \"$(stat -c %u #{Shellwords.escape(target_name)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %u #{Shellwords.escape(target_archive)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %u #{Shellwords.escape(target_checksum)})\" = \"$(id -u)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(target_name)})\" = \"$(id -g)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(target_archive)})\" = \"$(id -g)\"; " \
    "test \"$(stat -c %g #{Shellwords.escape(target_checksum)})\" = \"$(id -g)\"; " \
    "test \"$(sha256sum #{Shellwords.escape(target_archive)} | cut -d' ' -f1)\" = #{Shellwords.escape(archive_digest)}; " \
    "test \"$(sha256sum #{Shellwords.escape(target_checksum)} | cut -d' ' -f1)\" = #{Shellwords.escape(checksum_digest)}; " \
    "test \"$(wc -c < #{Shellwords.escape(target_checksum)} | tr -d ' ')\" = 79; " \
    "test \"$(cat #{Shellwords.escape(target_checksum)})\" = \"#{archive_digest}  campfire.zip\"; " \
    "(cd #{Shellwords.escape(target_name)} && sha256sum --check campfire.zip.sha256); " \
    "sync -d #{Shellwords.escape(target_archive)} #{Shellwords.escape(target_checksum)}; " \
    "sync -f #{Shellwords.escape(target_name)}; " \
    "ln -s #{Shellwords.escape(target_name)} #{Shellwords.escape(temporary)}; " \
    "test \"$(readlink campfire-current)\" = #{Shellwords.escape(expected)}; " \
    "mv -Tf #{Shellwords.escape(temporary)} campfire-current; " \
    "sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
    "test \"$(readlink campfire-current)\" = #{Shellwords.escape(target_name)}; " \
    "test campfire.zip -ef #{Shellwords.escape(target_archive)}; " \
    "test campfire.zip.sha256 -ef #{Shellwords.escape(target_checksum)}; " \
    "test \"$(sha256sum campfire.zip | cut -d' ' -f1)\" = #{Shellwords.escape(archive_digest)}; " \
    "test \"$(sha256sum campfire.zip.sha256 | cut -d' ' -f1)\" = #{Shellwords.escape(checksum_digest)}; " \
    "sha256sum --check campfire.zip.sha256"
  mutate! "ssh", "#{EXPORT_REMOTE_USER}@#{host}", command, runner:
end

def ensure_latest_version!(version)
  stable_tags = capture!("git", "tag", "--list", "v*").lines.filter_map do |tag|
    value = tag.strip.delete_prefix("v")
    Gem::Version.new(value) if value.match?(STABLE_VERSION) && value != version
  end
  if stable_tags.any? && Gem::Version.new(version) <= stable_tags.max
    abort "Release aborted: #{version} does not advance the latest stable version #{stable_tags.max}."
  end
end

def revalidate_release_source!(remote:, sha:, version:, tag:, signer_fingerprint:, reconciling:)
  run! "git", "fetch", remote, "main", "--tags"
  validate_release_main_position!(
    sha:, reconciling:, **release_main_state(remote:, sha:, reconciling:)
  )
  ensure_latest_version! version
  unless remote_tag_sha(remote, tag) == sha
    raise ReleaseStateError, "Signed release tag changed after protected workflow evidence was produced"
  end
  local_tag_sha = capture!("git", "rev-list", "-n", "1", tag, allow_failure: true)
  unless local_tag_sha == sha
    raise ReleaseStateError, "Local signed release tag does not match protected workflow evidence"
  end
  verify_tag_signature! tag, signer_fingerprint
  true
end

def github_release(repository, tag)
  stdout, stderr, status = Open3.capture3(
    "gh", "release", "view", tag, "--repo", repository,
    "--json", "assets,body,isDraft,isPrerelease,name,tagName"
  )
  return JSON.parse(stdout) if status.success?
  return if stderr.match?(/release not found/i)

  abort "Release aborted: could not inspect GitHub release #{tag}.\n#{stderr}#{stdout}"
end

def github_latest_tag(repository)
  stdout, stderr, status = Open3.capture3("gh", "api", "repos/#{repository}/releases/latest")
  return JSON.parse(stdout).fetch("tag_name") if status.success?
  return if [ stdout, stderr ].join.match?(/404|not found/i)

  abort "Release aborted: could not inspect the latest GitHub release.\n#{stderr}#{stdout}"
end

def publish_github_release_without_latest!(repository:, tag:, runner:)
  unless repository == EXPECTED_REPOSITORY && tag.delete_prefix("v").match?(STABLE_VERSION) &&
      tag.start_with?("v")
    raise ReleaseStateError, "GitHub publication identity is invalid"
  end
  mutate! "gh", "release", "edit", tag, "--repo", repository,
    "--draft=false", "--prerelease=false", "--latest=false", runner:
end

def verify_tag_signature!(tag, expected_fingerprint)
  stdout, stderr, status = Open3.capture3("git", "verify-tag", "--raw", tag)
  abort "Release aborted: #{tag} does not have a valid signature.\n#{stderr}#{stdout}" unless status.success?

  valid_signatures = [ stdout, stderr ].join.lines.grep(/\[GNUPG:\] VALIDSIG /).map do |line|
    line.split.drop(2).select { _1.match?(/\A[0-9A-F]{40,64}\z/i) }.map(&:upcase)
  end.flatten
  unless valid_signatures.include?(expected_fingerprint)
    abort "Release aborted: #{tag} was not signed by allowlisted fingerprint #{expected_fingerprint}."
  end
end

def verify_manifest_children!(reference, expected_children)
  manifest = JSON.parse(capture!("docker", "buildx", "imagetools", "inspect", reference, "--raw"))
  actual = manifest.fetch("manifests").filter_map do |entry|
    next if entry.fetch("annotations", {})["vnd.docker.reference.type"] == "attestation-manifest"

    platform = entry.fetch("platform")
    [ platform.fetch("architecture"), entry.fetch("digest") ] if platform.fetch("os") == "linux"
  end.to_h
  abort "Release aborted: manifest child digests do not match recovery-tested images." unless actual == expected_children
end

def validate_exact_keys!(value, keys, description)
  unless value.is_a?(Hash) && value.keys.sort == keys.sort
    raise ReleaseStateError, "#{description} has an invalid exact-key schema"
  end
  value
end

def validate_digest_map!(value, description)
  validate_exact_keys! value, RELEASE_EVIDENCE_ARCHITECTURES, description
  unless value.values.all? { _1.is_a?(String) && _1.match?(/\Asha256:[0-9a-f]{64}\z/) }
    raise ReleaseStateError, "#{description} contains an invalid digest"
  end
  value
end

def validate_upgrade_receipt!(path, recovery, architecture)
  receipt = JSON.parse(File.binread(path))
  validate_exact_keys! receipt, %w[
    archive_bytes archive_path archive_sha256 authentication authentication_path
    authentication_sha256 backup_id created_at environment expires_at format_version
    installation_fingerprint kind migration source_manifest_sha256 source_schema_version
    source_state_sha256 target_build_identity target_revision
  ], "#{architecture} upgrade receipt"
  authentication = validate_exact_keys!(
    receipt.fetch("authentication"), %w[ algorithm key_id mac ],
    "#{architecture} upgrade receipt authentication"
  )
  unless receipt.fetch("format_version") == 2 && receipt.fetch("kind") == "campfire-upgrade-recovery" &&
      receipt.fetch("target_revision") == recovery.fetch("source_sha") &&
      receipt.fetch("target_build_identity") == recovery.fetch("target_build_identity") &&
      receipt.fetch("source_schema_version").to_s == recovery.fetch("source_schema_version") &&
      receipt.fetch("archive_bytes").is_a?(Integer) && receipt.fetch("archive_bytes").positive? &&
      %w[ archive_sha256 authentication_sha256 source_manifest_sha256 source_state_sha256 ].all? {
        receipt.fetch(_1).is_a?(String) && receipt.fetch(_1).match?(/\A[0-9a-f]{64}\z/)
      } && authentication.fetch("algorithm") == "HMAC-SHA256" &&
      authentication.fetch("key_id").match?(/\A[0-9a-f]{16}\z/) &&
      authentication.fetch("mac").match?(/\A[0-9a-f]{64}\z/)
    raise ReleaseStateError, "#{architecture} upgrade receipt contract is invalid"
  end
  receipt
rescue JSON::ParserError, KeyError, NoMethodError
  raise ReleaseStateError, "#{architecture} upgrade receipt is invalid"
end

def verify_retained_provenance_bundle!(bundle_path:, repository:, image:, digest:, source_sha:,
    runner: Open3.method(:capture3))
  unless repository == EXPECTED_REPOSITORY && image == "ghcr.io/#{repository.downcase}" &&
      digest.match?(/\Asha256:[0-9a-f]{64}\z/) && source_sha.match?(/\A[0-9a-f]{40}\z/)
    raise ReleaseStateError, "Retained provenance verification identity is invalid"
  end
  stat = File.lstat(bundle_path)
  unless stat.file? && !stat.symlink? && stat.nlink == 1 && stat.size.positive?
    raise ReleaseStateError, "Retained provenance bundle is not a fixed regular file"
  end

  certificate_identity =
    "https://github.com/#{repository}/.github/workflows/#{PUBLISH_WORKFLOW_FILE}@refs/heads/main"
  command = [
    "gh", "attestation", "verify", "oci://#{image}@#{digest}",
    "--bundle", bundle_path,
    "--repo", repository,
    "--cert-identity", certificate_identity,
    "--cert-oidc-issuer", "https://token.actions.githubusercontent.com",
    "--signer-workflow", "#{repository}/.github/workflows/#{PUBLISH_WORKFLOW_FILE}",
    "--signer-digest", source_sha,
    "--source-ref", "refs/heads/main",
    "--source-digest", source_sha,
    "--predicate-type", "https://slsa.dev/provenance/v1",
    "--deny-self-hosted-runners",
    "--format", "json"
  ]
  stdout, stderr, status = runner.call(*command)
  unless status.success?
    raise ReleaseStateError,
      "Cryptographic verification failed for retained provenance bundle #{File.basename(bundle_path)}: #{stderr}#{stdout}"
  end

  results = JSON.parse(stdout)
  expected_digest = digest.delete_prefix("sha256:")
  valid = results.is_a?(Array) && results.any? && results.all? do |result|
    statement = result.dig("verificationResult", "statement")
    statement.is_a?(Hash) &&
      statement["predicateType"] == "https://slsa.dev/provenance/v1" &&
      statement["subject"] == [ {
        "name" => image, "digest" => { "sha256" => expected_digest }
      } ]
  end
  unless valid
    raise ReleaseStateError,
      "Cryptographically verified provenance does not bind exact subject #{image}@#{digest}"
  end
  true
rescue JSON::ParserError, Errno::ENOENT, NoMethodError => error
  raise ReleaseStateError, "Retained provenance bundle verification is invalid: #{error.message}"
end

def verify_retained_release_provenance!(evidence:, destination:, repository:, image:, sha:,
    runner: Open3.method(:capture3))
  bundles = [
    [ "index-provenance.bundle.jsonl", evidence.fetch("index_digest") ],
    *RELEASE_EVIDENCE_ARCHITECTURES.flat_map do |architecture|
      [
        [ "parent-provenance-#{architecture}.bundle.jsonl",
          evidence.fetch("build_indexes").fetch(architecture) ],
        [ "runnable-provenance-#{architecture}.bundle.jsonl",
          evidence.fetch("children").fetch(architecture) ]
      ]
    end
  ]
  bundles.each do |name, digest|
    verify_retained_provenance_bundle!(
      bundle_path: File.join(destination, name), repository:, image:, digest:,
      source_sha: sha, runner:
    )
  end
  true
rescue KeyError, NoMethodError
  raise ReleaseStateError, "Retained provenance subject inventory is incomplete"
end

def validate_architecture_evidence!(evidence, architecture:, repository:, sha:, tag:, image:,
    run_id:, run_attempt:, files:, destination:)
  validate_exact_keys! evidence, %w[
    architecture buildkit checks container_validation_sha256 current_recovery format_version
    image_inspection_sha256 kind legacy_digest legacy_recovery legacy_reference legacy_revision
    parent_digest platform recovery release_tag run_attempt run_id runtime_binding signed_provenance
    source_schema_version source_sha target_build_identity target_config_digest target_digest
    target_manifest_digest target_reference transport_mode upgrade_receipt_sha256
  ], "#{architecture} recovery evidence"
  checks = validate_exact_keys!(evidence.fetch("checks"), %w[
    authorized_upgrade current_restore http_history_and_uploads legacy_restore
    migration_denials tamper_denials transport_contract worker_execution
  ], "#{architecture} recovery checks")
  buildkit = validate_exact_keys!(
    evidence.fetch("buildkit"), %w[ provenance_sha256 sbom_sha256 ],
    "#{architecture} BuildKit evidence"
  )
  signed = validate_exact_keys!(evidence.fetch("signed_provenance"), %w[
    parent_bundle_sha256 parent_verification_sha256 runnable_bundle_sha256
    runnable_verification_sha256 signer_workflow source_digest source_ref
  ], "#{architecture} signed provenance")
  current_recovery = validate_exact_keys!(
    evidence.fetch("current_recovery"), %w[ artifact_kind artifact_sha256 ],
    "#{architecture} current recovery evidence"
  )
  legacy_recovery = validate_exact_keys!(
    evidence.fetch("legacy_recovery"), %w[ artifact_kind artifact_sha256 ],
    "#{architecture} legacy recovery evidence"
  )
  expected_build_identity = CampfireBackup::BuildIdentity.release_identity(
    run_id:, run_attempt:, architecture:, revision: sha
  )
  expected_file_hashes = {
    "container_validation_sha256" => "container-validation-#{architecture}.json",
    "image_inspection_sha256" => "container-validation-#{architecture}.json",
    "buildkit.sbom_sha256" => "sbom-#{architecture}.spdx.json",
    "buildkit.provenance_sha256" => "buildkit-provenance-#{architecture}.json",
    "signed.parent_bundle_sha256" => "parent-provenance-#{architecture}.bundle.jsonl",
    "signed.runnable_bundle_sha256" => "runnable-provenance-#{architecture}.bundle.jsonl",
    "signed.parent_verification_sha256" => "parent-provenance-verification-#{architecture}.json",
    "signed.runnable_verification_sha256" => "runnable-provenance-verification-#{architecture}.json"
  }
  observed_file_hashes = {
    "container_validation_sha256" => evidence.fetch("container_validation_sha256"),
    "image_inspection_sha256" => evidence.fetch("image_inspection_sha256"),
    "buildkit.sbom_sha256" => buildkit.fetch("sbom_sha256"),
    "buildkit.provenance_sha256" => buildkit.fetch("provenance_sha256"),
    "signed.parent_bundle_sha256" => signed.fetch("parent_bundle_sha256"),
    "signed.runnable_bundle_sha256" => signed.fetch("runnable_bundle_sha256"),
    "signed.parent_verification_sha256" => signed.fetch("parent_verification_sha256"),
    "signed.runnable_verification_sha256" => signed.fetch("runnable_verification_sha256")
  }
  recovery_artifacts_valid = [ current_recovery, legacy_recovery ].all? do |recovery|
    recovery.fetch("artifact_kind") == "campfire-backup" &&
      recovery.fetch("artifact_sha256").match?(/\A[0-9a-f]{64}\z/)
  end
  contract_valid = evidence.fetch("format_version") == 1 &&
    evidence.fetch("kind") == "campfire-image-recovery" &&
      evidence.fetch("architecture") == architecture && evidence.fetch("platform") == "linux/#{architecture}" &&
      evidence.fetch("source_sha") == sha && evidence.fetch("release_tag") == tag &&
      evidence.fetch("run_id") == run_id.to_s && evidence.fetch("run_attempt") == run_attempt.to_s &&
      evidence.fetch("target_reference") == "#{image}@#{evidence.fetch('target_digest')}" &&
      evidence.fetch("target_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      evidence.fetch("target_manifest_digest") == evidence.fetch("target_digest") &&
      evidence.fetch("runtime_binding") == "registry-manifest-digest" &&
      evidence.fetch("transport_mode") == "external-https-loopback-probe" &&
      evidence.fetch("parent_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      evidence.fetch("target_config_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      evidence.fetch("target_build_identity") == expected_build_identity &&
      evidence.fetch("legacy_digest").match?(/\Asha256:[0-9a-f]{64}\z/) &&
      evidence.fetch("legacy_reference").end_with?("@#{evidence.fetch('legacy_digest')}") &&
      evidence.fetch("legacy_revision").match?(/\A[0-9a-f]{40}\z/) &&
      evidence.fetch("source_schema_version").is_a?(String) && !evidence.fetch("source_schema_version").empty? &&
      evidence.fetch("upgrade_receipt_sha256").match?(/\A[0-9a-f]{64}\z/) &&
      checks.fetch("transport_contract") == "passed" &&
      checks.values.all? { _1 == "passed" } && evidence.fetch("recovery") == "passed" &&
      recovery_artifacts_valid && signed.fetch("source_digest") == sha &&
      signed.fetch("source_ref") == "refs/heads/main" &&
      signed.fetch("signer_workflow") == PUBLISH_WORKFLOW_FILE &&
      observed_file_hashes.all? { |key, digest| digest == files.fetch(expected_file_hashes.fetch(key)) }
  unless contract_valid
    raise ReleaseStateError, "#{architecture} recovery evidence contract is invalid"
  end

  upgrade_path = File.join(destination, "upgrade-recovery-#{architecture}.json")
  unless evidence.fetch("upgrade_receipt_sha256") == Digest::SHA256.file(upgrade_path).hexdigest
    raise ReleaseStateError, "#{architecture} upgrade receipt hash does not match its retained file"
  end
  validate_upgrade_receipt! upgrade_path, evidence, architecture
  true
rescue KeyError, NoMethodError
  raise ReleaseStateError, "#{architecture} recovery evidence is incomplete"
end

def validate_release_evidence!(repository:, run_id:, run_attempt:, destination:, sha:, tag:, image:,
    operation_nonce:, attestation_runner: Open3.method(:capture3))
  entries = Dir.children(destination).sort
  unless entries == RELEASE_EVIDENCE_INVENTORY
    raise ReleaseStateError, "Workflow evidence bundle has missing or unexpected files"
  end
  entries.each do |name|
    stat = File.lstat(File.join(destination, name))
    unless stat.file? && !stat.symlink? && stat.nlink == 1 && stat.size.positive?
      raise ReleaseStateError, "Workflow evidence file #{name} is not a fixed regular file"
    end
  end

  evidence_path = File.join(destination, "release-evidence.json")
  evidence = JSON.parse(File.binread(evidence_path))
  validate_exact_keys! evidence, %w[
    build_identities build_indexes children evidence_files format_version image index_digest
    legacy_images operation_nonce promotion_requirements promotion_requirements_sha256 recovery
    recovery_receipts release_tag repository run_attempt run_id signed_provenance source_sha
    staging_reference upgrade_receipts
  ], "Workflow release evidence"
  files = validate_exact_keys!(evidence.fetch("evidence_files"), RELEASE_EVIDENCE_FILES, "Workflow evidence files")
  unless files.all? do |name, digest|
      digest.is_a?(String) && digest.match?(/\A[0-9a-f]{64}\z/) &&
        Digest::SHA256.file(File.join(destination, name)).hexdigest == digest
    end
    raise ReleaseStateError, "Workflow evidence file hashes do not match the downloaded bytes"
  end

  expected = {
    "format_version" => WORKFLOW_EVIDENCE_FORMAT_VERSION,
    "operation_nonce" => operation_nonce,
    "repository" => repository,
    "source_sha" => sha,
    "release_tag" => tag,
    "image" => image,
    "staging_reference" => "#{image}:staging-#{run_id}-#{run_attempt}",
    "run_id" => run_id.to_s,
    "run_attempt" => run_attempt.to_s
  }
  unless expected.all? { |key, value| evidence.fetch(key) == value }
    raise ReleaseStateError, "Workflow evidence identity does not match the authenticated dispatch"
  end
  unless evidence.fetch("index_digest").match?(/\Asha256:[0-9a-f]{64}\z/)
    raise ReleaseStateError, "Workflow index digest is invalid"
  end
  %w[ build_indexes children legacy_images ].each do |key|
    validate_digest_map! evidence.fetch(key), "Workflow #{key} evidence"
  end
  if evidence.fetch("build_indexes").values.include?(evidence.fetch("index_digest"))
    raise ReleaseStateError, "Workflow evidence lacks a distinct same-media-type registry control digest"
  end
  unless evidence.fetch("children").values.uniq.length == RELEASE_EVIDENCE_ARCHITECTURES.length
    raise ReleaseStateError, "Workflow child image digests must be distinct"
  end
  build_identities = validate_exact_keys!(
    evidence.fetch("build_identities"), RELEASE_EVIDENCE_ARCHITECTURES,
    "Workflow build identity evidence"
  )
  expected_build_identities = RELEASE_EVIDENCE_ARCHITECTURES.to_h do |architecture|
    [ architecture, CampfireBackup::BuildIdentity.release_identity(
      run_id:, run_attempt:, architecture:, revision: sha
    ) ]
  end
  unless build_identities == expected_build_identities
    raise ReleaseStateError, "Workflow build identity evidence is invalid"
  end
  unless evidence.fetch("recovery") == RELEASE_EVIDENCE_ARCHITECTURES.to_h { [ _1, "passed" ] }
    raise ReleaseStateError, "Workflow recovery evidence is incomplete"
  end
  recovery_receipts = validate_exact_keys!(
    evidence.fetch("recovery_receipts"), RELEASE_EVIDENCE_ARCHITECTURES,
    "Workflow recovery receipt evidence"
  )
  upgrade_receipts = validate_exact_keys!(
    evidence.fetch("upgrade_receipts"), RELEASE_EVIDENCE_ARCHITECTURES,
    "Workflow upgrade receipt evidence"
  )
  RELEASE_EVIDENCE_ARCHITECTURES.each do |architecture|
    recovery_name = "recovery-#{architecture}.json"
    upgrade_name = "upgrade-recovery-#{architecture}.json"
    unless recovery_receipts.fetch(architecture) == files.fetch(recovery_name) &&
        upgrade_receipts.fetch(architecture) == files.fetch(upgrade_name)
      raise ReleaseStateError, "Workflow #{architecture} receipt hash does not bind its retained file"
    end
    recovery = JSON.parse(File.binread(File.join(destination, recovery_name)))
    validate_architecture_evidence!(
      recovery, architecture:, repository:, sha:, tag:, image:, run_id:, run_attempt:,
      files:, destination:
    )
    unless recovery.fetch("target_digest") == evidence.dig("children", architecture) &&
        recovery.fetch("parent_digest") == evidence.dig("build_indexes", architecture) &&
        recovery.fetch("target_build_identity") == build_identities.fetch(architecture) &&
        recovery.fetch("legacy_digest") == evidence.dig("legacy_images", architecture) &&
        recovery.fetch("upgrade_receipt_sha256") == upgrade_receipts.fetch(architecture)
      raise ReleaseStateError, "Workflow #{architecture} recovery receipt disagrees with release evidence"
    end
  end

  signed = validate_exact_keys!(evidence.fetch("signed_provenance"), %w[
    index_bundle_sha256 index_verification_sha256 signer_workflow source_digest source_ref
  ], "Workflow signed index provenance")
  unless signed == {
      "source_digest" => sha,
      "source_ref" => "refs/heads/main",
      "signer_workflow" => PUBLISH_WORKFLOW_FILE,
      "index_bundle_sha256" => files.fetch("index-provenance.bundle.jsonl"),
      "index_verification_sha256" => files.fetch("index-provenance-verification.json")
    }
    raise ReleaseStateError, "Workflow signed index provenance is invalid"
  end
  promotion = validate_exact_keys!(evidence.fetch("promotion_requirements"), %w[
    authority required_release_driver_evidence workflow_scope
  ], "Workflow promotion requirements")
  expected_promotion = {
    "authority" => "bin/release",
    "workflow_scope" => "attempt-scoped staging only",
    "required_release_driver_evidence" => [
      "live no-overwrite registry probe bound to immutable aliases",
      "dual Object Lock anchor receipts for the authenticated journal head"
    ]
  }
  promotion_path = File.join(destination, "promotion-requirements.json")
  unless promotion == expected_promotion && JSON.parse(File.binread(promotion_path)) == promotion &&
      evidence.fetch("promotion_requirements_sha256") == files.fetch("promotion-requirements.json")
    raise ReleaseStateError, "Workflow promotion requirements are invalid or unbound"
  end

  verify_retained_release_provenance!(
    evidence:, destination:, repository:, image:, sha:, runner: attestation_runner
  )

  %w[ container-validation-amd64.json container-validation-arm64.json
      sbom-amd64.spdx.json sbom-arm64.spdx.json buildkit-provenance-amd64.json
      buildkit-provenance-arm64.json parent-provenance-verification-amd64.json
      parent-provenance-verification-arm64.json runnable-provenance-verification-amd64.json
      runnable-provenance-verification-arm64.json index-provenance-verification.json ].each do |name|
    JSON.parse File.binread(File.join(destination, name))
  end
  %w[ parent-provenance-amd64.bundle.jsonl parent-provenance-arm64.bundle.jsonl
      runnable-provenance-amd64.bundle.jsonl runnable-provenance-arm64.bundle.jsonl
      index-provenance.bundle.jsonl ].each do |name|
    lines = File.binread(File.join(destination, name)).lines
    raise ReleaseStateError, "Workflow provenance bundle #{name} is empty" if lines.empty?
    lines.each { JSON.parse(_1) }
  end
  evidence
rescue JSON::ParserError, KeyError, NoMethodError, Errno::ENOENT => error
  raise ReleaseStateError, "Workflow evidence bundle is invalid: #{error.message}"
end

def workflow_evidence_contract(directory:, run_id:, run_attempt:, operation_nonce:)
  files = RELEASE_EVIDENCE_INVENTORY.to_h do |name|
    path = File.join(directory, name)
    [ name, { "bytes" => File.size(path), "sha256" => Digest::SHA256.file(path).hexdigest } ]
  end
  {
    "format_version" => ReleaseObjectLockAnchors::EVIDENCE_FORMAT_VERSION,
    "operation_nonce" => operation_nonce,
    "run_id" => run_id.to_s,
    "run_attempt" => run_attempt.to_s,
    "files" => files
  }
rescue Errno::ENOENT
  raise ReleaseStateError, "Workflow evidence contract cannot be built from missing files"
end

def retain_and_promote_workflow_evidence!(lock:, journal:, anchors:, directory:, contract:,
    fault_after: ->(_boundary) { })
  pending = journal["workflow_evidence_pending"]
  retained = journal["workflow_evidence"]
  if pending && retained
    raise ReleaseStateError, "Workflow evidence cannot be pending and retained simultaneously"
  end
  if retained
    unless retained == contract
      raise ReleaseStateError, "Retained workflow evidence differs from its authenticated journal contract"
    end
    return true
  end

  if pending
    unless pending == contract
      raise ReleaseStateError, "Pending workflow evidence differs from its authenticated journal contract"
    end
  else
    journal["workflow_evidence_pending"] = contract
    journal["updated_at"] = Time.now.utc.iso8601
    lock.write_journal journal
    fault_after.call "after_pending_contract"
  end

  anchors.retain_pending_evidence!(journal:, directory:, fault_after:)
  fault_after.call "before_journal_promotion"
  journal["workflow_evidence"] = journal.delete("workflow_evidence_pending")
  journal["updated_at"] = Time.now.utc.iso8601
  lock.write_journal journal
  true
end

def download_release_evidence!(repository:, run_id:, run_attempt:, destination:, sha:, tag:, image:,
    operation_nonce:)
  FileUtils.rm_rf destination
  FileUtils.mkdir_p destination
  run! "gh", "run", "download", run_id.to_s, "--repo", repository,
    "--name", "release-evidence-#{run_attempt}", "--dir", destination
  validated_workflow_run!(
    repository:, run_id:, sha:, release_tag: tag, operation_nonce:, attempt: run_attempt
  )
  validate_release_evidence!(
    repository:, run_id:, run_attempt:, destination:, sha:, tag:, image:, operation_nonce:
  )
end

def upload_release_assets_immutably(repository, tag, paths, journal:)
  paths.each do |path|
    release = observed_github_release!(journal:, repository:, tag:)
    unless release.fetch("isDraft")
      raise ReleaseStateError, "GitHub release became public before immutable asset upload"
    end
    assets = release.fetch("assets")
    name = File.basename(path)
    expected_digest = "sha256:#{Digest::SHA256.file(path).hexdigest}"
    if existing = assets.find { _1.fetch("name") == name }
      abort "Release aborted: immutable GitHub asset #{name} differs." unless existing.fetch("digest") == expected_digest
    else
      run! "gh", "release", "upload", tag, path, "--repo", repository
    end
  end
  release = observed_github_release!(journal:, repository:, tag:)
  verify_release_assets!(repository, tag, paths, release:)
end

def verify_release_assets!(repository, tag, paths, release:)
  expected = paths.to_h do |path|
    [ File.basename(path), "sha256:#{Digest::SHA256.file(path).hexdigest}" ]
  end
  actual = release.fetch("assets").to_h do |asset|
    [ asset.fetch("name"), asset.fetch("digest") ]
  end
  abort "Release aborted: GitHub release assets do not exactly match the staged exports." unless actual == expected
end

def github_release_state(repository, tag, notes_file, asset_paths, release:)
  raise ReleaseStateError, "GitHub release #{tag} is missing" unless release
  unless release.keys.sort == %w[ assets body isDraft isPrerelease name tagName ] &&
      [ true, false ].include?(release.fetch("isDraft")) &&
      release.fetch("isPrerelease") == false && release.fetch("tagName") == tag &&
      release.fetch("name") == tag && release.fetch("body") == File.read(notes_file)
    raise ReleaseStateError, "GitHub release metadata changed outside this release"
  end
  verify_release_assets!(repository, tag, asset_paths, release:)
  return "draft" if release.fetch("isDraft")

  "public"
end

def validate_observed_github_release_state!(journal:, release:)
  return true unless release

  unless [ true, false ].include?(release.fetch("isDraft")) &&
      [ true, false ].include?(release.fetch("isPrerelease"))
    raise ReleaseStateError, "GitHub release state is invalid"
  end
  public_release = !release.fetch("isDraft")
  public_channel = journal.dig("channels", "github_public")
  if public_release
    unless public_channel.is_a?(Hash) && public_channel.fetch("kind") == "github_release" &&
        public_channel.fetch("previous") == "draft" && public_channel.fetch("target") == "public"
      raise ReleaseStateError, "Public GitHub release appeared before authenticated promotion preparation"
    end
    unless authenticated_moving_channel_target?(
        journal, channel: "github_public", value: "public"
      )
      raise ReleaseStateError, "Public GitHub release has no authenticated publication transition"
    end
  elsif authenticated_moving_channel_target?(
      journal, channel: "github_public", value: "public"
    )
    raise ReleaseStateError, "GitHub release returned to draft after authenticated publication"
  end
  true
rescue KeyError, NoMethodError
  raise ReleaseStateError, "GitHub release state does not match authenticated promotion state"
end

def observed_github_release!(journal:, repository:, tag:)
  release = github_release(repository, tag)
  validate_observed_github_release_state!(journal:, release:)
  release
end

def authenticated_github_release_state!(journal:, repository:, tag:, notes_file:, asset_paths:)
  release = observed_github_release!(journal:, repository:, tag:)
  github_release_state(repository, tag, notes_file, asset_paths, release:)
end

def validate_github_publication_boundary!(journal:, repository:, tag:, notes_file:, asset_paths:)
  state = authenticated_github_release_state!(
    journal:, repository:, tag:, notes_file:, asset_paths:
  )
  unless state == "draft"
    raise ReleaseStateError, "GitHub release became public before the authenticated publication mutation"
  end
  true
end

class ReleaseLock
  OWNER_FILENAME = "owner"
  JOURNAL_STAGE_PREFIX = ".journal-history.stage-"
  TOMBSTONE_PREFIX = ".campfire-release.lock.released-"
  PENDING_PREFIX = ".campfire-release.lock.pending-"
  PHASE_ZERO_ARTIFACT_FILENAMES = {
    "export" => "phase-zero-export.zip",
    "checksum" => "phase-zero-export.zip.sha256"
  }.freeze
  TERMINAL_STATUSES = %w[ completed rolled_back abandoned ].freeze

  class << self
    def build_phase_zero_artifact_contract(notes:, export_path:, checksum_path:)
      {
        "notes_sha256" => Digest::SHA256.hexdigest(notes),
        "export" => phase_zero_artifact_entry("export", export_path),
        "checksum" => phase_zero_artifact_entry("checksum", checksum_path)
      }
    end

    def phase_zero_artifact_paths(export_path:, checksum_path:)
      {
        PHASE_ZERO_ARTIFACT_FILENAMES.fetch("export") => export_path,
        PHASE_ZERO_ARTIFACT_FILENAMES.fetch("checksum") => checksum_path
      }
    end

    def phase_zero_artifact_metadata(journal)
      contract = journal.fetch("phase_zero_artifacts")
      expected_keys = [ "notes_sha256", *PHASE_ZERO_ARTIFACT_FILENAMES.keys ].sort
      unless contract.is_a?(Hash) && contract.keys.sort == expected_keys &&
          contract.fetch("notes_sha256").match?(ReleaseJournal::DIGEST_PATTERN)
        raise ReleaseStateError, "Authenticated phase-zero artifact contract is invalid"
      end

      PHASE_ZERO_ARTIFACT_FILENAMES.to_h do |role, expected_name|
        entry = contract.fetch(role)
        unless entry.is_a?(Hash) && entry.keys.sort == %w[ bytes name sha256 ] &&
            entry.fetch("name") == expected_name && entry.fetch("bytes").is_a?(Integer) &&
            entry.fetch("bytes").positive? && entry.fetch("sha256").match?(ReleaseJournal::DIGEST_PATTERN)
          raise ReleaseStateError, "Authenticated phase-zero #{role} metadata is invalid"
        end
        [ expected_name, {
          role:, name: expected_name, bytes: entry.fetch("bytes"), digest: entry.fetch("sha256")
        } ]
      end
    rescue KeyError, NoMethodError
      raise ReleaseStateError, "Authenticated phase-zero artifact contract is incomplete"
    end

    def validate_phase_zero_artifact_sources!(journal, artifacts)
      expected = phase_zero_artifact_metadata(journal)
      unless artifacts.keys.sort == expected.keys.sort
        raise ReleaseStateError, "Phase-zero artifact sources do not exactly match their authenticated contract"
      end
      expected.each do |name, metadata|
        path = artifacts.fetch(name)
        stat = File.lstat(path)
        unless stat.file? && !stat.symlink? && stat.nlink == 1 &&
            stat.size == metadata.fetch(:bytes) &&
            Digest::SHA256.file(path).hexdigest == metadata.fetch(:digest)
          raise ReleaseStateError, "Phase-zero artifact source #{name} differs from its authenticated contract"
        end
      end
      export = expected.fetch(PHASE_ZERO_ARTIFACT_FILENAMES.fetch("export"))
      checksum = artifacts.fetch(PHASE_ZERO_ARTIFACT_FILENAMES.fetch("checksum"))
      version = journal.dig("release", "version")
      expected_checksum = "#{export.fetch(:digest)}  campfire-#{version}.zip\n"
      unless File.binread(checksum) == expected_checksum
        raise ReleaseStateError, "Phase-zero checksum does not name its authenticated export"
      end
      true
    rescue Errno::ENOENT
      raise ReleaseStateError, "Phase-zero artifact source is missing"
    end

    def assert_new_state_allowed!(require_existing:)
      if require_existing
        raise ReleaseStateError,
          "Explicit reconciliation requires surviving authenticated release history; it is wholly absent"
      end
      true
    end

    def acquire(initial_journal:, key:, invocation_lock:, anchors: nil, artifacts: {}, allow_existing: false,
        require_existing: false, fault_after: nil)
      invocation_lock.assert_held!
      invocation_id = invocation_lock.invocation_id
      release = initial_journal.fetch("release")
      reconcile_operation_catalog!(
        anchors, operation_states(key:, invocation_id:), invocation_lock
      )
      recover_tombstones! initial_journal, key, invocation_id, anchors:, invocation_lock:
      existing = read_state(
        lock_directory, key:, invocation_id:, allow_absent: true, cleanup_staging: false
      )
      if existing
        reconcile_anchors! anchors, existing, release, invocation_lock
        existing = read_state(lock_directory, key:, invocation_id:)
        ReleaseJournal.validate_contract! existing.fetch(:journal), acquisition_contract(initial_journal)
        unless allow_existing
          raise ReleaseStateError, "Durable release state already exists; use explicit reconciliation"
        end
        return build_lock(existing, key, invocation_lock, anchors)
      end

      reconcile_anchors! anchors, nil, release, invocation_lock
      recovered = recover_pending! initial_journal, key, invocation_id
      if recovered
        reconcile_anchors! anchors, recovered, release, invocation_lock
        return build_lock(recovered, key, invocation_lock, anchors)
      end

      assert_new_state_allowed!(require_existing:)
      validate_phase_zero_artifact_sources! initial_journal, artifacts

      lock_id = SecureRandom.hex(32)
      journal = initial_journal.merge("lock_id" => lock_id)
      history = ReleaseJournal.build_history(
        journal, operation_id: lock_id, prior_digest: ReleaseJournal::GENESIS_DIGEST,
        publisher_id: invocation_id, key:
      )
      phase_stage_name = journal_stage_name(
        lock_id:, invocation_id:, revision: 0, source: history.fetch(:source), key:
      )
      pending = File.join(EXPORT_DEPLOY_LOCATION, pending_stage_name(lock_id, history.fetch(:source), key:))
      publisher(invocation_lock).publish_directory!(
        canonical: lock_directory, staging: pending, owner_id: lock_id,
        journal_name: history.fetch(:name), journal_stage_name: phase_stage_name,
        journal_source: history.fetch(:source), artifacts:,
        expected_artifacts: phase_zero_artifact_metadata(journal),
        lock_guard: state_lock_command,
        publication_guard: "#{state_lock_pin_guard}; #{live_owner_guard(invocation_id)}",
        fault_after:
      )
      state = read_state(lock_directory, key:, invocation_id:)
      unless state.fetch(:journal) == journal
        raise ReleaseStateError, "Phase-zero release journal did not persist exactly"
      end
      reconcile_anchors! anchors, state, release, invocation_lock
      build_lock state, key, invocation_lock, anchors
    rescue ReleaseStateError
      raise
    rescue StandardError => error
      raise ReleaseStateError, "Durable phase-zero lock acquisition failed: #{error.message}"
    end

    def existing_state(key:, invocation_id:, cleanup_staging: true)
      read_state lock_directory, key:, invocation_id:, allow_absent: true, cleanup_staging:
    end

    def peek_existing_state(key:)
      read_state(
        lock_directory, key:, invocation_id: nil, allow_absent: true,
        cleanup_staging: false
      )
    end

    def operation_states(key:, invocation_id:)
      command = "set -eu; #{live_owner_guard(invocation_id)}; " \
        "if test -e #{Shellwords.escape(lock_directory)} || test -L #{Shellwords.escape(lock_directory)}; then " \
        "test -d #{Shellwords.escape(lock_directory)}; test ! -L #{Shellwords.escape(lock_directory)}; echo ACTIVE; fi; " \
        "for path in #{Shellwords.escape(File.join(EXPORT_DEPLOY_LOCATION, TOMBSTONE_PREFIX))}*; do " \
        "if test -e \"$path\" || test -L \"$path\"; then basename \"$path\"; fi; done"
      stdout, stderr, status = capture_remote command
      unless status.success?
        raise ReleaseStateError, "Could not inspect local release operation inventory: #{stderr}#{stdout}"
      end

      states = stdout.lines.map(&:strip).reject(&:empty?).map do |name|
        path = if name == "ACTIVE"
          lock_directory
        elsif name.match?(/\A#{Regexp.escape(TOMBSTONE_PREFIX)}[0-9a-f]{64}\z/)
          File.join(EXPORT_DEPLOY_LOCATION, name)
        else
          raise ReleaseStateError, "Invalid local release operation inventory entry #{name.inspect}"
        end
        state = read_state(
          path, key:, invocation_id:, cleanup_staging: false
        )
        if name != "ACTIVE" && !TERMINAL_STATUSES.include?(state.dig(:journal, "status"))
          raise ReleaseStateError, "Local release tombstone inventory contains a nonterminal operation"
        end
        state
      end
      if states.map { _1.fetch(:lock_id) }.uniq.length != states.length
        raise ReleaseStateError, "Local release operation inventory contains a duplicate operation"
      end
      states.sort_by { _1.fetch(:lock_id) }
    end

    def read_state(path, key:, invocation_id:, allow_absent: false, cleanup_staging: true)
      snapshot = read_history_snapshot(path, invocation_id:)
      if snapshot == :absent
        return if allow_absent
        raise ReleaseStateError, "Expected durable release state is absent"
      end

      state = state_from_snapshot(snapshot, key:)
      if snapshot.fetch(:stages).any?
        validate_stages!(snapshot.fetch(:stages), state, key: key)
        if cleanup_staging
          cleanup_journal_staging! path, state, key, invocation_id, stages: snapshot.fetch(:stages)
          snapshot = read_history_snapshot(path, invocation_id:)
          raise ReleaseStateError, "Durable release state disappeared during staging cleanup" if snapshot == :absent
          state = state_from_snapshot(snapshot, key:)
          unless snapshot.fetch(:stages).empty?
            raise ReleaseStateError, "Release journal staging cleanup did not settle"
          end
        end
      end
      state
    rescue ReleaseStateError
      raise
    rescue KeyError, ArgumentError => error
      raise ReleaseStateError, "Durable release state is invalid: #{error.message}"
    end

    def read_history_snapshot(path, invocation_id:)
      owner = File.join(path, OWNER_FILENAME)
      history_prefix = File.join(path, ReleaseJournal::HISTORY_PREFIX)
      stage_prefix = File.join(path, JOURNAL_STAGE_PREFIX)
      artifact_paths = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
        Shellwords.escape(File.join(path, name))
      end.join(" ")
      artifact_exclusions = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
        "! -name #{Shellwords.escape(name)}"
      end.join(" ")
      command = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; #{live_owner_guard(invocation_id)}; " \
        "if test ! -e #{Shellwords.escape(path)} && test ! -L #{Shellwords.escape(path)}; then echo ABSENT; " \
        "else test -d #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
        "test -z \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
        "! -name #{Shellwords.escape(OWNER_FILENAME)} " \
        "! -name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} " \
        "! -name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} #{artifact_exclusions} -print -quit)\"; " \
        "test -f #{Shellwords.escape(owner)}; test ! -L #{Shellwords.escape(owner)}; " \
        "printf 'OWNER %s %s %s %s\\n' \"$(stat -c %h #{Shellwords.escape(owner)})\" " \
        "\"$(wc -c < #{Shellwords.escape(owner)} | tr -d ' ')\" " \
        "\"$(sha256sum #{Shellwords.escape(owner)} | cut -d' ' -f1)\" " \
        "\"$(base64 -w0 < #{Shellwords.escape(owner)})\"; " \
        "for entry in #{Shellwords.escape(history_prefix)}*; do if test -e \"$entry\" || test -L \"$entry\"; then " \
        "test -f \"$entry\"; test ! -L \"$entry\"; " \
        "printf 'HISTORY %s %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
        "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
        "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\" " \
        "\"$(base64 -w0 < \"$entry\")\"; fi; done; " \
        "for entry in #{Shellwords.escape(stage_prefix)}*; do if test -e \"$entry\" || test -L \"$entry\"; then " \
        "test -f \"$entry\"; test ! -L \"$entry\"; " \
        "printf 'STAGE %s %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
        "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
        "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\" " \
        "\"$(base64 -w0 < \"$entry\")\"; fi; done; " \
        "for entry in #{artifact_paths}; do if test -e \"$entry\" || test -L \"$entry\"; then " \
        "test -f \"$entry\"; test ! -L \"$entry\"; " \
        "printf 'ARTIFACT %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
        "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
        "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\"; fi; done; fi"
      stdout, stderr, status = capture_remote command
      raise ReleaseStateError, "Could not inspect durable release history: #{stderr}#{stdout}" unless status.success?
      return :absent if stdout.strip == "ABSENT"

      lines = stdout.lines(chomp: true)
      owner_fields = lines.shift.to_s.split(" ", 5)
      unless owner_fields.first == "OWNER" && owner_fields.length == 5
        raise ReleaseStateError, "Durable release lock owner is invalid"
      end
      owner_source = Base64.strict_decode64(owner_fields.fetch(4))
      unless owner_fields.fetch(1) == "1" && owner_fields.fetch(2).match?(/\A\d+\z/) &&
          owner_fields.fetch(3).match?(ReleaseJournal::DIGEST_PATTERN) &&
          owner_source.bytesize == owner_fields.fetch(2).to_i &&
          Digest::SHA256.hexdigest(owner_source) == owner_fields.fetch(3) &&
          owner_source.match?(/\A[0-9a-f]{64}\n\z/)
        raise ReleaseStateError, "Durable release lock owner is invalid"
      end
      records = lines.map { parse_snapshot_record(_1) }
      {
        lock_id: owner_source.strip,
        histories: records.select { _1.fetch(:kind) == "HISTORY" },
        stages: records.select { _1.fetch(:kind) == "STAGE" },
        artifacts: records.select { _1.fetch(:kind) == "ARTIFACT" }
      }
    rescue ArgumentError => error
      raise ReleaseStateError, "Durable release history encoding is invalid: #{error.message}"
    end

    def state_from_snapshot(snapshot, key:)
      lock_id = snapshot.fetch(:lock_id)
      records = snapshot.fetch(:histories)
      raise ReleaseStateError, "Durable release history has no phase-zero entry" if records.empty?

      entries = records.map do |record|
        entry = ReleaseJournal.verify_history!(record.fetch(:source), key:, filename: record.fetch(:name))
        unless entry.fetch(:operation_id) == lock_id
          raise ReleaseStateError, "Release journal history belongs to another operation"
        end
        entry.merge(
          file_sha256: record.fetch(:digest), bytes: record.fetch(:bytes),
          nlink: record.fetch(:nlink), identity: record.fetch(:identity)
        )
      end
      grouped = entries.group_by { _1.fetch(:revision) }
      duplicate = grouped.find { |_, revision_entries| revision_entries.length != 1 }
      if duplicate
        raise ReleaseStateError, "Release journal history forked at revision #{duplicate.first}"
      end
      revisions = grouped.keys.sort
      unless revisions == (0..revisions.last).to_a
        raise ReleaseStateError, "Release journal history contains a gap"
      end
      ordered = revisions.map { grouped.fetch(_1).sole }
      ordered.each_with_index do |entry, index|
        expected_prior = index.zero? ? ReleaseJournal::GENESIS_DIGEST : ordered.fetch(index - 1).fetch(:current_digest)
        unless entry.fetch(:prior_digest) == expected_prior
          raise ReleaseStateError, "Release journal history chain is broken at revision #{entry.fetch(:revision)}"
        end
      end

      ordered.each { ReleaseJournal.validate_format! _1.fetch(:journal) }

      artifacts = validate_phase_zero_artifact_records!(
        snapshot.fetch(:artifacts, []), ordered.last.fetch(:journal)
      )

      stages_by_identity = snapshot.fetch(:stages).group_by { _1.fetch(:identity) }
      ordered.each do |entry|
        next if entry.fetch(:nlink) == 1
        unless entry.fetch(:nlink) == 2 && stages_by_identity.fetch(entry.fetch(:identity), []).length == 1
          raise ReleaseStateError, "Release journal history has an unexpected hard link"
        end
      end
      highest = ordered.last
      inventory = ordered.sort_by { _1.fetch(:name) }.map do |entry|
        "#{entry.fetch(:name)} #{entry.fetch(:file_sha256)}\n"
      end.join + artifacts.sort_by { _1.fetch(:name) }.map do |artifact|
        "#{artifact.fetch(:name)} #{artifact.fetch(:digest)}\n"
      end.join
      {
        lock_id:, journal: highest.fetch(:journal), source: highest.fetch(:source),
        history_digest: highest.fetch(:current_digest), history_name: highest.fetch(:name),
        history: ordered, artifacts:, inventory_digest: Digest::SHA256.hexdigest(inventory)
      }
    end

    def cleanup_journal_staging!(path, state, key, invocation_id, stages:)
      validate_stages!(stages, state, key: key)
      stages.each do |record|
        staging = File.join(path, record.fetch(:name))
        linked_entry = state.fetch(:history).find { _1.fetch(:identity) == record.fetch(:identity) }
        link_guard = if record.fetch(:nlink) == 2
          canonical = File.join(path, linked_entry.fetch(:name))
          "test #{Shellwords.escape(staging)} -ef #{Shellwords.escape(canonical)}; " \
            "test \"$(stat -c %h #{Shellwords.escape(canonical)})\" -eq 2; "
        else
          ""
        end
        command = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; " \
          "#{live_owner_guard(invocation_id)}; #{history_set_guard(path, state)}; " \
          "test -f #{Shellwords.escape(staging)}; test ! -L #{Shellwords.escape(staging)}; " \
          "test \"$(stat -c %h #{Shellwords.escape(staging)})\" -eq #{record.fetch(:nlink)}; " \
          "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(staging)})\" = #{Shellwords.escape(record.fetch(:identity))}; " \
          "test \"$(wc -c < #{Shellwords.escape(staging)} | tr -d ' ')\" = #{record.fetch(:bytes)}; " \
          "test \"$(sha256sum #{Shellwords.escape(staging)} | cut -d' ' -f1)\" = #{Shellwords.escape(record.fetch(:digest))}; " \
          "#{link_guard}rm #{Shellwords.escape(staging)}; sync -f #{Shellwords.escape(path)}"
        _, stderr, status = capture_remote command
        unless status.success?
          raise ReleaseStateError, "Could not remove authenticated journal staging: #{stderr}"
        end
        linked_entry[:nlink] = 1 if linked_entry
      end
    end

    def parse_snapshot_record(line)
      if line.start_with?("ARTIFACT ")
        fields = line.split(" ", 6)
        unless fields.length == 6
          raise ReleaseStateError, "Durable phase-zero artifact record is invalid"
        end
        name = Base64.strict_decode64(fields.fetch(1))
        nlink = Integer(fields.fetch(2), 10)
        bytes = Integer(fields.fetch(4), 10)
        digest = fields.fetch(5)
        unless !name.empty? && File.basename(name) == name && nlink.positive? &&
            fields.fetch(3).match?(/\A\d+:\d+\z/) && bytes >= 0 &&
            digest.match?(ReleaseJournal::DIGEST_PATTERN)
          raise ReleaseStateError, "Durable phase-zero artifact record metadata is invalid"
        end
        return {
          kind: "ARTIFACT", name:, nlink:, identity: fields.fetch(3), bytes:, digest:
        }
      end

      fields = line.split(" ", 7)
      unless fields.length == 7 && %w[ HISTORY STAGE ].include?(fields.fetch(0))
        raise ReleaseStateError, "Durable release history record is invalid"
      end
      name = Base64.strict_decode64(fields.fetch(1))
      source = Base64.strict_decode64(fields.fetch(6))
      nlink = Integer(fields.fetch(2), 10)
      bytes = Integer(fields.fetch(4), 10)
      digest = fields.fetch(5)
      unless !name.empty? && File.basename(name) == name && nlink.positive? &&
          fields.fetch(3).match?(/\A\d+:\d+\z/) && bytes >= 0 &&
          digest.match?(ReleaseJournal::DIGEST_PATTERN) && source.bytesize == bytes &&
          Digest::SHA256.hexdigest(source) == digest
        raise ReleaseStateError, "Durable release history record metadata is invalid"
      end
      {
        kind: fields.fetch(0), name:, nlink:, identity: fields.fetch(3),
        bytes:, digest:, source:
      }
    rescue ArgumentError
      raise ReleaseStateError, "Durable release history record metadata is invalid"
    end

    def validate_phase_zero_artifact_records!(records, journal)
      expected = phase_zero_artifact_metadata(journal)
      grouped = records.group_by { _1.fetch(:name) }
      unless grouped.keys.sort == expected.keys.sort && grouped.values.all?(&:one?)
        raise ReleaseStateError, "Durable phase-zero artifacts are missing, duplicated, or unexpected"
      end

      expected.map do |name, metadata|
        record = grouped.fetch(name).sole
        unless record.fetch(:kind) == "ARTIFACT" && record.fetch(:nlink) == 1 &&
            record.fetch(:bytes) == metadata.fetch(:bytes) &&
            record.fetch(:digest) == metadata.fetch(:digest)
          raise ReleaseStateError, "Durable phase-zero artifact #{name} differs from authenticated state"
        end
        record.merge(role: metadata.fetch(:role))
      end
    rescue KeyError
      raise ReleaseStateError, "Durable phase-zero artifact inventory is invalid"
    end

    def validate_stages!(stages, state, key:)
      stages.each do |record|
        metadata = parse_journal_stage_name(record.fetch(:name), lock_id: state.fetch(:lock_id), key:)
        complete = record.fetch(:bytes) == metadata.fetch(:bytes) &&
          record.fetch(:digest) == metadata.fetch(:digest)
        unless [ 1, 2 ].include?(record.fetch(:nlink)) && (complete || record.fetch(:nlink) == 1)
          raise ReleaseStateError, "Staged release journal has an unexpected hard link"
        end
        next unless complete

        entry = ReleaseJournal.verify_history!(record.fetch(:source), key:)
        unless entry.fetch(:operation_id) == state.fetch(:lock_id) &&
            entry.fetch(:revision) == metadata.fetch(:revision)
          raise ReleaseStateError, "Staged release journal identity or revision changed"
        end
        ReleaseJournal.validate_contract! entry.fetch(:journal), immutable_contract(state.fetch(:journal))
        if record.fetch(:nlink) == 2
          canonical = state.fetch(:history).find { _1.fetch(:identity) == record.fetch(:identity) }
          unless canonical && canonical.fetch(:name) == entry.fetch(:name) &&
              canonical.fetch(:file_sha256) == record.fetch(:digest)
            raise ReleaseStateError, "Staged release journal hard link does not match authenticated history"
          end
        end
      end
      true
    end

    def history_set_guard(path, state, allow_staging: true)
      owner = File.join(path, OWNER_FILENAME)
      artifact_exclusions = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
        "! -name #{Shellwords.escape(name)}"
      end.join(" ")
      checks = [
        "test -d #{Shellwords.escape(path)}", "test ! -L #{Shellwords.escape(path)}",
        "test -f #{Shellwords.escape(owner)}", "test ! -L #{Shellwords.escape(owner)}",
        "test \"$(stat -c %h #{Shellwords.escape(owner)})\" -eq 1",
        "test \"$(cat #{Shellwords.escape(owner)})\" = #{Shellwords.escape(state.fetch(:lock_id))}",
        "test -z \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "! -name #{Shellwords.escape(OWNER_FILENAME)} " \
          "! -name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} " \
          "! -name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} #{artifact_exclusions} -print -quit)\"",
        "test \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "-name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} -print | wc -l)\" " \
          "-eq #{state.fetch(:history).length}"
      ]
      unless allow_staging
        checks << "test \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "-name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} -print | wc -l)\" -eq 0"
      end
      state.fetch(:history).each do |entry|
        history_path = File.join(path, entry.fetch(:name))
        checks.concat [
          "test -f #{Shellwords.escape(history_path)}", "test ! -L #{Shellwords.escape(history_path)}",
          "test \"$(stat -c %h #{Shellwords.escape(history_path)})\" -eq #{entry.fetch(:nlink)}",
          "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(history_path)})\" = #{Shellwords.escape(entry.fetch(:identity))}",
          "test \"$(wc -c < #{Shellwords.escape(history_path)} | tr -d ' ')\" = #{entry.fetch(:bytes)}",
          "test \"$(sha256sum #{Shellwords.escape(history_path)} | cut -d' ' -f1)\" = #{Shellwords.escape(entry.fetch(:file_sha256))}"
        ]
      end
      state.fetch(:artifacts).each do |artifact|
        artifact_path = File.join(path, artifact.fetch(:name))
        checks.concat [
          "test -f #{Shellwords.escape(artifact_path)}", "test ! -L #{Shellwords.escape(artifact_path)}",
          "test \"$(stat -c %h #{Shellwords.escape(artifact_path)})\" -eq 1",
          "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(artifact_path)})\" = #{Shellwords.escape(artifact.fetch(:identity))}",
          "test \"$(wc -c < #{Shellwords.escape(artifact_path)} | tr -d ' ')\" = #{artifact.fetch(:bytes)}",
          "test \"$(sha256sum #{Shellwords.escape(artifact_path)} | cut -d' ' -f1)\" = #{Shellwords.escape(artifact.fetch(:digest))}"
        ]
      end
      checks.join("; ")
    end

    def history_predecessor_guard(path, state)
      history_set_guard(path, state)
    end

    def recover_tombstones!(initial_journal, key, invocation_id, anchors: nil, invocation_lock: nil)
      command = "set -eu; #{live_owner_guard(invocation_id)}; " \
        "for path in #{Shellwords.escape(File.join(EXPORT_DEPLOY_LOCATION, TOMBSTONE_PREFIX))}*; do " \
        "if test -e \"$path\" || test -L \"$path\"; then basename \"$path\"; fi; done"
      stdout, stderr, status = capture_remote command
      raise ReleaseStateError, "Could not inspect release cleanup tombstones: #{stderr}#{stdout}" unless status.success?

      stdout.lines.map(&:strip).reject(&:empty?).each do |name|
        unless name.match?(/\A#{Regexp.escape(TOMBSTONE_PREFIX)}[0-9a-f]{64}\z/)
          raise ReleaseStateError, "Invalid release cleanup tombstone #{name.inspect}"
        end
        path = File.join(EXPORT_DEPLOY_LOCATION, name)
        state = read_state(path, key:, invocation_id:)
        unless TERMINAL_STATUSES.include?(state.dig(:journal, "status"))
          raise ReleaseStateError, "Nonterminal release cleanup tombstone requires reconciliation"
        end

        matching_release = contract_matches?(state.fetch(:journal), initial_journal)
        if matching_release
          reconcile_anchors! anchors, state, initial_journal.fetch("release"), invocation_lock
        end
        if matching_release && read_state(lock_directory, key:, invocation_id:, allow_absent: true).nil?
          rename = atomic_no_replace_rename_command(path, lock_directory)
          move = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; " \
            "#{live_owner_guard(invocation_id)}; " \
            "#{history_set_guard(path, state, allow_staging: false)}; " \
            "test ! -e #{Shellwords.escape(lock_directory)}; test ! -L #{Shellwords.escape(lock_directory)}; " \
            "#{rename}; " \
            "sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
            "#{history_set_guard(lock_directory, state, allow_staging: false)}"
          _, move_stderr, move_status = capture_remote move
          raise ReleaseStateError, "Could not restore authenticated cleanup state: #{move_stderr}" unless move_status.success?
          return
        end
        # A terminal tombstone is retained as authenticated audit and recovery state.
      end
    end

    def recover_pending!(initial_journal, key, invocation_id)
      command = "set -eu; #{live_owner_guard(invocation_id)}; " \
        "for path in #{Shellwords.escape(File.join(EXPORT_DEPLOY_LOCATION, PENDING_PREFIX))}*; do " \
        "if test -e \"$path\" || test -L \"$path\"; then basename \"$path\"; fi; done"
      stdout, stderr, status = capture_remote command
      raise ReleaseStateError, "Could not inspect pending phase-zero state: #{stderr}#{stdout}" unless status.success?

      active = read_state(lock_directory, key:, invocation_id:, allow_absent: true)
      stdout.lines.map(&:strip).reject(&:empty?).each do |name|
        metadata = parse_pending_stage_name(name, key:)
        path = File.join(EXPORT_DEPLOY_LOCATION, name)
        observed = inspect_pending_stage(path, metadata.fetch(:lock_id), invocation_id)
        if (observed.fetch(:owner_nlink) && observed.fetch(:owner_nlink) != 1) ||
            observed.fetch(:artifacts).any? { _1.fetch(:nlink) != 1 }
          raise ReleaseStateError, "Pending phase-zero state has an unexpected hard link"
        end
        history_complete = observed.fetch(:owner_nlink) == 1 && observed.fetch(:owner_bytes) == 65 &&
          observed.fetch(:owner_digest) == Digest::SHA256.hexdigest("#{metadata.fetch(:lock_id)}\n") &&
          observed.fetch(:history)&.fetch(:nlink) == 1 &&
          observed.fetch(:history)&.fetch(:bytes) == metadata.fetch(:bytes) &&
          observed.fetch(:history)&.fetch(:digest) == metadata.fetch(:digest)

        state = nil
        if history_complete
          history = ReleaseJournal.verify_history!(
            observed.fetch(:history).fetch(:source), key:,
            filename: observed.fetch(:history).fetch(:name)
          )
          provisional = { lock_id: metadata.fetch(:lock_id), journal: history.fetch(:journal) }
          validate_pending_state! provisional, initial_journal
          expected_artifacts = phase_zero_artifact_metadata(history.fetch(:journal))
          observed_artifacts = observed.fetch(:artifacts)
          grouped_artifacts = observed_artifacts.group_by { _1.fetch(:name) }
          artifacts_complete = grouped_artifacts.keys.sort == expected_artifacts.keys.sort &&
            grouped_artifacts.values.all?(&:one?) && expected_artifacts.all? do |artifact_name, expected|
              artifact = grouped_artifacts.fetch(artifact_name).sole
              artifact.fetch(:bytes) == expected.fetch(:bytes) &&
                artifact.fetch(:digest) == expected.fetch(:digest)
            end
          if artifacts_complete
            state = state_from_snapshot({
              lock_id: metadata.fetch(:lock_id), histories: [ observed.fetch(:history) ],
              stages: [], artifacts: observed_artifacts
            }, key:)
          end
        end

        if state && active.nil? && contract_matches?(state.fetch(:journal), initial_journal)
          move_pending_stage! path, observed, invocation_id
          active = read_state(lock_directory, key:, invocation_id:)
        else
          remove_pending_stage! path, observed, invocation_id
        end
      rescue KeyError => error
        raise ReleaseStateError, "Pending release state is invalid: #{error.message}"
      end
      active
    end

    def validate_pending_state!(state, initial_journal)
      journal = state.fetch(:journal)
      expected_keys = (initial_journal.keys + [ "lock_id" ]).sort
      phase_zero = journal.dig("phases", "phase_zero")
      unless journal.fetch("lock_id") == state.fetch(:lock_id) && journal.keys.sort == expected_keys &&
          journal.fetch("status") == "locked" &&
          journal.fetch("journal_revision") == 0 && journal.fetch("phase") == "phase_zero" &&
          journal.fetch("phases").keys == [ "phase_zero" ] && phase_zero.is_a?(Hash) &&
          phase_zero.fetch("status") == "completed"
        raise ReleaseStateError, "Pending release state is not an authenticated phase-zero journal"
      end
      true
    rescue KeyError, NoMethodError
      raise ReleaseStateError, "Pending release state is incomplete"
    end

    def immutable_contract(journal)
      journal.slice("format_version", "release", "anchor_set", "phase_zero_artifacts", "release_notes")
    end

    def acquisition_contract(journal)
      journal.slice("format_version", "release", "anchor_set")
    end

    def pending_stage_name(lock_id, source, key:)
      bytes = source.bytesize
      digest = Digest::SHA256.hexdigest(source)
      token = ReleaseJournal.staging_token("phase-zero", [ lock_id, bytes, digest ], key:)
      "#{PENDING_PREFIX}#{lock_id}-#{bytes}-#{digest}-#{token}"
    end

    def parse_pending_stage_name(name, key:)
      match = name.match(/\A#{Regexp.escape(PENDING_PREFIX)}([0-9a-f]{64})-(\d+)-([0-9a-f]{64})-([0-9a-f]{32})\z/)
      raise ReleaseStateError, "Invalid pending release state #{name.inspect}" unless match

      lock_id, bytes, digest, token = match.captures
      expected = ReleaseJournal.staging_token("phase-zero", [ lock_id, bytes.to_i, digest ], key:)
      raise ReleaseStateError, "Pending release staging authentication failed" unless token == expected
      { lock_id:, bytes: bytes.to_i, digest: }
    end

    def journal_stage_name(lock_id:, invocation_id:, revision:, source:, key:)
      bytes = source.bytesize
      digest = Digest::SHA256.hexdigest(source)
      nonce = SecureRandom.hex(16)
      attributes = [ lock_id, invocation_id, revision, bytes, digest, nonce ]
      token = ReleaseJournal.staging_token("journal", attributes, key:)
      "#{JOURNAL_STAGE_PREFIX}#{invocation_id}-#{revision}-#{bytes}-#{digest}-#{nonce}-#{token}"
    end

    def parse_journal_stage_name(name, lock_id:, key:)
      pattern = /\A#{Regexp.escape(JOURNAL_STAGE_PREFIX)}([0-9a-f]{32})-(\d+)-(\d+)-([0-9a-f]{64})-([0-9a-f]{32})-([0-9a-f]{32})\z/
      match = name.match(pattern)
      raise ReleaseStateError, "Invalid release journal staging path #{name.inspect}" unless match

      invocation_id, revision, bytes, digest, nonce, token = match.captures
      attributes = [ lock_id, invocation_id, revision.to_i, bytes.to_i, digest, nonce ]
      expected = ReleaseJournal.staging_token("journal", attributes, key:)
      raise ReleaseStateError, "Release journal staging authentication failed" unless token == expected
      { invocation_id:, revision: revision.to_i, bytes: bytes.to_i, digest:, nonce: }
    end

    def lock_directory
      File.join(EXPORT_DEPLOY_LOCATION, ".campfire-release.lock")
    end

    def remote
      "#{EXPORT_REMOTE_USER}@#{EXPORT_DEPLOY_HOSTS.first}"
    end

    def live_owner_guard(invocation_id)
      return "true" unless invocation_id

      "test -f #{Shellwords.escape(ReleaseInvocationLock::OWNER_PATH)}; " \
        "test ! -L #{Shellwords.escape(ReleaseInvocationLock::OWNER_PATH)}; " \
        "test \"$(stat -c %h #{Shellwords.escape(ReleaseInvocationLock::OWNER_PATH)})\" -eq 1; " \
        "test -f #{Shellwords.escape(ReleaseInvocationLock::LOCK_PATH)}; " \
        "test ! -L #{Shellwords.escape(ReleaseInvocationLock::LOCK_PATH)}; " \
        "test \"$(stat -c %h #{Shellwords.escape(ReleaseInvocationLock::LOCK_PATH)})\" -eq 1; " \
        "test -f #{Shellwords.escape(ReleaseInvocationLock::STATE_LOCK_PATH)}; " \
        "test ! -L #{Shellwords.escape(ReleaseInvocationLock::STATE_LOCK_PATH)}; " \
        "test \"$(stat -c %h #{Shellwords.escape(ReleaseInvocationLock::STATE_LOCK_PATH)})\" -eq 1; " \
        "test \"$(cat #{Shellwords.escape(ReleaseInvocationLock::OWNER_PATH)})\" = " \
        "\"#{invocation_id} $(stat -Lc '%d:%i' #{Shellwords.escape(ReleaseInvocationLock::LOCK_PATH)}) " \
        "$(stat -Lc '%d:%i' #{Shellwords.escape(ReleaseInvocationLock::STATE_LOCK_PATH)})\""
    end

    def state_lock_command
      ReleaseInvocationLock.state_lock_command 8
    end

    def state_lock_pin_guard
      ReleaseInvocationLock.lock_pin_guard ReleaseInvocationLock::STATE_LOCK_PATH, 8
    end

    def materialize_phase_zero_artifacts!(state:, destinations:, invocation_id:)
      metadata = phase_zero_artifact_metadata(state.fetch(:journal))
      expected_roles = metadata.values.map { _1.fetch(:role) }.sort
      unless destinations.keys.sort == expected_roles
        raise ReleaseStateError, "Phase-zero materialization destinations are incomplete"
      end
      records = state.fetch(:artifacts).to_h { [ _1.fetch(:name), _1 ] }

      metadata.each do |name, expected|
        record = records.fetch(name)
        remote_path = File.join(lock_directory, name)
        descriptor = "/proc/$$/fd/7"
        command = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; " \
          "#{live_owner_guard(invocation_id)}; #{history_set_guard(lock_directory, state)}; " \
          "exec 7<#{Shellwords.escape(remote_path)}; " \
          "test -f #{Shellwords.escape(remote_path)}; test ! -L #{Shellwords.escape(remote_path)}; " \
          "test #{Shellwords.escape(remote_path)} -ef #{descriptor}; " \
          "test \"$(stat -Lc %h #{descriptor})\" -eq 1; " \
          "test \"$(stat -Lc '%d:%i' #{descriptor})\" = #{Shellwords.escape(record.fetch(:identity))}; " \
          "test \"$(wc -c < #{descriptor} | tr -d ' ')\" = #{expected.fetch(:bytes)}; " \
          "test \"$(sha256sum #{descriptor} | cut -d' ' -f1)\" = #{Shellwords.escape(expected.fetch(:digest))}; " \
          "cat <&7"
        receive_remote_artifact!(
          command, destinations.fetch(expected.fetch(:role)), expected
        )
      end

      export = metadata.fetch(PHASE_ZERO_ARTIFACT_FILENAMES.fetch("export"))
      checksum_path = destinations.fetch("checksum")
      expected_checksum = "#{export.fetch(:digest)}  #{File.basename(destinations.fetch('export'))}\n"
      unless File.binread(checksum_path) == expected_checksum
        raise ReleaseStateError, "Authenticated phase-zero checksum does not name the retained export"
      end
      true
    rescue KeyError
      raise ReleaseStateError, "Phase-zero materialization state is incomplete"
    end

    private
      def build_lock(state, key, invocation_lock, anchors)
        new(
          state.fetch(:lock_id), lock_directory, key,
          invocation_lock:, anchors:, initial_state: state
        )
      end

      def reconcile_anchors!(anchors, state, release, invocation_lock)
        return true unless anchors

        invocation_lock&.assert_held!
        anchors.reconcile!(state:, release:)
        invocation_lock&.assert_held!
        true
      end

      def reconcile_operation_catalog!(anchors, states, invocation_lock)
        return true unless anchors

        invocation_lock&.assert_held!
        anchors.reconcile_catalog!(states:)
        invocation_lock&.assert_held!
        true
      end

      def contract_matches?(actual, expected)
        ReleaseJournal.validate_contract! actual, acquisition_contract(expected)
        true
      rescue ReleaseStateError
        false
      end

      def publisher(invocation_lock)
        ReleaseAtomicPublisher.new(capture: ->(command, stream) {
          invocation_lock.capture_mutation!(
            "ssh", remote, command,
            stdin_data: stream
          )
        })
      end

      def capture_remote(command, stdin_data: nil)
        Open3.capture3("ssh", remote, command, stdin_data:)
      end

      def receive_remote_artifact!(command, destination, expected)
        directory = File.dirname(destination)
        FileUtils.mkdir_p directory
        Tempfile.create([ ".#{File.basename(destination)}", ".tmp" ], directory) do |temporary|
          stdin, stdout, stderr, wait_thread = Open3.popen3("ssh", remote, command)
          stdin.close
          stderr_reader = Thread.new { stderr.read }
          IO.copy_stream stdout, temporary
          status = wait_thread.value
          error = stderr_reader.value
          unless status.success?
            raise ReleaseStateError, "Could not materialize authenticated phase-zero artifact: #{error}"
          end
          temporary.flush
          unless temporary.size == expected.fetch(:bytes) &&
              Digest::SHA256.file(temporary.path).hexdigest == expected.fetch(:digest)
            raise ReleaseStateError, "Materialized phase-zero artifact differs from authenticated state"
          end
          temporary.fsync
          File.rename temporary.path, destination
        ensure
          stdin&.close unless stdin&.closed?
          stdout&.close unless stdout&.closed?
          stderr&.close unless stderr&.closed?
        end
      end

      def phase_zero_artifact_entry(role, path)
        {
          "name" => PHASE_ZERO_ARTIFACT_FILENAMES.fetch(role),
          "bytes" => File.size(path),
          "sha256" => Digest::SHA256.file(path).hexdigest
        }
      rescue Errno::ENOENT
        raise ReleaseStateError, "Phase-zero #{role} source is missing"
      end

      def inspect_pending_stage(path, lock_id, invocation_id)
        owner = File.join(path, OWNER_FILENAME)
        history_prefix = File.join(path, ReleaseJournal::HISTORY_PREFIX)
        stage_prefix = File.join(path, JOURNAL_STAGE_PREFIX)
        artifact_paths = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
          Shellwords.escape(File.join(path, name))
        end.join(" ")
        artifact_exclusions = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
          "! -name #{Shellwords.escape(name)}"
        end.join(" ")
        command = "set -eu; #{live_owner_guard(invocation_id)}; " \
          "test -d #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
          "test -z \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "! -name #{Shellwords.escape(OWNER_FILENAME)} " \
          "! -name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} " \
          "! -name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} #{artifact_exclusions} -print -quit)\"; " \
          "if test -e #{Shellwords.escape(owner)} || test -L #{Shellwords.escape(owner)}; then " \
          "test -f #{Shellwords.escape(owner)}; test ! -L #{Shellwords.escape(owner)}; " \
          "printf 'OWNER %s %s %s\\n' \"$(stat -c %h #{Shellwords.escape(owner)})\" " \
          "\"$(wc -c < #{Shellwords.escape(owner)} | tr -d ' ')\" " \
          "\"$(sha256sum #{Shellwords.escape(owner)} | cut -d' ' -f1)\"; else echo 'OWNER ABSENT'; fi; " \
          "history_count=$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "-name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} -print | wc -l); " \
          "test \"$history_count\" -le 1; if test \"$history_count\" -eq 0; then echo 'HISTORY ABSENT'; else " \
          "for entry in #{Shellwords.escape(history_prefix)}*; do test -f \"$entry\"; test ! -L \"$entry\"; " \
          "printf 'HISTORY %s %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
          "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
          "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\" " \
          "\"$(base64 -w0 < \"$entry\")\"; done; fi; " \
          "for entry in #{Shellwords.escape(stage_prefix)}*; do if test -e \"$entry\" || test -L \"$entry\"; then " \
          "test -f \"$entry\"; test ! -L \"$entry\"; " \
          "printf 'STAGE %s %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
          "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
          "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\" " \
          "\"$(base64 -w0 < \"$entry\")\"; fi; done; " \
          "for entry in #{artifact_paths}; do if test -e \"$entry\" || test -L \"$entry\"; then " \
          "test -f \"$entry\"; test ! -L \"$entry\"; " \
          "printf 'ARTIFACT %s %s %s %s %s\\n' \"$(printf '%s' \"$(basename -- \"$entry\")\" | base64 -w0)\" " \
          "\"$(stat -c %h \"$entry\")\" \"$(stat -Lc '%d:%i' \"$entry\")\" " \
          "\"$(wc -c < \"$entry\" | tr -d ' ')\" \"$(sha256sum \"$entry\" | cut -d' ' -f1)\"; fi; done"
        stdout, stderr, status = capture_remote command
        raise ReleaseStateError, "Could not inspect pending phase-zero staging: #{stderr}#{stdout}" unless status.success?
        owner_line, *record_lines = stdout.lines(chomp: true)
        owner_parts = owner_line.to_s.split
        history_absent = record_lines.delete("HISTORY ABSENT")
        records = record_lines.map { parse_snapshot_record(_1) }
        histories = records.select { _1.fetch(:kind) == "HISTORY" }
        unless (history_absent && histories.empty?) || (!history_absent && histories.one?)
          raise ReleaseStateError, "Pending phase-zero history inventory is invalid"
        end
        {
          lock_id:,
          owner_nlink: owner_parts.first == "OWNER" ? Integer(owner_parts.fetch(1), 10) : nil,
          owner_bytes: owner_parts.first == "OWNER" ? Integer(owner_parts.fetch(2), 10) : nil,
          owner_digest: owner_parts.first == "OWNER" ? owner_parts.fetch(3) : nil,
          history: histories.first,
          stages: records.select { _1.fetch(:kind) == "STAGE" },
          artifacts: records.select { _1.fetch(:kind) == "ARTIFACT" }
        }
      rescue ArgumentError, IndexError
        raise ReleaseStateError, "Pending phase-zero staging metadata is invalid"
      end

      def pending_entry_guard(path, observed)
        owner = File.join(path, OWNER_FILENAME)
        owner_guard = if observed.fetch(:owner_bytes)
          "test -f #{Shellwords.escape(owner)}; test ! -L #{Shellwords.escape(owner)}; " \
            "test \"$(stat -c %h #{Shellwords.escape(owner)})\" -eq #{observed.fetch(:owner_nlink)}; " \
            "test \"$(wc -c < #{Shellwords.escape(owner)} | tr -d ' ')\" = #{observed.fetch(:owner_bytes)}; " \
            "test \"$(sha256sum #{Shellwords.escape(owner)} | cut -d' ' -f1)\" = #{Shellwords.escape(observed.fetch(:owner_digest))}"
        else
          "test ! -e #{Shellwords.escape(owner)}; test ! -L #{Shellwords.escape(owner)}"
        end
        history_guard = if history = observed.fetch(:history)
          history_path = File.join(path, history.fetch(:name))
          "test -f #{Shellwords.escape(history_path)}; test ! -L #{Shellwords.escape(history_path)}; " \
            "test \"$(stat -c %h #{Shellwords.escape(history_path)})\" -eq #{history.fetch(:nlink)}; " \
            "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(history_path)})\" = #{Shellwords.escape(history.fetch(:identity))}; " \
            "test \"$(wc -c < #{Shellwords.escape(history_path)} | tr -d ' ')\" = #{history.fetch(:bytes)}; " \
            "test \"$(sha256sum #{Shellwords.escape(history_path)} | cut -d' ' -f1)\" = #{Shellwords.escape(history.fetch(:digest))}"
        else
          "test \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
            "-name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} -print | wc -l)\" -eq 0"
        end
        stage_checks = [
          "test \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
            "-name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} -print | wc -l)\" " \
            "-eq #{observed.fetch(:stages).length}"
        ]
        observed.fetch(:stages).each do |stage|
          stage_path = File.join(path, stage.fetch(:name))
          stage_checks.concat [
            "test -f #{Shellwords.escape(stage_path)}", "test ! -L #{Shellwords.escape(stage_path)}",
            "test \"$(stat -c %h #{Shellwords.escape(stage_path)})\" -eq #{stage.fetch(:nlink)}",
            "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(stage_path)})\" = #{Shellwords.escape(stage.fetch(:identity))}",
            "test \"$(wc -c < #{Shellwords.escape(stage_path)} | tr -d ' ')\" = #{stage.fetch(:bytes)}",
            "test \"$(sha256sum #{Shellwords.escape(stage_path)} | cut -d' ' -f1)\" = #{Shellwords.escape(stage.fetch(:digest))}"
          ]
        end
        artifact_checks = observed.fetch(:artifacts).flat_map do |artifact|
          artifact_path = File.join(path, artifact.fetch(:name))
          [
            "test -f #{Shellwords.escape(artifact_path)}", "test ! -L #{Shellwords.escape(artifact_path)}",
            "test \"$(stat -c %h #{Shellwords.escape(artifact_path)})\" -eq #{artifact.fetch(:nlink)}",
            "test \"$(stat -Lc '%d:%i' #{Shellwords.escape(artifact_path)})\" = #{Shellwords.escape(artifact.fetch(:identity))}",
            "test \"$(wc -c < #{Shellwords.escape(artifact_path)} | tr -d ' ')\" = #{artifact.fetch(:bytes)}",
            "test \"$(sha256sum #{Shellwords.escape(artifact_path)} | cut -d' ' -f1)\" = #{Shellwords.escape(artifact.fetch(:digest))}"
          ]
        end
        artifact_exclusions = PHASE_ZERO_ARTIFACT_FILENAMES.values.map do |name|
          "! -name #{Shellwords.escape(name)}"
        end.join(" ")
        expected_entries = (observed.fetch(:owner_bytes) ? 1 : 0) +
          (observed.fetch(:history) ? 1 : 0) + observed.fetch(:stages).length +
          observed.fetch(:artifacts).length
        "test -d #{Shellwords.escape(path)}; test ! -L #{Shellwords.escape(path)}; " \
          "test -z \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 " \
          "! -name #{Shellwords.escape(OWNER_FILENAME)} " \
          "! -name #{Shellwords.escape("#{ReleaseJournal::HISTORY_PREFIX}*")} " \
          "! -name #{Shellwords.escape("#{JOURNAL_STAGE_PREFIX}*")} #{artifact_exclusions} -print -quit)\"; " \
          "test \"$(find #{Shellwords.escape(path)} -mindepth 1 -maxdepth 1 -print | wc -l)\" -eq #{expected_entries}; " \
          "#{owner_guard}; #{history_guard}; #{stage_checks.join('; ')}; #{artifact_checks.join('; ')}"
      end

      def move_pending_stage!(path, observed, invocation_id)
        rename = atomic_no_replace_rename_command(path, lock_directory)
        command = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; " \
          "#{live_owner_guard(invocation_id)}; #{pending_entry_guard(path, observed)}; " \
          "test ! -e #{Shellwords.escape(lock_directory)}; test ! -L #{Shellwords.escape(lock_directory)}; " \
          "#{rename}; " \
          "sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}"
        _, stderr, status = capture_remote command
        raise ReleaseStateError, "Could not recover authenticated phase-zero state: #{stderr}" unless status.success?
      end

      def remove_pending_stage!(path, observed, invocation_id)
        owner = File.join(path, OWNER_FILENAME)
        removals = []
        observed.fetch(:stages).each do |stage|
          removals << Shellwords.escape(File.join(path, stage.fetch(:name)))
        end
        observed.fetch(:artifacts).each do |artifact|
          removals << Shellwords.escape(File.join(path, artifact.fetch(:name)))
        end
        if history = observed.fetch(:history)
          removals << Shellwords.escape(File.join(path, history.fetch(:name)))
        end
        removals << Shellwords.escape(owner) if observed.fetch(:owner_bytes)
        command = "set -eu; #{state_lock_command}; #{state_lock_pin_guard}; " \
          "#{live_owner_guard(invocation_id)}; #{pending_entry_guard(path, observed)}; " \
          "#{"rm #{removals.join(' ')};" if removals.any?} " \
          "rmdir #{Shellwords.escape(path)}; sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}"
        _, stderr, status = capture_remote command
        raise ReleaseStateError, "Could not remove provably unpublished phase-zero staging: #{stderr}" unless status.success?
      end
  end

  def initialize(lock_id, lock_directory, key, invocation_lock: nil, anchors: nil, initial_state: nil)
    @lock_id, @lock_directory, @key = lock_id, lock_directory, key
    @invocation_lock = invocation_lock
    @anchors = anchors
    adopt_state initial_state if initial_state
  end

  def assert_held!
    @invocation_lock&.assert_held!
    owner = File.join(@lock_directory, OWNER_FILENAME)
    guard = self.class.live_owner_guard(@invocation_lock&.invocation_id)
    command = "set -eu; #{guard}; test -d #{Shellwords.escape(@lock_directory)}; " \
      "test ! -L #{Shellwords.escape(@lock_directory)}; test -f #{Shellwords.escape(owner)}; " \
      "test ! -L #{Shellwords.escape(owner)}; " \
      "test \"$(stat -c %h #{Shellwords.escape(owner)})\" -eq 1; cat #{Shellwords.escape(owner)}"
    stdout, stderr, status = Open3.capture3("ssh", self.class.remote, command)
    unless status.success? && stdout.strip == @lock_id
      raise ReleaseStateError, "Durable release lock ownership changed: #{stderr}"
    end
    true
  end

  def run_mutation!(*command, env: {})
    raise ReleaseStateError, "External release mutations require a live-owner process" unless @invocation_lock

    assert_held!
    @invocation_lock.run_mutation!(*command, env:)
  end

  def capture_mutation!(*command, stdin_data: nil)
    raise ReleaseStateError, "External release mutations require a live-owner process" unless @invocation_lock

    assert_held!
    @invocation_lock.capture_mutation!(*command, stdin_data:)
  end

  def read_journal
    state = self.class.read_state(
      @lock_directory, key: @key, invocation_id: @invocation_lock&.invocation_id
    )
    raise ReleaseStateError, "Release journal lock identity changed" unless state.fetch(:lock_id) == @lock_id
    adopt_state state
    state.fetch(:journal)
  end

  def write_journal(journal, fault_after: nil, stream: nil)
    assert_held!
    unless journal.fetch("lock_id") == @lock_id && journal.fetch("journal_revision") == @journal_revision
      raise ReleaseStateError, "Release journal lock identity or expected revision changed"
    end
    release = journal.fetch("release")
    unless release.is_a?(Hash) && release.keys.sort == %w[ repository sha tag version ]
      raise ReleaseStateError, "Release journal release identity must remain the exact four-field identity"
    end
    ReleaseJournal.validate_contract! journal, self.class.immutable_contract(@state.fetch(:journal))
    expected_revision = @journal_revision
    expected_digest = @history_digest
    expected_state = @state
    journal["journal_revision"] = expected_revision + 1
    publisher_id = @invocation_lock&.invocation_id || SecureRandom.hex(16)
    history = ReleaseJournal.build_history(
      journal, operation_id: @lock_id, prior_digest: expected_digest,
      publisher_id:, key: @key
    )
    stage_name = self.class.journal_stage_name(
      lock_id: @lock_id, invocation_id: publisher_id,
      revision: journal.fetch("journal_revision"), source: history.fetch(:source), key: @key
    )
    staging = File.join(@lock_directory, stage_name)
    canonical = File.join(@lock_directory, history.fetch(:name))
    guard = "#{self.class.state_lock_pin_guard}; " \
      "#{self.class.live_owner_guard(@invocation_lock&.invocation_id)}; " \
      "#{self.class.history_predecessor_guard(@lock_directory, expected_state)}"
    publisher = ReleaseAtomicPublisher.new(capture: ->(command, input) {
      if @invocation_lock
        @invocation_lock.capture_mutation!("ssh", self.class.remote, command, stdin_data: input)
      else
        Open3.capture3("ssh", self.class.remote, command, stdin_data: input)
      end
    })
    publisher.publish_history_file!(
      canonical:, staging:, source: history.fetch(:source),
      lock_guard: self.class.state_lock_command, publication_guard: guard,
      fault_after:, stream: stream || history.fetch(:source)
    )
    persisted = read_journal
    raise ReleaseStateError, "Persisted release journal differs from requested state" unless persisted == journal
    if @anchors
      @anchors.reconcile!(state: @state, release: persisted.fetch("release"))
      @invocation_lock&.assert_held!
    end
    true
  rescue StandardError
    begin
      state = self.class.read_state(
        @lock_directory, key: @key, invocation_id: @invocation_lock&.invocation_id
      )
      if state.fetch(:history_digest) == expected_digest
        journal["journal_revision"] = expected_revision
        adopt_state state
      elsif state.fetch(:journal) == journal
        adopt_state state
      else
        journal["journal_revision"] = expected_revision
        adopt_state state
      end
    rescue StandardError
      journal["journal_revision"] = expected_revision if defined?(expected_revision)
    end
    raise
  end

  def release(fault_after: ->(_step) { })
    return if @released

    current = read_journal
    ReleaseMutationFence.ensure_settled! current
    unless TERMINAL_STATUSES.include?(current.fetch("status"))
      raise ReleaseStateError, "Release lock cleanup requires a terminal authenticated journal"
    end
    current["phase"] = "cleanup_started"
    current["updated_at"] = Time.now.utc.iso8601
    write_journal current

    cleanup_directory = File.join(EXPORT_DEPLOY_LOCATION, "#{TOMBSTONE_PREFIX}#{@lock_id}")
    rename = atomic_no_replace_rename_command(@lock_directory, cleanup_directory)
    command = "set -eu; #{self.class.state_lock_command}; #{self.class.state_lock_pin_guard}; " \
      "#{self.class.live_owner_guard(@invocation_lock&.invocation_id)}; " \
      "#{self.class.history_set_guard(@lock_directory, @state, allow_staging: false)}; " \
      "test ! -e #{Shellwords.escape(cleanup_directory)}; test ! -L #{Shellwords.escape(cleanup_directory)}; " \
      "#{rename}; " \
      "sync -f #{Shellwords.escape(EXPORT_DEPLOY_LOCATION)}; " \
      "#{self.class.history_set_guard(cleanup_directory, @state, allow_staging: false)}"
    _, stderr, status = if @invocation_lock
      @invocation_lock.capture_mutation! "ssh", self.class.remote, command
    else
      Open3.capture3 "ssh", self.class.remote, command
    end
    unless status.success?
      warn "Durable release cleanup state remains and requires reconciliation: #{stderr}"
      return false
    end

    fault_after.call("lock_cleanup")
    @released = true
    true
  end

  private
    def adopt_state(state)
      return unless state

      @state = state
      @history_digest = state.fetch(:history_digest)
      @journal_revision = state.dig(:journal, "journal_revision")
    end
end

