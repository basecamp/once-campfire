existing_tag_sha = remote_tag_sha(RELEASE_REMOTE, TAG)
abort "Release aborted: existing #{TAG} does not point at HEAD." if existing_tag_sha && existing_tag_sha != GIT_SHA
if existing_tag_sha && !reconciling
  raise ReleaseStateError,
    "Release tag #{TAG} appeared during phase-zero setup and cannot be adopted by this invocation"
end
validate_release_main_position!(
  sha: GIT_SHA, reconciling:,
  **release_main_state(remote: RELEASE_REMOTE, sha: GIT_SHA, reconciling:)
)
