unless release_metadata.fetch("tagName") == TAG && release_metadata.fetch("name") == TAG &&
    release_metadata.fetch("body") == File.read(notes_file) && !release_metadata.fetch("isPrerelease")
  abort "Release aborted: GitHub release metadata does not match the staged release."
