unless existing_tag_sha
  release_lock.assert_held!
  unless local_tag_sha
    run! "git", "tag", "--sign", "--annotate", TAG, "--message", "Campfire #{TAG}", GIT_SHA
    verify_tag_signature! TAG, TAG_SIGNER_FINGERPRINT
  end
  run! "git", "push", RELEASE_REMOTE, "refs/tags/#{TAG}"
  abort "Release aborted: pushed tag does not point at HEAD." unless remote_tag_sha(RELEASE_REMOTE, TAG) == GIT_SHA
