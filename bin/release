  "state" => (release_metadata.fetch("isDraft") ? "draft" : "public")

workflow_run_id = journal.dig("phases", "workflow", "data", "run_id")
workflow_run_attempt = journal.dig("phases", "workflow", "data", "run_attempt")
operation_nonce = journal.dig("phases", "workflow", "data", "operation_nonce")
retained_workflow_identity = authenticated_retained_workflow_identity!(journal)
if retained_workflow_identity
  workflow_run_id = retained_workflow_identity.fetch("run_id")
  workflow_run_attempt = retained_workflow_identity.fetch("run_attempt")
  operation_nonce = retained_workflow_identity.fetch("operation_nonce")
end
reconcile_run_id = ENV["RELEASE_RECONCILE_RUN_ID"].to_s
reconcile_run_attempt = ENV["RELEASE_RECONCILE_RUN_ATTEMPT"].to_s
unless reconcile_run_id.empty? == reconcile_run_attempt.empty?
  abort "Release aborted: RELEASE_RECONCILE_RUN_ID and RELEASE_RECONCILE_RUN_ATTEMPT must be provided together."
end
unless reconcile_run_id.empty?
  supplied_run_id = Integer(reconcile_run_id, 10, exception: false)
  supplied_run_attempt = Integer(reconcile_run_attempt, 10, exception: false)
  unless supplied_run_id&.positive? && supplied_run_attempt&.positive?
    abort "Release aborted: workflow run ID and attempt must be positive integers."
  end
  if (workflow_run_id && workflow_run_id.to_s != supplied_run_id.to_s) ||
      (workflow_run_attempt && workflow_run_attempt.to_s != supplied_run_attempt.to_s)
    abort "Release aborted: supplied workflow run identity differs from the authenticated journal."
  end
  workflow_run_id ||= supplied_run_id
  workflow_run_attempt ||= supplied_run_attempt
end
if workflow_run_id
  abort "Release aborted: authenticated workflow run attempt is missing." unless workflow_run_attempt
  unless operation_nonce&.match?(/\A[0-9a-f]{64}\z/)
    abort "Release aborted: authenticated workflow operation nonce is missing."
  end
  unless retained_workflow_identity
    validated_workflow_run!(
      repository: REPOSITORY, run_id: workflow_run_id, sha: GIT_SHA,
      release_tag: TAG, operation_nonce:, attempt: workflow_run_attempt
    )
  end
  complete_release_phase! release_lock, journal, "workflow",
    "run_id" => workflow_run_id.to_s, "run_attempt" => workflow_run_attempt.to_s,
    "operation_nonce" => operation_nonce
else
  workflow_previously_started = release_phase_started?(journal, "workflow")
  if workflow_previously_started
    workflow_data = journal.dig("phases", "workflow", "data") || {}
    operation_nonce = workflow_data["operation_nonce"]
    unless operation_nonce&.match?(/\A[0-9a-f]{64}\z/)
      abort "Release aborted: started workflow phase has no authenticated operation nonce."
    end
    previous_workflows = workflow_data["excluded_run_ids"] || []
  else
    operation_nonce = SecureRandom.hex(32)
    previous_workflows = workflow_ids(
      REPOSITORY, "workflow_dispatch", GIT_SHA, "main", release_tag: TAG, operation_nonce:
    )
    start_release_phase! release_lock, journal, "workflow",
      "excluded_run_ids" => previous_workflows, "event" => "workflow_dispatch",
      "operation_nonce" => operation_nonce
  end
  candidates = workflow_ids(
    REPOSITORY, "workflow_dispatch", GIT_SHA, "main", release_tag: TAG, operation_nonce:
  ) - previous_workflows
  if workflow_dispatch_required!(
      reconciling:, candidates:, phase_previously_started: workflow_previously_started,
      release_public:
    )
    release_lock.assert_held!
    run! "gh", "workflow", "run", "publish-image.yml", "--repo", REPOSITORY, "--ref", "main",
      "--field", "release_tag=#{TAG}", "--field", "release_sha=#{GIT_SHA}",
      "--field", "operation_nonce=#{operation_nonce}"
  end
  workflow_run_id = wait_for_workflow! repository: REPOSITORY, event: "workflow_dispatch",
    sha: GIT_SHA, branch: "main", release_tag: TAG, operation_nonce:,
    excluded_ids: previous_workflows, allow_rerun: !reconciling
  workflow_run_attempt = validated_workflow_run!(
    repository: REPOSITORY, run_id: workflow_run_id, sha: GIT_SHA,
    release_tag: TAG, operation_nonce:
  ).fetch("attempt")
  complete_release_phase! release_lock, journal, "workflow",
    "run_id" => workflow_run_id.to_s, "run_attempt" => workflow_run_attempt.to_s,
    "operation_nonce" => operation_nonce
end
ghcr_tag = "#{GHCR_IMAGE}:#{TAG}"
ghcr_version = "#{GHCR_IMAGE}:#{VERSION}"
ghcr_exact_tags = [ ghcr_tag, ghcr_version ]
ghcr_staging = "#{GHCR_IMAGE}:staging-#{workflow_run_id}-#{workflow_run_attempt}"
ghcr_phase = start_release_phase! release_lock, journal, "ghcr_immutable",
  "run_id" => workflow_run_id.to_s, "run_attempt" => workflow_run_attempt.to_s,
  "operation_nonce" => operation_nonce,
  "staging_reference" => ghcr_staging, "exact_references" => ghcr_exact_tags
unless ghcr_phase.fetch("run_id") == workflow_run_id.to_s &&
    ghcr_phase.fetch("run_attempt") == workflow_run_attempt.to_s &&
    ghcr_phase.fetch("operation_nonce") == operation_nonce &&
    ghcr_phase.fetch("staging_reference") == ghcr_staging &&
    ghcr_phase.fetch("exact_references") == ghcr_exact_tags
  abort "Release aborted: authenticated GHCR evidence contract changed."
end
evidence_directory = "tmp/release-evidence-#{VERSION}"
if journal["workflow_evidence"]
  FileUtils.rm_rf evidence_directory
  FileUtils.mkdir_p evidence_directory
  journal_anchors.restore_evidence!(journal:, destination: evidence_directory)
elsif journal["workflow_evidence_pending"]
  FileUtils.rm_rf evidence_directory
  FileUtils.mkdir_p evidence_directory
  unless journal_anchors.restore_pending_evidence!(journal:, destination: evidence_directory)
    download_release_evidence!(
      repository: REPOSITORY, run_id: workflow_run_id, run_attempt: workflow_run_attempt,
      destination: evidence_directory, sha: GIT_SHA, tag: TAG, image: GHCR_IMAGE,
      operation_nonce:
    )
  end
else
  download_release_evidence!(
    repository: REPOSITORY, run_id: workflow_run_id, run_attempt: workflow_run_attempt,
    destination: evidence_directory, sha: GIT_SHA, tag: TAG, image: GHCR_IMAGE,
    operation_nonce:
  )
end
evidence = validate_release_evidence!(
  repository: REPOSITORY, run_id: workflow_run_id, run_attempt: workflow_run_attempt,
  destination: evidence_directory, sha: GIT_SHA, tag: TAG, image: GHCR_IMAGE,
  operation_nonce:
)
revalidate_release_source!(
  remote: RELEASE_REMOTE, sha: GIT_SHA, version: VERSION, tag: TAG,
  signer_fingerprint: TAG_SIGNER_FINGERPRINT, reconciling:
)
evidence_contract = workflow_evidence_contract(
  directory: evidence_directory, run_id: workflow_run_id, run_attempt: workflow_run_attempt,
  operation_nonce:
)
retain_and_promote_workflow_evidence!(
  lock: release_lock, journal:, anchors: journal_anchors, directory: evidence_directory,
  contract: evidence_contract,
  fault_after: ->(boundary) { fault_after_external_mutation! "workflow_evidence_#{boundary}" }
)
ghcr_digest = evidence.fetch("index_digest")
unless ghcr_digest.match?(/\Asha256:[0-9a-f]{64}\z/)
  abort "Release aborted: workflow index digest is invalid."
end
if (staging_digest = image_digest(ghcr_staging)) && staging_digest != ghcr_digest
  abort "Release aborted: workflow staging reference changed from its evidenced digest."
end
verify_platforms! "#{GHCR_IMAGE}@#{ghcr_digest}"
verify_manifest_children! "#{GHCR_IMAGE}@#{ghcr_digest}", evidence.fetch("children")
run! "cosign", "verify",
  "--certificate-identity", "https://github.com/#{REPOSITORY}/.github/workflows/publish-image.yml@refs/heads/main",
  "--certificate-oidc-issuer", "https://token.actions.githubusercontent.com",
  "#{GHCR_IMAGE}@#{ghcr_digest}"
evidence_sha256 = evidence_contract.dig("files", "release-evidence.json", "sha256")
if release_phase_completed?(journal, "ghcr_immutable") &&
    (ghcr_phase.fetch("digest") != ghcr_digest || ghcr_phase.fetch("evidence_sha256") != evidence_sha256)
  abort "Release aborted: completed GHCR phase differs from the original workflow evidence."
end
probe_conflict_digest = evidence.fetch("build_indexes").fetch("amd64")
prove_registry_tag_immutability!(
  lock: release_lock, journal:, registry: "ghcr.io", repository: GHCR_IMAGE,
  seed_digest: ghcr_digest, conflict_digest: probe_conflict_digest,
  seed_source: "#{GHCR_IMAGE}@#{ghcr_digest}",
  conflict_source: "#{GHCR_IMAGE}@#{probe_conflict_digest}",
  policy_references: ghcr_exact_tags,
  read: ->(reference) { image_digest(reference) },
  media_type: ->(reference) { image_media_type(reference) },
  fault_prefix: "ghcr_immutability_probe"
)
record_immutable_alias_evidence!(
  lock: release_lock, journal:, registry: "ghcr.io",
  references: ghcr_exact_tags, digest: ghcr_digest, source_evidence_sha256: evidence_sha256
)
ghcr_alias_steps = {
  ghcr_tag => "ghcr_tag_alias",
  ghcr_version => "ghcr_version_alias"
}
ghcr_fence = ReleaseMutationFence.new(lock: release_lock, journal:)
ghcr_convergence = ImmutableAliasConvergence.new(
  references: ghcr_exact_tags, staging_reference: "#{GHCR_IMAGE}@#{ghcr_digest}", target_digest: ghcr_digest,
  read: ->(reference) { image_digest(reference) },
  stage: ->(_reference, _digest) {
    raise ReleaseStateError, "Evidenced GHCR staging reference disappeared"
  },
  verify: ->(digest) {
    verify_platforms! "#{GHCR_IMAGE}@#{digest}"
    verify_manifest_children! "#{GHCR_IMAGE}@#{digest}", evidence.fetch("children")
  },
  sign: ->(_digest) { },
  publish: ->(reference, digest) {
    ghcr_fence.run!(
      kind: "immutable_alias", target: { "reference" => reference, "digest" => digest }
    ) do |runner|
      verify_immutable_alias_evidence!(
        journal:, registry: "ghcr.io", reference:, digest:
      )
      create_registry_alias_with_policy!(
        reference:, digest:, read: ->(candidate) { image_digest(candidate) }
      ) do
        mutate!(
          "docker", "buildx", "imagetools", "create", "--tag", reference,
          "#{GHCR_IMAGE}@#{digest}", runner:
        )
        fault_after_external_mutation! ghcr_alias_steps.fetch(reference)
      end
    end
  }
)
ghcr_digest = converge_evidence_bound_aliases!(
  ghcr_convergence,
  fault_after: ->(_boundary) { fault_after_external_mutation! "ghcr_evidence" }
)
complete_release_phase! release_lock, journal, "ghcr_immutable",
  "run_id" => workflow_run_id.to_s, "run_attempt" => workflow_run_attempt.to_s,
  "operation_nonce" => operation_nonce,
  "staging_reference" => ghcr_staging, "exact_references" => ghcr_exact_tags,
  "digest" => ghcr_digest, "evidence_sha256" => evidence_sha256

once_exact_tags = [ "#{ONCE_IMAGE}:#{VERSION}", "#{ONCE_IMAGE}:#{GIT_SHA}" ]
once_phase = journal.dig("phases", "secondary_immutable", "data") || {}
once_staging = once_phase["staging_reference"] || "#{ONCE_IMAGE}:staging-#{VERSION}-#{GIT_SHA}-#{SecureRandom.hex(16)}"
once_phase = start_release_phase! release_lock, journal, "secondary_immutable",
  "staging_reference" => once_staging, "exact_references" => once_exact_tags
unless once_phase.fetch("staging_reference") == once_staging &&
    once_phase.fetch("exact_references") == once_exact_tags
  abort "Release aborted: authenticated secondary-registry phase contract changed."
end
if release_phase_completed?(journal, "secondary_immutable") && once_phase.fetch("digest") != ghcr_digest
  abort "Release aborted: completed secondary-registry phase changed its authenticated digest."
end
secondary_fence = ReleaseMutationFence.new(lock: release_lock, journal:)
if (secondary_staging_digest = image_digest(once_staging)) && secondary_staging_digest != ghcr_digest
  raise ReleaseStateError, "Secondary staging reference changed outside this release"
end
unless secondary_staging_digest
  secondary_fence.run!(
    kind: "immutable_staging", target: { "reference" => once_staging, "digest" => ghcr_digest }
  ) do |runner|
    mutate!(
      "docker", "buildx", "imagetools", "create", "--tag", once_staging,
      "#{GHCR_IMAGE}@#{ghcr_digest}", runner:
    )
    fault_after_external_mutation! "secondary_staging"
    unless image_digest(once_staging) == ghcr_digest
      raise ReleaseStateError, "Secondary staging reference did not settle"
    end
  end
end
verify_platforms! "#{ONCE_IMAGE}@#{ghcr_digest}"
verify_manifest_children! "#{ONCE_IMAGE}@#{ghcr_digest}", evidence.fetch("children")
unless journal.dig("secondary_signature_evidence", "digest") == ghcr_digest
  secondary_fence.run!(
    kind: "immutable_signature", target: { "reference" => ONCE_IMAGE, "digest" => ghcr_digest }
  ) do |runner|
    mutate!("cosign", "sign", "--yes", "#{ONCE_IMAGE}@#{ghcr_digest}", runner:)
    fault_after_external_mutation! "secondary_signature"
  end
  run! "cosign", "verify", "--certificate-identity", COSIGN_IDENTITY,
    "--certificate-oidc-issuer", COSIGN_ISSUER, "#{ONCE_IMAGE}@#{ghcr_digest}"
  journal["secondary_signature_evidence"] = {
    "digest" => ghcr_digest, "verified_at" => Time.now.utc.iso8601
  }
  journal["updated_at"] = Time.now.utc.iso8601
  release_lock.write_journal journal
else
  run! "cosign", "verify", "--certificate-identity", COSIGN_IDENTITY,
    "--certificate-oidc-issuer", COSIGN_ISSUER, "#{ONCE_IMAGE}@#{ghcr_digest}"
end
prove_registry_tag_immutability!(
  lock: release_lock, journal:, registry: "registry.once.com", repository: ONCE_IMAGE,
  seed_digest: ghcr_digest, conflict_digest: probe_conflict_digest,
  seed_source: "#{ONCE_IMAGE}@#{ghcr_digest}",
  conflict_source: "#{GHCR_IMAGE}@#{probe_conflict_digest}",
  policy_references: once_exact_tags,
  read: ->(reference) { image_digest(reference) },
  media_type: ->(reference) { image_media_type(reference) },
  fault_prefix: "secondary_immutability_probe"
)
record_immutable_alias_evidence!(
  lock: release_lock, journal:, registry: "registry.once.com",
  references: once_exact_tags, digest: ghcr_digest, source_evidence_sha256: evidence_sha256
)
secondary_alias_steps = {
  once_exact_tags.fetch(0) => "secondary_version_alias",
  once_exact_tags.fetch(1) => "secondary_sha_alias"
}
once_digest = ImmutableAliasConvergence.new(
  references: once_exact_tags,
  staging_reference: once_staging,
  target_digest: ghcr_digest,
  read: ->(reference) { image_digest(reference) },
  stage: ->(reference, digest) {
    secondary_fence.run!(
      kind: "immutable_staging", target: { "reference" => reference, "digest" => digest }
    ) do |runner|
      mutate!(
        "docker", "buildx", "imagetools", "create", "--tag", reference,
        "#{GHCR_IMAGE}@#{digest}", runner:
      )
      fault_after_external_mutation! "secondary_staging"
      raise ReleaseStateError, "Secondary staging reference did not settle" unless image_digest(reference) == digest
    end
  },
  verify: ->(digest) {
    verify_platforms! "#{ONCE_IMAGE}@#{digest}"
    verify_manifest_children! "#{ONCE_IMAGE}@#{digest}", evidence.fetch("children")
  },
  sign: ->(_digest) { },
  publish: ->(reference, digest) {
    secondary_fence.run!(
      kind: "immutable_alias", target: { "reference" => reference, "digest" => digest }
    ) do |runner|
      verify_immutable_alias_evidence!(
        journal:, registry: "registry.once.com", reference:, digest:
      )
      create_registry_alias_with_policy!(
        reference:, digest:, read: ->(candidate) { image_digest(candidate) }
      ) do
        mutate!(
          "docker", "buildx", "imagetools", "create", "--tag", reference,
          "#{ONCE_IMAGE}@#{digest}", runner:
        )
        fault_after_external_mutation! secondary_alias_steps.fetch(reference)
      end
    end
  }
).converge!(allow_create: true)
verify_platforms! "#{ONCE_IMAGE}@#{once_digest}"
verify_manifest_children! "#{ONCE_IMAGE}@#{once_digest}", evidence.fetch("children")
run! "cosign", "verify", "--certificate-identity", COSIGN_IDENTITY,
  "--certificate-oidc-issuer", COSIGN_ISSUER, "#{ONCE_IMAGE}@#{once_digest}"
complete_release_phase! release_lock, journal, "secondary_immutable",
  "staging_reference" => once_staging, "exact_references" => once_exact_tags,
  "digest" => once_digest

release_lock.assert_held!
start_release_phase! release_lock, journal, "static_immutable",
  "files" => [ File.basename(versioned_export), File.basename(versioned_checksum) ]
upload_immutable versioned_export, File.basename(versioned_export), GIT_SHA
upload_immutable versioned_checksum, File.basename(versioned_checksum), GIT_SHA
complete_release_phase! release_lock, journal, "static_immutable",
  "export_sha256" => Digest::SHA256.file(versioned_export).hexdigest,
  "checksum_sha256" => Digest::SHA256.file(versioned_checksum).hexdigest
release_assets = [ versioned_export, versioned_checksum ]
start_release_phase! release_lock, journal, "github_assets", "tag" => TAG
live_release = observed_github_release!(journal:, repository: REPOSITORY, tag: TAG)
if !live_release.fetch("isDraft")
  verify_release_assets! REPOSITORY, TAG, release_assets, release: live_release
else
  upload_release_assets_immutably REPOSITORY, TAG, release_assets, journal:
end
complete_release_phase! release_lock, journal, "github_assets",
  "assets" => release_assets.to_h { [ File.basename(_1), Digest::SHA256.file(_1).hexdigest ] }

static_export = "tmp/campfire.zip"
static_checksum = "#{static_export}.sha256"
FileUtils.cp versioned_export, static_export
File.write static_checksum, "#{Digest::SHA256.file(static_export).hexdigest}  campfire.zip\n"
start_release_phase! release_lock, journal, "static_staging", "target" => "campfire-#{VERSION}"
static_target = stage_static_release! static_export, static_checksum, VERSION, GIT_SHA
complete_release_phase! release_lock, journal, "static_staging",
  "target" => static_target,
  "archive_sha256" => Digest::SHA256.file(static_export).hexdigest,
  "checksum_sha256" => Digest::SHA256.file(static_checksum).hexdigest

revalidate_release_source!(
  remote: RELEASE_REMOTE, sha: GIT_SHA, version: VERSION, tag: TAG,
  signer_fingerprint: TAG_SIGNER_FINGERPRINT, reconciling:
)
release_lock.assert_held!
major, minor, = VERSION.split(".")
once_exact_tags.each do |tag|
  abort "Release aborted: immutable secondary tag #{tag} changed." unless image_digest(tag) == once_digest
end

publication_preflight = lambda do |require_draft: false|
  release_lock.assert_held!
  revalidate_release_source!(
    remote: RELEASE_REMOTE, sha: GIT_SHA, version: VERSION, tag: TAG,
    signer_fingerprint: TAG_SIGNER_FINGERPRINT, reconciling:
  )
  unless image_digest(ghcr_tag) == ghcr_digest && image_digest(ghcr_version) == ghcr_digest
    abort "Release aborted: immutable GHCR release aliases changed."
  end
  once_exact_tags.each do |tag|
    abort "Release aborted: immutable secondary tag #{tag} changed." unless image_digest(tag) == once_digest
  end
  observed_release = observed_github_release!(journal:, repository: REPOSITORY, tag: TAG)
  verify_release_assets!(REPOSITORY, TAG, release_assets, release: observed_release)
  EXPORT_DEPLOY_HOSTS.each do |host|
    verify_static_release_files!(
      host, static_target,
      archive_digest: Digest::SHA256.file(static_export).hexdigest,
      checksum_digest: Digest::SHA256.file(static_checksum).hexdigest
    )
  end
  if require_draft
    validate_github_publication_boundary!(
      journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
    )
  else
    authenticated_github_release_state!(
      journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
    )
  end
end
publication_preflight.call

channel_contracts = {
  "ghcr_minor" => {
    "kind" => "registry", "reference" => "#{GHCR_IMAGE}:#{major}.#{minor}", "target" => ghcr_digest
  },
  "ghcr_major" => {
    "kind" => "registry", "reference" => "#{GHCR_IMAGE}:#{major}", "target" => ghcr_digest
  },
  "ghcr_latest" => {
    "kind" => "registry", "reference" => "#{GHCR_IMAGE}:latest", "target" => ghcr_digest
  },
  "once_latest" => {
    "kind" => "registry", "reference" => "#{ONCE_IMAGE}:latest", "target" => once_digest
  }
}
EXPORT_DEPLOY_HOSTS.each do |host|
  channel_contracts["static_#{host}"] = {
    "kind" => "static", "host" => host, "target" => static_target
  }
end
channel_contracts["github_public"] = {
  "kind" => "github_release", "repository" => REPOSITORY, "tag" => TAG, "target" => "public"
}
channel_contracts["github_latest"] = {
  "kind" => "github_latest", "repository" => REPOSITORY, "target" => TAG
}

journal_contract = release_promotion_contract(
  release: expected_release,
  anchor_set: journal_anchors.identity,
  workflow_run: {
    "run_id" => workflow_run_id.to_s,
    "run_attempt" => workflow_run_attempt.to_s,
    "operation_nonce" => operation_nonce
  },
  artifacts: {
    "workflow_evidence_sha256" => evidence_sha256,
    "notes_sha256" => Digest::SHA256.file(notes_file).hexdigest,
    "export_sha256" => Digest::SHA256.file(versioned_export).hexdigest,
    "checksum_sha256" => Digest::SHA256.file(versioned_checksum).hexdigest,
    "ghcr_digest" => ghcr_digest,
    "once_digest" => once_digest
  },
  channels: channel_contracts
)

journal = release_lock.read_journal
if journal["channels"]
  ReleaseJournal.validate_contract! journal, journal_contract
else
  current_channels = channel_contracts.to_h do |key, channel|
    current = case channel.fetch("kind")
    when "registry" then image_digest(channel.fetch("reference"))
    when "static"
      static_target_name = static_release_target(channel.fetch("host"))
      channel["previous_artifacts"] = static_release_file_digests(channel.fetch("host"), static_target_name)
      static_target_name
    when "github_release"
      authenticated_github_release_state!(
        journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
      )
    when "github_latest"
      latest = github_latest_tag(REPOSITORY)
      channel["previous_tag_sha"] = remote_tag_sha(RELEASE_REMOTE, latest) if latest
      latest
    end
    if channel.fetch("kind") == "registry" && current && !current.match?(/\Asha256:[0-9a-f]{64}\z/)
      abort "Release aborted: previous registry channel #{key} is not an immutable digest."
    end
    [ key, capture_moving_channel_previous!(
      journal:, channel: key, current:, target: channel.fetch("target")
    ) ]
  end

  if current_channels.fetch("github_public") == "public"
    changed = channel_contracts.filter_map do |key, channel|
      key if current_channels.fetch(key) != channel.fetch("target")
    end
    unless changed.empty?
      abort "Release aborted: public release channels changed without a surviving journal: #{changed.join(', ')}."
    end
  end

  journal = journal.merge(journal_contract).merge(
    "channels" => channel_contracts.to_h do |key, channel|
      [ key, channel.merge("previous" => current_channels.fetch(key)) ]
    end,
    "outcome" => "complete",
    "status" => "prepared",
    "completed_steps" => {},
    "created_at" => journal.fetch("created_at"),
    "updated_at" => Time.now.utc.iso8601
  )
  release_lock.write_journal journal
end
complete_release_phase! release_lock, journal, "promotion_prepared",
  "channel_keys" => journal.fetch("channels").keys.sort
end

channels = journal.fetch("channels").map do |key, channel|
  case channel.fetch("kind")
  when "registry"
    reference = channel.fetch("reference")
    ReleaseChannel.new(
      key:, previous: channel["previous"], target: channel.fetch("target"),
      read: -> { image_digest(reference) },
      write: ->(digest, runner) {
        mutate! "docker", "buildx", "imagetools", "create", "--tag", reference,
          "#{reference.split(':', 2).first}@#{digest}", runner:
      }
    )
  when "static"
    host = channel.fetch("host")
    target = channel.fetch("target")
    ReleaseChannel.new(
      key:, previous: channel.fetch("previous"), target:,
      read: -> {
        current = static_release_target(host)
        if current == target
          verify_static_release_files!(
            host, target,
            archive_digest: Digest::SHA256.file(static_export).hexdigest,
            checksum_digest: Digest::SHA256.file(static_checksum).hexdigest
          )
        elsif current == channel.fetch("previous")
          previous = channel.fetch("previous_artifacts")
          verify_static_release_files!(
            host, current,
            archive_digest: previous.fetch("archive_sha256"),
            checksum_digest: previous.fetch("checksum_sha256")
          )
        end
        current
      },
      write: ->(desired, runner) {
        desired_artifacts = if desired == target
          {
            "archive_sha256" => Digest::SHA256.file(static_export).hexdigest,
            "checksum_sha256" => Digest::SHA256.file(static_checksum).hexdigest
          }
        else
          channel.fetch("previous_artifacts")
        end
        if desired == channel.fetch("previous")
          verify_static_release_files!(
            host, desired,
            archive_digest: desired_artifacts.fetch("archive_sha256"),
            checksum_digest: desired_artifacts.fetch("checksum_sha256")
          )
        end
        expected = desired == target ? channel.fetch("previous") : target
        set_static_release_target!(
          host, desired, GIT_SHA, expected:,
          archive_digest: desired_artifacts.fetch("archive_sha256"),
          checksum_digest: desired_artifacts.fetch("checksum_sha256"), runner:
        )
      }
    )
  when "github_release"
    ReleaseChannel.new(
      key:, previous: channel.fetch("previous"), target: channel.fetch("target"),
      read: -> {
        authenticated_github_release_state!(
          journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
        )
      },
      write: ->(target, runner) {
        raise ReleaseStateError, "GitHub releases cannot be returned to draft after publication" unless target == "public"
        publication_preflight.call(require_draft: true)
        publish_github_release_without_latest!(
          repository: REPOSITORY, tag: TAG, runner:
        )
        unless authenticated_github_release_state!(
            journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
          ) == "public"
          raise ReleaseStateError, "GitHub publication mutation did not reach public state"
        end
      }
    )
  when "github_latest"
    ReleaseChannel.new(
      key:, previous: channel["previous"], target: channel.fetch("target"),
      read: -> {
        current = github_latest_tag(REPOSITORY)
        if current == channel["previous"] && current &&
            remote_tag_sha(RELEASE_REMOTE, current) != channel.fetch("previous_tag_sha")
          raise ReleaseStateError, "Previous GitHub latest tag changed after journal capture"
        end
        current
      },
      write: ->(target, runner) {
        raise ReleaseStateError, "Cannot clear the latest GitHub release marker automatically" unless target
        mutate! "gh", "release", "edit", target, "--repo", REPOSITORY, "--latest", runner:
      }
    )
  else
    raise ReleaseStateError, "Unknown release channel kind #{channel.fetch('kind')}"
  end
end

current_github_release_state = authenticated_github_release_state!(
  journal:, repository: REPOSITORY, tag: TAG, notes_file:, asset_paths: release_assets
)
requested_outcome = if reconciling
  reconcile_action
elsif current_github_release_state == "public"
  "complete"
else
  journal.fetch("outcome", "complete")
end
if current_github_release_state == "public" && requested_outcome != "complete"
  raise ReleaseStateError, "A public GitHub release cannot be rolled back"
end
promotion = MovingChannelPromotion.new(
  lock: release_lock, journal:, channels:,
  fault_after: ->(step) { fault_after_external_mutation!(step) }
)

begin
  start_release_phase! release_lock, journal, "promotion", "outcome" => requested_outcome
  promotion.converge! requested_outcome
  complete_release_phase! release_lock, journal, "promotion", "outcome" => requested_outcome
  complete_release_phase! release_lock, journal, "publication",
    "github_release" => (requested_outcome == "complete" ? "public" : "draft")
rescue ReleaseMutationError => error
  if requested_outcome == "complete" && promotion.rollback_possible?
    begin
      promotion.converge! "rollback"
      complete_release_phase! release_lock, journal, "promotion", "outcome" => "rollback"
      complete_release_phase! release_lock, journal, "publication", "github_release" => "draft"
    rescue StandardError => rollback_error
      abort "Release promotion failed (#{error.message}) and rollback is incomplete (#{rollback_error.message}). " \
        "The durable journal was retained for reconciliation."
    end
    unless release_lock.release(fault_after: ->(step) { fault_after_external_mutation!(step) })
      abort "Release promotion failed and channels were rolled back, but lock cleanup requires reconciliation."
    end
    abort "Release promotion failed and every moving channel was verified at its previous value: #{error.message}"
  end
  abort "Release promotion is incomplete; the durable journal was retained for all-new reconciliation: #{error.message}"
rescue ReleaseStateError => error
  abort "Release reconciliation stopped without claiming success: #{error.message}"
end

FileUtils.rm_f notes_file
FileUtils.rm_rf "tmp/release-evidence-#{VERSION}"
unless release_lock.release(fault_after: ->(step) { fault_after_external_mutation!(step) })
  abort "Release channels are consistent, but durable lock cleanup requires reconciliation."
end
if requested_outcome == "rollback"
  puts "Reconciled Campfire #{TAG}: all moving channels were restored and the GitHub release remains a draft."
else
  puts "Released Campfire #{TAG} from #{GIT_SHA}."
end
rescue ReleaseStateError => error
  abort "Release aborted: #{error.message}"
ensure
  active_error = $!
  begin
    invocation_lock&.release
  rescue ReleaseStateError => error
    if active_error
      warn "Release live-owner cleanup also failed: #{error.message}"
    else
      raise
    end
  end
end
end
